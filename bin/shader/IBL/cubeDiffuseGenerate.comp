#version 460 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in;

#ifndef PI_DEFINE
#define PI_DEFINE
const float PI = 3.14159265359;
#endif

// 漫反射辐照度 E(N) = ∫ L(ω) · max(N·ω, 0) dω（和原来一样存 E，使用时乘 albedo / π）。
//   做法：不再随机采样，而是把源 cube 缩小到每面 gridSize × gridSize 的那一级 mip（盒式滤波，太阳等亮点已经被摊开），
//   对这一级的每个像素精确求和：dω = (2 / g)² / |d|³（d 是主轴分量为 1 的未归一化方向），再按 Σdω = 4π 校正。
//   结果确定、没有噪点；辐照度本来就非常平滑，每面 16 个像素已经足够（误差远小于 8 位显示精度）。
//   源 cube 没有 mip 时 lod 被硬件截到 0，相当于在第 0 级上稀疏取点（亮点可能被漏掉），所以源 cube 应带完整 mip。

layout (binding = 0) uniform Params
{
    uint gridSize;      // 每面在每个方向上求和的像素数，4~64，默认 16
    uint reserved;
};
layout (binding = 1, rgba16f) uniform writeonly image2DArray outputDiffuseCube;
layout (binding = 2) uniform samplerCube skyCube;

// 输出 cube 的面方向：和 equirectToCube.comp、天空 cube 的生成保持一致（不要单独改）
vec3 GetCubeDirUnnormalized(vec2 uv, int face)
{
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.y = -ndc.y;
    switch (face)
    {
        case 0: return vec3(1, ndc.y, -ndc.x);     // +X
        case 1: return vec3(-1, ndc.y, ndc.x);     // -X
        case 2: return vec3(ndc.x, 1, -ndc.y);     // +Y
        case 3: return vec3(ndc.x, -1, ndc.y);     // -Y
        case 4: return vec3(ndc.x, ndc.y, 1);      // +Z
        case 5: return vec3(-ndc.x, ndc.y, -1);    // -Z
    }
    return vec3(ndc.x, ndc.y, 1);
}

void main()
{
    ivec3 arraySize = imageSize(outputDiffuseCube);
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    int face = int(gl_GlobalInvocationID.z);
    if (coord.x >= arraySize.x || coord.y >= arraySize.y || face >= 6 || face >= arraySize.z)
        return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(arraySize.xy);
    vec3 N = normalize(GetCubeDirUnnormalized(uv, face));

    int sourceSize = textureSize(skyCube, 0).x;
    int grid = clamp(int(gridSize), 4, 64);
    grid = min(grid, sourceSize);
    float lod = max(log2(float(sourceSize) / float(grid)), 0.0);
    float cellArea = (2.0 / float(grid)) * (2.0 / float(grid));

    vec3 irradiance = vec3(0.0);
    float totalSolidAngle = 0.0;
    for (int f = 0; f < 6; ++f)
    {
        for (int y = 0; y < grid; ++y)
        {
            for (int x = 0; x < grid; ++x)
            {
                vec3 d = GetCubeDirUnnormalized((vec2(x, y) + 0.5) / float(grid), f);
                float len2 = dot(d, d);
                float solidAngle = cellArea / (len2 * sqrt(len2));
                totalSolidAngle += solidAngle;

                vec3 dir = d * inversesqrt(len2);
                float cosTheta = dot(N, dir);
                if (cosTheta > 0.0)
                    irradiance += textureLod(skyCube, dir, lod).rgb * (cosTheta * solidAngle);
            }
        }
    }
    irradiance *= 4.0 * PI / max(totalSolidAngle, 1e-6);
    imageStore(outputDiffuseCube, ivec3(coord, face), vec4(irradiance, 1.0));
}

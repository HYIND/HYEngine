#version 460 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in; 

#include "shader/Helper/bdrfHelper.comp"

layout (binding = 0) uniform Params
{
    uint sampleCount;
    uint frameIndex;
};
layout (binding = 1, rgba16f) uniform writeonly image2D outputBRDFLUT;

#ifndef PI_DEFINE
#define PI_DEFINE
const float PI = 3.14159265359;
#endif

uint pcg_hash(uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float pcg_float(uint seed) {
    return float(pcg_hash(seed)) / 4294967296.0;
}

vec2 pcg_float2(uint seed) {
    uint h1 = pcg_hash(seed);
    uint h2 = pcg_hash(h1 + 0x9e3779b9u);
    return vec2(float(h1), float(h2)) / 4294967296.0;
}

vec2 getRandom(uint seed) 
{
    return pcg_float2(seed);
}

vec3 RotateNormal(vec3 normal, float cosTheta, float r2)
{
    float phi = 2.0 * PI * r2;
    
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

    vec3 dir = vec3(
        sinTheta * cos(phi),
        sinTheta * sin(phi),
        cosTheta
    );
    
    // 将局部坐标转到世界空间（以法线为Z轴）
    vec3 up = abs(normal.y) < 0.999 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);

    vec3 samplerDir = normalize(tangent * dir.x + bitangent * dir.y + normal * dir.z);

    return samplerDir;
}

// 生成GGX权重半球随机方向
vec3 ImportanceSampleGGX(float roughness, vec3 N, vec3 V, vec2 random, inout vec3 H)
{
    float r1 = random.x;
    float r2 = random.y;  

    // 生成局部坐标系的 H（假设 N 朝上）
    float a = roughness * roughness;
    float a2 = a * a;
    float phi = 2.0 * PI * r1;
    float cosTheta = sqrt((1.0 - r2) / (1.0 + (a2 - 1.0) * r2));
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

    // 本地空间的 H 向量 (z轴为N)
    vec3 H_local = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);

    // 构建 TBN 矩阵
    vec3 up = abs(N.y) < 0.999 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);
    
    // 将 H 转换到世界空间
    H = normalize(tangent * H_local.x + bitangent * H_local.y + N * H_local.z);

    vec3 L = reflect(-V, H);
    
    return L;
}

float CalculateFc(float VdotH)
{
    float x = 1.0 - VdotH;
	float x2 = x * x;
	float x5 = x2 * x2 * x;
    return x5;
}

vec2 SamplerBRDFLUT(vec3 N, vec3 V, float NdotV, float roughness, uint sampleId)
{
    uint seedbase = uint(gl_GlobalInvocationID.x) * 197u 
            + uint(gl_GlobalInvocationID.y) * 927u
            + uint(frameIndex) * 777u;

    uint seed = seedbase + uint(sampleId) * 269u;

    // GGX重要性采样
    vec2 random = getRandom(seed);

    vec3 H = vec3(0,1,0);
    vec3 L = ImportanceSampleGGX(roughness, N, V, random, H);

    if (dot(N, L) <= 0.0)
        return vec2 (0.f);

    float NdotL = max(dot(N, L), 0.0);
    float VdotH = max(dot(V, H), 0.0);
    float NdotH = max(dot(N, H), 0.0);

    float G = GeometrySmith(NdotL, NdotV, roughness);
    float GVis = (G * VdotH) / (NdotV * NdotH + 1e-4);

    float Fc = CalculateFc(VdotH);

    float A = GVis * (1.0 - Fc);
    float B = GVis * Fc;

    return vec2(A, B);
}

vec2 CalculateBRDFLUT(float NdotV, float roughness, uint sampleCount) 
{
    vec2 totalValues = vec2(0.0);

    vec3 N = vec3(0.0, 1.0, 0.0);
    vec3 V = normalize(vec3(sqrt(1.0 - NdotV * NdotV), NdotV, 0.0));

    for (uint i = 0; i < sampleCount; i++) 
        totalValues += SamplerBRDFLUT(N, V, NdotV, roughness, i);

    return sampleCount > 0 ?  totalValues / float(sampleCount) : vec2(0.f);
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outputBRDFLUT);

    if (coord.x >= imageSize.x || coord.y >= imageSize.y)
        return;

    vec2 TexCoords = (vec2(coord) + vec2(0.5)) / vec2(imageSize);

    float NdotV = TexCoords.x * 1.0;
    float roughness = TexCoords.y * 1.0;

    vec2 value = CalculateBRDFLUT(NdotV, roughness, sampleCount);
    imageStore(outputBRDFLUT, coord, vec4(value.x, value.y, 1.0, 1.0)); 
}
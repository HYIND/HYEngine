#version 460 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in;

#ifndef PI_DEFINE
#define PI_DEFINE
const float PI = 3.14159265359;
#endif

// BRDF LUT（split-sum 的第二项）：x = NdotV，y = roughness，存 (A, B)，镜面 = 预过滤 × (F0 · A + B)。
//   - Hammersley 固定采样点（原来是随机数，带 frameIndex，结果不确定）；
//   - 几何项用 IBL 的 k = α / 2 = roughness² / 2（Karis 2013）。直接光的 k = (roughness + 1)² / 8 是为解析光源调过的，
//     用在 IBL 上粗糙时偏暗。

layout (binding = 0) uniform Params
{
    uint sampleCount;
    uint reserved;
};
layout (binding = 1, rgba16f) uniform writeonly image2D outputBRDFLUT;

// Hammersley 低差异序列：所有像素用同一组固定的采样点，结果确定、没有随机噪点，也不随帧变化
vec2 Hammersley(uint i, uint n)
{
    return vec2(float(i) / float(n), float(bitfieldReverse(i)) * 2.3283064365386963e-10);
}

// GGX 半程向量采样（N 为 z 轴），α = roughness²，和 bdrfHelper.comp 的 DistributionGGX 一致
vec3 ImportanceSampleGGX(vec2 xi, vec3 N, float roughness)
{
    float a = roughness * roughness;
    float a2 = a * a;
    float phi = 2.0 * PI * xi.x;
    float cosTheta = sqrt((1.0 - xi.y) / (1.0 + (a2 - 1.0) * xi.y));
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    vec3 hLocal = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);

    vec3 up = abs(N.y) < 0.999 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);
    return normalize(tangent * hLocal.x + bitangent * hLocal.y + N * hLocal.z);
}

float GeometrySchlickGGX_IBL(float NdotX, float roughness)
{
    float k = roughness * roughness * 0.5;
    return NdotX / (NdotX * (1.0 - k) + k);
}

float GeometrySmith_IBL(float NdotL, float NdotV, float roughness)
{
    return GeometrySchlickGGX_IBL(NdotV, roughness) * GeometrySchlickGGX_IBL(NdotL, roughness);
}

vec2 IntegrateBRDF(float NdotV, float roughness, uint count)
{
    vec3 N = vec3(0.0, 1.0, 0.0);
    vec3 V = vec3(sqrt(max(1.0 - NdotV * NdotV, 0.0)), NdotV, 0.0);

    float A = 0.0;
    float B = 0.0;
    for (uint i = 0u; i < count; ++i)
    {
        vec3 H = ImportanceSampleGGX(Hammersley(i, count), N, roughness);
        float VdotH = dot(V, H);
        vec3 L = 2.0 * VdotH * H - V;

        float NdotL = L.y;
        float NdotH = max(H.y, 0.0);
        VdotH = max(VdotH, 0.0);
        if (NdotL <= 0.0)
            continue;

        float G = GeometrySmith_IBL(NdotL, NdotV, roughness);
        float GVis = G * VdotH / max(NdotH * NdotV, 1e-4);
        float x = 1.0 - VdotH;
        float Fc = x * x * x * x * x;
        A += (1.0 - Fc) * GVis;
        B += Fc * GVis;
    }
    return vec2(A, B) / float(count);
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputBRDFLUT);
    if (coord.x >= size.x || coord.y >= size.y)
        return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    float NdotV = max(uv.x, 1e-3);
    float roughness = uv.y;

    vec2 value = IntegrateBRDF(NdotV, roughness, clamp(sampleCount, 16u, 4096u));
    imageStore(outputBRDFLUT, coord, vec4(value, 1.0, 1.0));
}

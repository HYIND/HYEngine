#version 430 core

#ifndef work_size_x
#define work_size_x 16
#endif

#ifndef work_size_y
#define work_size_y 1
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y) in;

struct AABB
{
    vec3 minPos;
    vec3 maxPos;
};

layout(std430, binding = 0) buffer MeshAABB{
    AABB aabbdata[];
};
layout(std430, binding = 1) buffer OcclusionResults {
    int visibility[];  // 1 = 被遮挡, 0 = 可见
};

uniform int count = 0;

uniform sampler2D hzbDepthMap;
uniform ivec2 depthMapSize;
uniform int maxLevel;

uniform mat4 viewProj;

#include "shader/dataDef/camerauboDef.comp"
float DepthBufferConvertToViewDepth(float depth)
{
    float z_ndc = depth * 2.0 - 1.0;
    return (2.0 * camera.nearPlane * camera.farPlane) / (camera.farPlane + camera.nearPlane - z_ndc * (camera.farPlane - camera.nearPlane));
}


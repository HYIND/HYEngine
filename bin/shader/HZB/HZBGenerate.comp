#version 450 core

#ifndef work_size_x
#define work_size_x 16
#endif

#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y) in;

layout(binding = 0, r32f) uniform image2D mipMapMaxAndMinDepthMap[32];

layout(push_constant) uniform PushConsts {
    uint inputLevel;
    uint outputLevel;
};

void main() 
{
    uint inputIndex = 2 * inputLevel;
    uint outputIndex = 2 * outputLevel;
    ivec2 inputSize = imageSize(mipMapMaxAndMinDepthMap[inputIndex]);
    ivec2 outPutSize = imageSize(mipMapMaxAndMinDepthMap[outputIndex]);
    
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= outPutSize.x || pixelCoord.y >= outPutSize.y) {
        return;
    }

    ivec2 inCoord = pixelCoord * 2;  // 对应上一层的位置
    
    // 取2x2区域的最大值
    int samplerCountX = ((pixelCoord.x == outPutSize.x - 1) && (inputSize.x % 2 != 0)) ? 3 : 2;
    int samplerCountY = ((pixelCoord.y == outPutSize.y - 1) && (inputSize.y % 2 != 0)) ? 3 : 2;

    float maxDepth = 0.0;
    float minDepth = 1.0;
    for (int y = 0; y < samplerCountY; y++) {
        for (int x = 0; x < samplerCountX; x++) {
            ivec2 sampleCoord = inCoord + ivec2(x, y);
            float maxSample = imageLoad(mipMapMaxAndMinDepthMap[inputIndex], sampleCoord).r;
            float minSample = imageLoad(mipMapMaxAndMinDepthMap[inputIndex + 1], sampleCoord).r;
            maxDepth = max(maxDepth, maxSample);
            minDepth = min(minDepth, minSample);
        }
    }
    imageStore(mipMapMaxAndMinDepthMap[outputIndex], pixelCoord, vec4(maxDepth));
    imageStore(mipMapMaxAndMinDepthMap[outputIndex + 1], pixelCoord, vec4(minDepth));
}

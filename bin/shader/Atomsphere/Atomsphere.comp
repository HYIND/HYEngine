#version 460 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in; 

#include "shader/dataDef/camerauboDef.comp"

layout (binding = 0) uniform Params
{
    vec3 DirLightColor;
    vec3 DirLightDir;
    float PlanetRadius;
    float AtmosphereHeight;
    float RayleighScatteringScalarHeight;
    float MieScatteringScalarHeight;
    float MieAnisotropy;
    float OzoneLevelCenterHeight;
    float OzoneLevelWidth;

    uint ScatterPathSampleCount;
    uint TransmittanceSampleCount;
};

layout (binding = 1, rgba16f) uniform image2D outputImage;
layout (binding = 2) uniform sampler2D colorMap;
layout (binding = 3) uniform sampler2D depthMap;

const float MAX_RAY_DISTANCE = 1e5;

vec3 RayleighCoefficient(float h)
{
    const vec3 sigma = vec3(5.802, 13.558, 33.1) * 1e-6;
    float H_R = RayleighScatteringScalarHeight;
    float rho_h = exp(-(h / H_R));
    return sigma * rho_h;
}

float RayleighPhase(float cos_theta)
{
    return (3.0 / (16.0 * 3.14159265)) * (1.0 + cos_theta * cos_theta);
}

vec3 MieCoefficient(float h)
{
    const vec3 sigma = vec3(3.996e-6);
    float H_M = MieScatteringScalarHeight;
    float rho_h = exp(-(h / H_M));
    return sigma * rho_h;
}

float MiePhase(float cos_theta)
{
    float g = MieAnisotropy;

    float a = 3.0 / (8.0 * 3.14159265);
    float b = (1.0 - g * g) / (2.0 + g * g);
    float c = 1.0 + cos_theta * cos_theta;
    float d = pow(1.0 + g * g - 2.0 * g * cos_theta, 1.5);

    return a * b * (c / d);
}
vec3 Scattering(vec3 p, vec3 toLightDir, vec3 viewDir)
{
    float cos_theta = dot(toLightDir, viewDir);

    p.y -= 1500;
    float h = length(p) - PlanetRadius;
    h = max(0.5, h);

    vec3 rayleigh = RayleighCoefficient(h) * RayleighPhase(cos_theta);
    vec3 mie = MieCoefficient(h) * MiePhase(cos_theta);

    return rayleigh + mie;
}
vec3 MieAbsorption(float h)
{
    const vec3 sigma = vec3(4.4e-6);
    float H_M = MieScatteringScalarHeight;
    float rho_h = exp(-(h / H_M));
    return sigma * rho_h;
}

vec3 OzoneAbsorption(float h)
{
    const vec3 sigma_lambda = vec3(0.650, 1.881, 0.085) * 1e-6;
    float center = OzoneLevelCenterHeight;
    float width = OzoneLevelWidth;
    float rho = max(0.0, 1.0 - abs(h - center) / width);
    return sigma_lambda * rho;
}
vec3 Transmittance(vec3 p1, vec3 p2)
{
    vec3 dir = normalize(p2 - p1);
    float dist = distance(p2, p1);
    float ds = dist / float(TransmittanceSampleCount);
    vec3 sum = vec3(0.0);
    vec3 p = p1 + dir * ds * 0.5;
    p.y -= 1500;

    for(int i = 0; i < TransmittanceSampleCount; i++)
    {
        float h = length(p) - PlanetRadius;
        h = max(0.5, h);

        vec3 scattering = RayleighCoefficient(h) + MieCoefficient(h);
        vec3 absorption = OzoneAbsorption(h) + MieAbsorption(h);
        vec3 extinction = scattering + absorption;

        sum += extinction * ds;
        p += dir * ds;
    }

    // 计算透光率
    return exp(-sum);
}

bool RaySphereIntersection(
    vec3 center,
    float radius,
    vec3 rayStart,
    vec3 rayDir,
    out float tNear,
    out float tFar)
{
    vec3 oc = rayStart - center;

    float b = dot(oc, rayDir);
    float c = dot(oc, oc) - radius * radius;

    float discriminant = b * b - c;

    if (discriminant < 0.0)
    {
        tNear = -1.0;
        tFar  = -1.0;
        return false;
    }

    float sqrtD = sqrt(discriminant);

    tNear = -b - sqrtD;
    tFar  = -b + sqrtD;

    return true;
}

bool GetAtmosphereRaySegment(
    vec3 rayStart,
    vec3 rayDir,
    out float tStart,
    out float tEnd
    )
{
    const vec3 planetCenter = vec3(0.0);

    float atmosphereRadius = PlanetRadius + AtmosphereHeight + 1500 - 1.0;

    // ------------------------------------------------------------
    // 1. Ray vs atmosphere
    // ------------------------------------------------------------

    float atmosphereNear;
    float atmosphereFar;

    if (!RaySphereIntersection(
            planetCenter,
            atmosphereRadius,
            rayStart,
            rayDir,
            atmosphereNear,
            atmosphereFar))
    {
        return false;
    }

    // Ray 从相机开始，所以不能积分 t < 0
    tStart = max(atmosphereNear, 0.0);
    tEnd = atmosphereFar;

    if (tEnd <= tStart)
        return false;


    // ------------------------------------------------------------
    // 2. Ray vs planet
    // ------------------------------------------------------------

    float planetNear;
    float planetFar;

    bool hitPlanet = RaySphereIntersection(
        planetCenter,
        PlanetRadius,
        rayStart,
        rayDir,
        planetNear,
        planetFar
    );


    // ------------------------------------------------------------
    // 3. 相机在地球内部
    // ------------------------------------------------------------

    float cameraRadius = length(rayStart);

    if (cameraRadius < PlanetRadius)
    {
        // 相机在地球内部。
        //
        // planetNear < 0
        // planetFar  > 0
        //
        // 必须穿过地表以后才能进入大气。

        if (!hitPlanet)
            return false;

        tStart = max(tStart, planetFar);
    }
    else
    {
        // --------------------------------------------------------
        // 4. 相机在地表以上
        // --------------------------------------------------------

        if (hitPlanet && planetNear > 0.0)
        {
            // 视线击中地球。
            // 大气积分只能到地表。
            tEnd = min(tEnd, planetNear);
        }
    }

    return tEnd > tStart;
}

vec3 singleScatterSkyColor(vec3 startPosInPlanet, vec3 targetPosInPlanet, vec3 lightColor, vec3 lightDir)
{

    vec3 viewDir = normalize(targetPosInPlanet - startPosInPlanet);
    vec3 toLightDir = -lightDir;
    float dstToTarget = distance(startPosInPlanet, targetPosInPlanet);
    float stepSize = dstToTarget / float(ScatterPathSampleCount);
    vec3 testPoint = startPosInPlanet + viewDir * stepSize * 0.5;
    vec3 color = vec3(0.f);

    for (uint i = 0; i < ScatterPathSampleCount; i++) {

        float planetNear, planetFar;
        bool hitPlanet = RaySphereIntersection(
            vec3(0,0,0),
            PlanetRadius,
            testPoint,
            toLightDir,
            planetNear,
            planetFar
        );
        if (hitPlanet && (planetNear > 0 || planetFar > 0))
        {
            testPoint += viewDir * stepSize;
            continue;
        }

        float tStart, tEnd;
        bool validSegment = GetAtmosphereRaySegment(
            testPoint,
            toLightDir,
            tStart,
            tEnd
        );
        if (!validSegment)
        {
            testPoint += viewDir * stepSize;
            continue;
        }

        vec3 atmosphereStart = testPoint + toLightDir * tStart;
        vec3 atmosphereEnd = testPoint + toLightDir * tEnd;

        vec3 tramsmittanceLightToTest = Transmittance(atmosphereEnd, atmosphereStart);                              // 太阳到采样点之间的透光率
        vec3 scattering = Scattering(atmosphereStart, toLightDir, viewDir);                                         // 散射光比例
        vec3 tramsmittanceTestToCam = Transmittance(atmosphereStart, startPosInPlanet);                             // 摄像机到采样点之间的透光度
        vec3 inScattering = tramsmittanceLightToTest * scattering * tramsmittanceTestToCam * stepSize * lightColor; // 采样点的光照计算
        color += inScattering;

        testPoint += viewDir * stepSize;
    }

    return color;
}

vec3 ReconstructWorldPosition(float depth, vec2 texCoords)
{
    vec4 ndcPos = vec4(texCoords * 2.0 - 1.0, depth, 1.0);
    
    vec4 viewPos = camera.invProjection * ndcPos;
    viewPos /= viewPos.w; // 透视除法
    
    // 逆视图变换到世界空间
    vec4 worldPos = camera.invView * viewPos;
    return worldPos.xyz;
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outputImage);

    if (coord.x >= imageSize.x || coord.y >= imageSize.y)
        return;

    vec2 TexCoords = (vec2(coord) + vec2(0.5)) / vec2(imageSize);


    float samplerDepth = texture(depthMap, TexCoords).r;

    vec3 sunLightColor = DirLightColor;
    vec3 sunLightDir = normalize(DirLightDir);

    vec3 result = vec3 (0.f);

    if (sunLightDir.y < 0.3 || samplerDepth < 0.99994)
    {

        vec3 worldPos = ReconstructWorldPosition(samplerDepth, TexCoords);

        vec3 cameraPosInPlanet = camera.position + vec3(0, PlanetRadius + 1500, 0.f);

        vec3 startPosInPlanet;
        vec3 targetPosInPlanet;

        bool shouldCalculateSkyLight = true;

        if (samplerDepth >= 0.99994)
        {
            float tStart;
            float tEnd;

            vec3 viewDir = normalize(worldPos - camera.position);
            bool validSegment = GetAtmosphereRaySegment(
                cameraPosInPlanet,
                viewDir,
                tStart,
                tEnd
            );

            if (validSegment)
            {
                // tEnd = min(MAX_RAY_DISTANCE, tEnd);

                vec3 atmosphereStart = cameraPosInPlanet + viewDir * tStart;
                vec3 atmosphereEnd = cameraPosInPlanet + viewDir * tEnd;

                startPosInPlanet = atmosphereStart;
                targetPosInPlanet = atmosphereEnd;

                // 大气积分距离
                // float maxDistance = tEnd - tStart;
                // maxDistance = min(maxDistance, MAX_RAY_DISTANCE);
                // targetPosInPlanet = startPosInPlanet + viewDir * maxDistance;
            }
            else
            {
                shouldCalculateSkyLight = false;
            }

        }
        else 
        {
            startPosInPlanet = cameraPosInPlanet;
            targetPosInPlanet = worldPos + vec3(0, PlanetRadius + 1500, 0.f);
        }

        if (shouldCalculateSkyLight && sunLightDir.y < 0.3)
            result += singleScatterSkyColor(startPosInPlanet, targetPosInPlanet, sunLightColor, sunLightDir);

        if (samplerDepth >= 0.99994)
        {
            vec3 viewDir = normalize(worldPos - camera.position);
            vec3 toLightDir = -sunLightDir;
            float cosAngle = dot(viewDir, toLightDir);
            if(cosAngle > 0.9998) {// 视线指向太阳圆盘
                
                float planetNear, planetFar;
                bool hitPlanet = RaySphereIntersection(
                    vec3(0,0,0),
                    PlanetRadius,
                    cameraPosInPlanet,
                    viewDir,
                    planetNear,
                    planetFar
                );
                if (!hitPlanet || (planetNear < 0 && planetFar < 0))
                {
                    float tStart, tEnd;
                    bool validSegment = GetAtmosphereRaySegment(
                        cameraPosInPlanet,
                        toLightDir,
                        tStart,
                        tEnd
                    );
                    if (validSegment)
                    {
                        vec3 atmosphereStart = cameraPosInPlanet + toLightDir * tStart;
                        vec3 atmosphereEnd = cameraPosInPlanet + toLightDir * tEnd;
                        result += Transmittance(atmosphereEnd, atmosphereStart) * sunLightColor;
                    }
                    else 
                    {
                        result += sunLightColor;
                    }
                }
            }
        }
        else
        {    
            vec3 fragTransmittance = Transmittance(targetPosInPlanet, startPosInPlanet);
            vec3 fragColor = texture(colorMap, TexCoords).rgb;
            result += fragColor * fragTransmittance;
        }

    }
    
    imageStore(outputImage, coord, vec4(result, 1.0));
}
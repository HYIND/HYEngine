#version 460 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in; 

#include "shader/Atomsphere/AtomPublic.comp"

layout (binding = 1, rgba32f) uniform image2D outputImage;

const float MAX_DISTANCE = 2e5;

vec4 Transmittance(float height, float cos_theta)
{
    cos_theta = clamp(cos_theta, -1.0, 1.0);

    vec3 p0 = vec3(0, PlanetRadius + height, 0);
    vec3 dir = vec3(sqrt(1.0 - cos_theta * cos_theta), cos_theta, 0);
    dir = normalize(dir);

    float tStart, tEnd;
    if (!GetAtmosphereRaySegment(p0, dir, tStart, tEnd))
        return vec4(1.0);   // 不在大气里，透射率 1
    
    float dist = tEnd - tStart;
    if (dist <= 0.0)
        return vec4(1.0);

    bool toSky = true;      //积分到天顶，还是地面
    if (cos_theta < 0)
    {
        float planetNear, planetFar;
        bool hitPlanet = RaySphereIntersection(
            vec3(0.0),
            PlanetRadius,
            p0,
            dir,
            planetNear,
            planetFar
        );
        toSky = !hitPlanet;
    }
    else 
    {
        toSky = true;
    }

    // tEnd = min(MAX_DISTANCE, tEnd);

    vec3 p1 = p0 + dir * tStart;
    vec3 p2 = p0 + dir * tEnd;

    vec3 sum = vec3(0.0);

    for(uint i = 0; i < TransmittanceSampleCount; i++)
    {
        vec3 p = mix(p1, p2, float(i + 0.5) / TransmittanceSampleCount);

        float hSample = length(p) - PlanetRadius;
        hSample = max(0.0, hSample);

        vec3 scattering = RayleighCoefficient(hSample) + MieCoefficient(hSample);
        vec3 absorption = OzoneAbsorption(hSample) + MieAbsorption(hSample);
        vec3 extinction = scattering + absorption;

        sum += extinction;
    }

    float ds = dist / float(TransmittanceSampleCount);
    vec3 T = exp(-sum * ds);
    T = max(T, vec3(1e-6));

    return vec4(T, toSky? 1.0: -1.0);
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outputImage);

    if (coord.x >= imageSize.x || coord.y >= imageSize.y)
        return;

    vec2 uv = (vec2(coord) + vec2(0.5)) / vec2(imageSize);

    // float height = mix(0.0, AtmosphereHeight, uv.x * uv.x);
    float height = mix(0.0, AtmosphereHeight, uv.x);

    // float x = uv.y * 2.0 - 1.0;
    // float cos_theta = sign(x) * sqrt(abs(x));

    float theta = uv.y * PI;                 // [0, π]
    float cos_theta = cos(theta);

    // float cos_theta = mix(-1.0, 1.0, uv.y);

    vec4 value = Transmittance(height, cos_theta);

    imageStore(outputImage, coord, value);
}
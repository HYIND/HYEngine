#ifndef DDGI_CORE_COMP
#define DDGI_CORE_COMP

// DDGI 公共函数：八面体编码、图集寻址、边框映射、光线方向。不依赖 UBO。
// 布局宏由 C++ 注入（DDGIDef.h 的 DDGIAddLayoutDefines）。

#if !defined(DDGI_RAY_GRID) || !defined(DDGI_IRR_INNER) || !defined(DDGI_DEPTH_INNER) || !defined(DDGI_PROBES_PER_ROW)
#error "DDGI 布局宏缺失：创建管线时需调用 DDGIAddLayoutDefines"
#endif

#define DDGI_RAY_COUNT  (DDGI_RAY_GRID * DDGI_RAY_GRID)
#define DDGI_IRR_TILE   (DDGI_IRR_INNER + 2)
#define DDGI_DEPTH_TILE (DDGI_DEPTH_INNER + 2)

const float DDGI_TWO_PI = 6.28318530718;

// ───────────── 八面体编码 ─────────────

// 方向 -> [0,1]² 八面体 UV
vec2 ddgiOctEncode(vec3 n)
{
    n /= (abs(n.x) + abs(n.y) + abs(n.z));
    vec2 uv = n.xy;
    if (n.z < 0.0)
        uv = (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0,
                                      n.y >= 0.0 ? 1.0 : -1.0);
    return uv * 0.5 + 0.5;
}

// [0,1]² 八面体 UV -> 方向
vec3 ddgiOctDecode(vec2 uv)
{
    uv = uv * 2.0 - 1.0;
    vec3 n = vec3(uv, 1.0 - abs(uv.x) - abs(uv.y));
    float t = max(-n.z, 0.0);
    n.x += n.x >= 0.0 ? -t : t;
    n.y += n.y >= 0.0 ? -t : t;
    return normalize(n);
}

// ───────────── 图集寻址 ─────────────

ivec2 ddgiTileOrigin(uint probeIndex, uint tileSize)
{
    return ivec2((probeIndex % uint(DDGI_PROBES_PER_ROW)) * tileSize,
                 (probeIndex / uint(DDGI_PROBES_PER_ROW)) * tileSize);
}

// 线性下标 -> 三维槽位坐标
uvec3 ddgiProbeCoord(uint probeIndex, uvec3 counts)
{
    uint k = probeIndex / (counts.x * counts.y);
    uint j = (probeIndex % (counts.x * counts.y)) / counts.x;
    uint i = probeIndex % counts.x;
    return uvec3(i, j, k);
}

// 方向在 tile 内的采样 UV。内层 texel i 对应方向 (i + 0.5) / inner，
// 所以 oct = 0 落在边框与第 0 个内层 texel 的分界上，配合精确边框做到无缝。
// 图集不是正方形，x / y 必须分别按真实尺寸归一化。
vec2 ddgiProbeSampleUV(ivec2 tileOrigin, vec3 dir, uint innerSize, vec2 atlasSize)
{
    vec2 pixel = vec2(tileOrigin) + 1.0 + ddgiOctEncode(dir) * float(innerSize);
    return pixel / atlasSize;
}

// ───────────── 边框 ─────────────
// 八面体展开的四条边是折叠线：(0, v) 与 (0, 1-v) 是同一方向，(u, 0) 与 (1-u, 0) 同理，四角都是 -z。
// 在上面的 texel 中心约定下，边框 texel 恰好与某个内层 texel 重合，整 texel 拷贝即可：
//   上 / 下边框 (x, 0 | N+1) <- 内层 (N-1-(x-1), 0 | N-1)
//   左 / 右边框 (0 | N+1, y) <- 内层 (0 | N-1, N-1-(y-1))
//   四个角                    <- 对角的内层角

// p：tile 内坐标（0..N+1，含边框），返回内层下标（0..N-1）
ivec2 ddgiBorderSourceTexel(ivec2 p, int innerSize)
{
    ivec2 src = p - ivec2(1);
    int last = innerSize - 1;
    if (p.y == 0 || p.y == innerSize + 1)
    {
        src.x = last - src.x;
        src.y = clamp(src.y, 0, last);
    }
    if (p.x == 0 || p.x == innerSize + 1)
    {
        src.y = last - src.y;
        src.x = clamp(src.x, 0, last);
    }
    return clamp(src, ivec2(0), ivec2(last));
}

// 第 b 个边框 texel 的 tile 内坐标（共 4T-4 个，依次为上行、下行、左列、右列）
ivec2 ddgiBorderTexelCoord(int b, int tileSize)
{
    int inner = tileSize - 2;
    if (b < tileSize)   return ivec2(b, 0);
    b -= tileSize;
    if (b < tileSize)   return ivec2(b, tileSize - 1);
    b -= tileSize;
    if (b < inner)      return ivec2(0, b + 1);
    b -= inner;
    return ivec2(tileSize - 1, b + 1);
}

// ───────────── 光线方向 ─────────────

// 球面 Fibonacci：近似等立体角分布，卷积时权重直接用 max(0, n·d)，不用再乘每条光线的立体角
vec3 ddgiSphericalFibonacci(float i, float n)
{
    const float PHI = 1.61803398875;
    float phi = DDGI_TWO_PI * fract(i * (PHI - 1.0));
    float cosTheta = 1.0 - (2.0 * i + 1.0) / n;
    float sinTheta = sqrt(clamp(1.0 - cosTheta * cosTheta, 0.0, 1.0));
    return vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
}

uint ddgiHash(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

// 每帧一个均匀随机旋转（Shoemake 随机四元数）。光追与混合按同一 frameIndex 现算，结果一致
mat3 ddgiRandomRotation(uint frameIndex)
{
    uint h0 = ddgiHash(frameIndex * 3u + 0x9e3779b9u);
    uint h1 = ddgiHash(h0 ^ 0x85ebca6bu);
    uint h2 = ddgiHash(h1 ^ 0xc2b2ae35u);
    vec3 u = vec3(float(h0), float(h1), float(h2)) * (1.0 / 4294967296.0);

    float s1 = sqrt(1.0 - u.x);
    float s2 = sqrt(u.x);
    float a = DDGI_TWO_PI * u.y;
    float b = DDGI_TWO_PI * u.z;
    float x = s1 * sin(a);
    float y = s1 * cos(a);
    float z = s2 * sin(b);
    float w = s2 * cos(b);

    return mat3(    // 列主序
        1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y + w * z),       2.0 * (x * z - w * y),
        2.0 * (x * y - w * z),       1.0 - 2.0 * (x * x + z * z), 2.0 * (y * z + w * x),
        2.0 * (x * z + w * y),       2.0 * (y * z - w * x),       1.0 - 2.0 * (x * x + y * y)
    );
}

#endif

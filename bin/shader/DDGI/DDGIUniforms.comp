#ifndef DDGI_UNIFORMS_COMP
#define DDGI_UNIFORMS_COMP

// DDGI 共享 UBO、体积表与槽位映射（C++ 镜像：DDGIDef.h 的 DDGIUniforms / DDGIVolumeGPU）。
// 槽位按世界格子滚动寻址：体积内局部格子 c 的槽位 = base + 线性下标((originCell + c) mod counts)。
// 同一个世界格子的探针在体积平移时不换槽位，图集原地更新，不需要 history；
// 新进入体积的格子占用刚离开的格子的槽位，由 DDGIReset.comp 在探针更新前清零。
// 包含前需先定义 DDGI_UBO_BINDING、DDGI_VOLUME_BINDING（可选 DDGI_PROBE_INFO_BINDING），并先包含 DDGICore.comp。
// 注意：注释里不要写完整的 include 指令。

const uint DDGI_VOLUME_CASCADE        = 1u;
const uint DDGI_VOLUME_AUTO_RELOCATE  = 2u;
const uint DDGI_VOLUME_HISTORY        = 4u;     // 本帧没有整体重置（只用于调试）

const uint DDGI_PROBE_DISABLED = 1u;
const uint DDGI_PROBE_LOCKED   = 2u;
const uint DDGI_PROBE_INACTIVE = 4u;     // 已弃用：被覆盖改为 ddgiProbeCovered 现算，CPU 不再写这一位
const uint DDGI_PROBE_SELECTED = 8u;

layout(set = 0, binding = DDGI_UBO_BINDING) uniform DDGIParamsUBO
{
    vec4  shadingParams;    // x normalBias，y viewBias，z energy，w skyIntensity
    vec4  filterParams;     // x 背面权重指数，y 时域混合系数，z 光照突变阈值，w maxRayDistance
    vec4  drawParams;       // x 探针球半径（相对最小间距）
    uvec4 counts;           // x 体积数，y 已用槽位上界（槽位可能不连续），z 本帧更新数，w frameIndex
    uvec4 flags;            // x 历史可用，y 天空 cubemap 可用，z 烘焙体积下标，w 漏光调试开关
    uvec4 debug;            // xy 漏光调试像素，z 可视化模式，w 只显示的体积下标
    vec4  cameraPos;
} ddgi;

struct DDGIVolume
{
    vec4  origin;       // xyz 最小角（世界），w 边缘过渡宽度（格）
    vec4  spacing;      // xyz 间距，w 优先级
    uvec4 counts;       // xyz 每轴探针数，w base（常驻，体积存在期间不变）
    ivec4 originCell;   // xyz 最小角格子（世界格子坐标），w 保留
    uvec4 state;        // x 标志（DDGI_VOLUME_*），yzw 保留
    uvec4 info;         // x ID，y 轮转周期，z 相位，w 级联层
    vec4  reserved;
};

layout(std430, set = 0, binding = DDGI_VOLUME_BINDING) readonly buffer DDGIVolumeTable
{
    DDGIVolume ddgiVolumes[];
};

#ifdef DDGI_PROBE_INFO_BINDING
// xyz 手动偏移（锁定探针才有效），w 标志位（floatBitsToUint）
layout(std430, set = 0, binding = DDGI_PROBE_INFO_BINDING) readonly buffer DDGIProbeInfoBuffer
{
    vec4 ddgiProbeInfo[];
};
uint ddgiProbeFlags(uint slot)          { return floatBitsToUint(ddgiProbeInfo[slot].w); }
vec3 ddgiProbeManualOffset(uint slot)   { return ddgiProbeInfo[slot].xyz; }
#endif

uint ddgiVolumeCount()   { return ddgi.counts.x; }
uint ddgiTotalProbes()   { return ddgi.counts.y; }
uint ddgiUpdateCount()   { return ddgi.counts.z; }
uint ddgiFrameIndex()    { return ddgi.counts.w; }
bool ddgiHistoryValid()  { return ddgi.flags.x != 0u; }

uint  ddgiVolumeFlags(uint v)      { return ddgiVolumes[v].state.x; }
uint  ddgiVolumeBase(uint v)       { return ddgiVolumes[v].counts.w; }
uvec3 ddgiVolumeCounts(uint v)     { return ddgiVolumes[v].counts.xyz; }
vec3  ddgiVolumeSpacing(uint v)    { return ddgiVolumes[v].spacing.xyz; }
uint  ddgiVolumeProbeCount(uint v) { uvec3 c = ddgiVolumes[v].counts.xyz; return c.x * c.y * c.z; }
float ddgiMinSpacing(uint v)       { vec3 s = ddgiVolumes[v].spacing.xyz; return min(s.x, min(s.y, s.z)); }

// 深度只关心一格之内的遮挡：截断到 1.5 倍格子对角线，提高 16F 精度，也避免未命中光线把均值和方差拉飞
float ddgiDepthClamp(uint v)       { return min(ddgi.filterParams.w, length(ddgiVolumes[v].spacing.xyz) * 1.5); }

// 非负取模（GLSL 的 % 对负数结果未定义；世界格子坐标可以是负的）
ivec3 ddgiWrapCell(ivec3 a, ivec3 m)
{
    return a - m * ivec3(floor(vec3(a) / vec3(m)));
}

// 体积 v 的局部格子 c（0..counts-1）-> 槽位
uint ddgiProbeSlot(uint v, ivec3 c)
{
    ivec3 counts = ivec3(ddgiVolumeCounts(v));
    ivec3 phys = ddgiWrapCell(ddgiVolumes[v].originCell.xyz + c, counts);
    return ddgiVolumeBase(v) + ddgiLocalIndex(phys, uvec3(counts));
}

// 槽位 -> 体积 v 的局部格子（ddgiProbeSlot 的逆）
ivec3 ddgiSlotLocal(uint v, uint slot)
{
    ivec3 counts = ivec3(ddgiVolumeCounts(v));
    ivec3 phys = ddgiLocalCoord(slot - ddgiVolumeBase(v), uvec3(counts));
    return ddgiWrapCell(phys - ddgiVolumes[v].originCell.xyz, counts);
}

// 槽位 -> 所属体积（体积数很少，线性扫；槽位区间之间可能有空隙，落在空隙里返回 DDGI_INVALID）
uint ddgiFindVolume(uint slot)
{
    for (uint v = 0u; v < ddgiVolumeCount(); ++v)
    {
        uint b = ddgiVolumeBase(v);
        if (slot >= b && slot < b + ddgiVolumeProbeCount(v))
            return v;
    }
    return DDGI_INVALID;
}

vec3 ddgiCellCenter(uint v, ivec3 c)
{
    return ddgiVolumes[v].origin.xyz + (vec3(c) + 0.5) * ddgiVolumes[v].spacing.xyz;
}

// 体积 v 的格子 c 是否被更高优先级（表里排在前面）的体积完全覆盖：该体积在这一带的权重恒为 1，
// 本体积的探针用不到，不更新、不参与采样、可视化时只在「状态」模式下显示为灰色。
// 与 CPU 的 DDGISharedState::BuildCoveredRanges 逐项一致（改一边必须改另一边）：
//   margin = 对方过渡带 fadeCells·spacing_h + 本体积 1.5 格（三线性插值的一格 + 采样偏移）
bool ddgiProbeCovered(uint v, ivec3 c)
{
    vec3 origin = ddgiVolumes[v].origin.xyz;
    vec3 spacing = ddgiVolumes[v].spacing.xyz;
    vec3 pos = vec3(origin.x + (float(c.x) + 0.5) * spacing.x,
                    origin.y + (float(c.y) + 0.5) * spacing.y,
                    origin.z + (float(c.z) + 0.5) * spacing.z);
    for (uint h = 0u; h < v; ++h)
    {
        vec3 hOrigin = ddgiVolumes[h].origin.xyz;
        vec3 hSpacing = ddgiVolumes[h].spacing.xyz;
        vec3 margin = ddgiVolumes[h].origin.w * hSpacing + 1.5 * spacing;
        vec3 mn = hOrigin + margin;
        vec3 mx = hOrigin + vec3(ddgiVolumes[h].counts.xyz) * hSpacing - margin;
        if (all(greaterThan(pos, mn)) && all(lessThan(pos, mx)))
            return true;
    }
    return false;
}

ivec3 ddgiWorldCell(uint v, ivec3 c)
{
    return ddgiVolumes[v].originCell.xyz + c;
}

vec3 ddgiProbeRayDirection(uint rayIndex, mat3 rotation)
{
    return normalize(rotation * ddgiSphericalFibonacci(float(rayIndex), float(DDGI_RAY_COUNT)));
}

#ifdef DDGI_PROBE_INFO_BINDING
// 本帧追踪时使用的探针偏移：锁定 = 手动偏移；开了自动重定位 = 上一帧算出的偏移；否则不偏移。
// prevData 为该探针更新前的 probeData（新格子已被清零）。光追与混合必须得到同一个值
vec3 ddgiCurrentOffset(uint v, uint slot, vec4 prevData)
{
    vec3 limit = ddgiVolumes[v].spacing.xyz * 0.45;
    uint flags = ddgiProbeFlags(slot);
    if ((flags & DDGI_PROBE_LOCKED) != 0u)
        return clamp(ddgiProbeManualOffset(slot), -limit, limit);
    if ((ddgiVolumeFlags(v) & DDGI_VOLUME_AUTO_RELOCATE) == 0u || !(prevData.w > 0.0)
        || any(isnan(prevData.xyz)) || any(isinf(prevData.xyz)))
        return vec3(0.0);
    return clamp(prevData.xyz, -limit, limit);
}
#endif

#endif

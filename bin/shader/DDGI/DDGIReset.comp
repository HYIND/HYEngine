#version 460

// DDGI 槽位重置：在探针更新（光追）之前清零 probeData / probeStats。
// 图集按世界格子滚动寻址（见 DDGIUniforms.comp），体积平移后新进入的格子占用刚离开的格子的槽位，
// 里面还是旧格子的数据，必须作废；另外还有新分配 / 重新分配 / 历史失效的整个体积，以及被手动禁用的探针。
// n = 0 的探针采样时跳过、混合时按新探针直接覆盖，所以辐照度和深度图集不用清。
// resetList[0] = 数量，之后依次是槽位。dispatch = ceil(数量 / 64)。

#include "shader/DDGI/DDGICore.comp"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform writeonly image2D probeDataAtlas;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D probeStatsAtlas;
layout(std430, set = 0, binding = 2) readonly buffer DDGIResetList
{
    uint ddgiResetList[];
};

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= ddgiResetList[0])
        return;

    ivec2 p = ddgiTileOrigin(ddgiResetList[i + 1u], 1u);
    imageStore(probeDataAtlas, p, vec4(0.0));
    imageStore(probeStatsAtlas, p, vec4(0.0));
}

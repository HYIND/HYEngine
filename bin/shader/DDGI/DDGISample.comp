#ifndef DDGI_SAMPLE_COMP
#define DDGI_SAMPLE_COMP

// DDGI 采样，全屏 Apply 与探针多次反弹共用。
// 包含前需要：DDGICore.comp、DDGIUniforms.comp，以及
//   sampler2D irradianceAtlas  // rgb = E/π，a = 背面命中比例
//   sampler2D depthAtlas       // rg  = (E[t], E[t²])
//
// 返回 Lbar = E/π，乘漫反射反照率即出射辐亮度。
// 权重（与 RTXGI 一致）：背面 wrap + 0.2 下限、Chebyshev³（下限 0.05）、小权重三次方压低、剔除埋在几何里的探针。
// toViewer：viewBias 的方向，Apply 指向相机，多次反弹指向发射光线的探针。
// skipFresh：多次反弹读的是上一帧 history，需跳过本帧新进入窗口的探针。
vec3 ddgiSampleIrradiance(vec3 worldPos, vec3 normal, vec3 toViewer, bool skipFresh)
{
    vec3 biasedPos = worldPos + normal * ddgi.shadingParams.x + toViewer * ddgi.shadingParams.y;
    vec3 gridPos = (biasedPos - ddgi.volumeOrigin.xyz) / ddgi.volumeSpacing.xyz;

    // 体积边缘向内一格淡出（autoFit 每边至少外扩一格，场景表面不会落进淡出区）
    vec3 countsF = vec3(ddgi.volumeCounts.xyz);
    vec3 fadeAxis = smoothstep(vec3(0.0), vec3(1.0), min(gridPos, countsF - gridPos));
    float fade = fadeAxis.x * fadeAxis.y * fadeAxis.z;
    if (fade <= 0.0)
        return vec3(0.0);

    vec3 q = gridPos - 0.5;     // 探针中心在 i + 0.5
    ivec3 base = ivec3(floor(q));
    vec3 alpha = clamp(q - vec3(base), 0.0, 1.0);
    alpha = alpha * alpha * (3.0 - 2.0 * alpha);    // 格子边界处梯度连续

    ivec3 maxCoord = ivec3(ddgi.volumeCounts.xyz) - ivec3(1);
    vec2 irrAtlasSize = vec2(textureSize(irradianceAtlas, 0));
    vec2 depthAtlasSize = vec2(textureSize(depthAtlas, 0));
    float backfaceExp = max(ddgi.filterParams.x, 0.001);
    const float minVariance = 1e-4;     // 防止 Chebyshev 除零

    vec3 sum = vec3(0.0);
    float weightSum = 0.0;

    for (int c = 0; c < 8; ++c)
    {
        ivec3 offset = ivec3(c & 1, (c >> 1) & 1, (c >> 2) & 1);
        ivec3 coord = clamp(base + offset, ivec3(0), maxCoord);
        if (skipFresh && ddgiProbeIsFresh(coord))
            continue;

        vec3 tri = mix(1.0 - alpha, alpha, vec3(offset));
        float wTri = tri.x * tri.y * tri.z;
        if (wTri <= 0.0)
            continue;

        vec3 probePos = ddgiProbeWorldPos(coord);
        uint idx = ddgiPhysicalIndex(coord);

        // 背面 wrap：用未偏移的位置
        float wrap = (dot(normalize(probePos - worldPos), normal) + 1.0) * 0.5;
        float w = pow(wrap, backfaceExp) + 0.2;

        // Chebyshev：用偏移后的位置
        vec3 toProbe = probePos - biasedPos;
        float dist = length(toProbe);
        ivec2 depthTile = ddgiTileOrigin(idx, uint(DDGI_DEPTH_TILE));
        vec2 depthUV = ddgiProbeSampleUV(depthTile, -toProbe / max(dist, 1e-4), uint(DDGI_DEPTH_INNER), depthAtlasSize);
        vec2 moments = textureLod(depthAtlas, depthUV, 0.0).rg;

        float chebyshev = 1.0;
        if (dist > moments.x)
        {
            float variance = max(abs(moments.y - moments.x * moments.x), minVariance);
            float d = dist - moments.x;
            chebyshev = variance / (variance + d * d);
            chebyshev = chebyshev * chebyshev * chebyshev;
        }
        w *= max(chebyshev, 0.05);

        // 小权重三次方压低
        w = max(w, 1e-6);
        const float crushThreshold = 0.2;
        if (w < crushThreshold)
            w *= (w * w) / (crushThreshold * crushThreshold);

        // 辐照度；背面命中比例高（探针埋在实心几何里）时剔除
        ivec2 irrTile = ddgiTileOrigin(idx, uint(DDGI_IRR_TILE));
        vec4 irr = textureLod(irradianceAtlas, ddgiProbeSampleUV(irrTile, normal, uint(DDGI_IRR_INNER), irrAtlasSize), 0.0);
        w *= 1.0 - smoothstep(0.55, 0.9, clamp(irr.a, 0.0, 1.0));

        w *= wTri;
        sum += irr.rgb * w;
        weightSum += w;
    }

    return weightSum > 1e-5 ? sum / weightSum * fade : vec3(0.0);
}

#endif

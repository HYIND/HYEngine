#version 460

// DDGI 光线 -> 探针：余弦卷积、深度矩、时域混合、边框。
// dispatch = (1, 1, probeCount)，一个 workgroup（RayGrid² = 256 线程）负责一个探针：
//   1) 每个线程读一条光线及其方向进 shared memory；线程 0 更新该探针的时域状态并算出混合系数；
//   2) 辐照度内层每个 texel：Σ max(0, n·d)·L / Σ max(0, n·d)，即 E/π；alpha 存背面命中比例；
//   3) 深度内层每个 texel：权重 max(0, n·d)^50，累积 (t, t²)，t 截断到 1.5 倍格子对角线；
//      存矩而不是方差，时域混合是线性的，方差由采样端现算；
//   4) 与 history 指数混合（全量重置或新进入窗口的探针直接覆盖），混合系数见下；
//   5) 整 texel 拷贝回填边框。
// 本帧没轮到的探针整块拷贝 history（output 每帧是新纹理，必须写满）。
//
// 混合系数 α（new = mix(history, current, α)）：
//   * 基础值 1 - hysteresis；
//   * 1/n 递增：α = max(1/n, 基础值)，n 为该探针已累积的更新次数。重置后前几次更新是算术平均，
//     几帧内收敛，之后退化为固定系数的指数平均；
//   * 光照突变（探针级）：用探针所有光线的平均亮度 pm 维护两条指数平均——慢线 slow（同时统计
//     pm 的时间方差 var）与快线 fast（系数 0.5，平滑掉单帧尖峰）。|fast - slow| 同时超过
//     「阈值 × slow」和「3 倍 fast 的噪声标准差」时判定为突变，本次更新整个探针的辐照度
//     hysteresis 降低 0.75。噪声用跨帧统计的时间方差，而不是单帧样本方差：
//     小而亮的光源（门外的阳光、小自发光）每帧只被一两条光线命中，单帧样本方差会严重低估噪声，
//     逐 texel 用它做判定会把噪声当成突变，画面持续闪烁（早先的实现就是这样）。
//     深度不受突变加速影响。

#define DDGI_UBO_BINDING 4
#include "shader/DDGI/DDGICore.comp"
#include "shader/DDGI/DDGIUniforms.comp"

layout(local_size_x = DDGI_RAY_GRID, local_size_y = DDGI_RAY_GRID, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D rayData;
layout(set = 0, binding = 1) uniform sampler2D irradianceHistory;
layout(set = 0, binding = 2) uniform sampler2D depthHistory;
layout(set = 0, binding = 3, rgba16f) uniform image2D irradianceOut;
layout(set = 0, binding = 5, rg16f) uniform image2D depthOut;
// 每探针时域状态（持久，原地读写）：r = 累积次数 n，g = slow，b = var，a = fast
layout(set = 0, binding = 6, rgba32f) uniform image2D probeState;

const float DDGI_MAX_ACCUMULATE = 1024.0;   // 只要大于 1/(1-hysteresis) 即可
const float DDGI_STAT_MIN_RATE = 0.05;      // 慢线与方差的最小更新率（约 20 次更新的记忆）
const float DDGI_FAST_RATE = 0.5;           // 快线更新率
const float DDGI_CHANGE_SIGMA = 3.0;        // 突变检测的噪声容限（快线标准差倍数）
const float DDGI_CHANGE_WARMUP = 8.0;       // 重置后前几次更新统计量不可靠，不做突变检测（1/n 本身已经很快）
const float DDGI_CHANGE_HYSTERESIS_DROP = 0.75;
const vec3  DDGI_LUMA = vec3(0.2126, 0.7152, 0.0722);

shared vec4 sRay[DDGI_RAY_COUNT];       // rgb 辐亮度，a 命中距离（负 = 背面）
shared vec3 sDir[DDGI_RAY_COUNT];
shared float sLum[DDGI_RAY_COUNT];
shared vec4 sIrr[DDGI_IRR_INNER * DDGI_IRR_INNER];
shared vec2 sDepth[DDGI_DEPTH_INNER * DDGI_DEPTH_INNER];
shared float sAlpha;                    // 深度用
shared float sAlphaIrr;                 // 辐照度用（含突变加速）

// x^50 = x^32 · x^16 · x^2，反复平方代替 pow
float ddgiPow50(float x)
{
    float x2 = x * x;
    float x4 = x2 * x2;
    float x8 = x4 * x4;
    float x16 = x8 * x8;
    float x32 = x16 * x16;
    return x32 * x16 * x2;
}

// 线程 0 调用：更新探针时域状态，写出本次更新的混合系数
void ddgiUpdateProbeState(uint probeIndex, bool overwrite)
{
    // 探针平均亮度：球面 Fibonacci 等立体角，直接算术平均
    float pm = 0.0;
    for (int k = 0; k < DDGI_RAY_COUNT; ++k)
        pm += sLum[k];
    pm /= float(DDGI_RAY_COUNT);

    float base = clamp(ddgi.filterParams.y, 0.0, 1.0);
    ivec2 statePos = ddgiTileOrigin(probeIndex, 1u);
    vec4 prev = imageLoad(probeState, statePos);

    // 初始内容未定义：n 不是 >= 1 的有限值（含 NaN）时按重置处理
    bool valid = !overwrite && prev.r >= 1.0 && !any(isnan(prev)) && !any(isinf(prev));
    if (!valid)
    {
        imageStore(probeState, statePos, vec4(1.0, pm, 0.0, pm));
        sAlpha = 1.0;
        sAlphaIrr = 1.0;
        return;
    }

    float n = min(prev.r + 1.0, DDGI_MAX_ACCUMULATE);
    float slow = prev.g;
    float var = prev.b;
    float fast = mix(prev.a, pm, DDGI_FAST_RATE);

    float alpha = max(1.0 / n, base);
    float alphaIrr = alpha;

    float threshold = ddgi.filterParams.w;
    float diff = abs(fast - slow);
    float fastSigma = sqrt(var * DDGI_FAST_RATE / (2.0 - DDGI_FAST_RATE));   // EMA 的稳态标准差
    if (threshold > 0.0 && n > DDGI_CHANGE_WARMUP
        && diff > threshold * max(slow, 1e-6) && diff > DDGI_CHANGE_SIGMA * fastSigma)
    {
        alphaIrr = max(alpha, min(1.0, base + DDGI_CHANGE_HYSTERESIS_DROP));
        slow = fast;                        // 慢线直接跳到新水平，方差保留
    }
    else
    {
        float rate = max(1.0 / n, DDGI_STAT_MIN_RATE);
        float dev = pm - slow;
        var = (1.0 - rate) * (var + rate * dev * dev);
        slow += rate * dev;
    }

    imageStore(probeState, statePos, vec4(n, slow, var, fast));
    sAlpha = alpha;
    sAlphaIrr = alphaIrr;
}

void main()
{
    uint probeIndex = gl_WorkGroupID.z;
    if (probeIndex >= ddgiProbeCount())
        return;                                 // 整个 workgroup 一致，不影响 barrier

    uint t = gl_LocalInvocationIndex;
    ivec2 irrTile = ddgiTileOrigin(probeIndex, uint(DDGI_IRR_TILE));
    ivec2 depthTile = ddgiTileOrigin(probeIndex, uint(DDGI_DEPTH_TILE));

    ivec3 logical = ddgiLogicalCoord(probeIndex);
    bool overwrite = ddgiFullReset() || ddgiProbeIsFresh(logical);

    if (!ddgiProbeUpdatedThisFrame(probeIndex, logical))
    {
        for (uint i = t; i < uint(DDGI_IRR_TILE * DDGI_IRR_TILE); i += uint(DDGI_RAY_COUNT))
        {
            ivec2 p = irrTile + ivec2(int(i) % DDGI_IRR_TILE, int(i) / DDGI_IRR_TILE);
            imageStore(irradianceOut, p, texelFetch(irradianceHistory, p, 0));
        }
        for (uint i = t; i < uint(DDGI_DEPTH_TILE * DDGI_DEPTH_TILE); i += uint(DDGI_RAY_COUNT))
        {
            ivec2 p = depthTile + ivec2(int(i) % DDGI_DEPTH_TILE, int(i) / DDGI_DEPTH_TILE);
            imageStore(depthOut, p, vec4(texelFetch(depthHistory, p, 0).rg, 0.0, 0.0));
        }
        return;
    }

    // 1) 读光线，更新时域状态
    ivec2 rayTile = ddgiTileOrigin(probeIndex, uint(DDGI_RAY_GRID));
    sRay[t] = texelFetch(rayData, rayTile + ivec2(gl_LocalInvocationID.xy), 0);
    sDir[t] = ddgiProbeRayDirection(t, ddgiRandomRotation(ddgi.runParams.y));
    sLum[t] = dot(sRay[t].rgb, DDGI_LUMA);
    barrier();

    if (t == 0u)
        ddgiUpdateProbeState(probeIndex, overwrite);
    barrier();

    float alpha = sAlpha;
    float alphaIrr = sAlphaIrr;

    // 2) 辐照度：余弦卷积
    if (t < uint(DDGI_IRR_INNER * DDGI_IRR_INNER))
    {
        ivec2 local = ivec2(int(t) % DDGI_IRR_INNER, int(t) / DDGI_IRR_INNER);
        vec3 n = ddgiOctDecode((vec2(local) + 0.5) / float(DDGI_IRR_INNER));

        vec3 sum = vec3(0.0);
        float wsum = 0.0;
        float backface = 0.0;
        for (int k = 0; k < DDGI_RAY_COUNT; ++k)
        {
            vec4 r = sRay[k];
            backface += r.a < 0.0 ? 1.0 : 0.0;
            float w = dot(n, sDir[k]);
            if (w <= 0.0)
                continue;
            sum += r.rgb * w;
            wsum += w;
        }
        vec4 irr = vec4(wsum > 1e-6 ? sum / wsum : vec3(0.0), backface / float(DDGI_RAY_COUNT));

        ivec2 dst = irrTile + ivec2(1) + local;
        if (!overwrite)
            irr = mix(texelFetch(irradianceHistory, dst, 0), irr, alphaIrr);

        sIrr[t] = irr;
        imageStore(irradianceOut, dst, irr);
    }

    // 3) 深度：cos^50 加权的一阶 / 二阶矩
    if (t < uint(DDGI_DEPTH_INNER * DDGI_DEPTH_INNER))
    {
        ivec2 local = ivec2(int(t) % DDGI_DEPTH_INNER, int(t) / DDGI_DEPTH_INNER);
        vec3 n = ddgiOctDecode((vec2(local) + 0.5) / float(DDGI_DEPTH_INNER));
        float depthClamp = max(ddgi.filterParams.z, 0.01);

        vec2 sum = vec2(0.0);
        float wsum = 0.0;
        for (int k = 0; k < DDGI_RAY_COUNT; ++k)
        {
            float c = dot(n, sDir[k]);
            if (c <= 0.0)
                continue;
            float w = ddgiPow50(c);
            float d = min(abs(sRay[k].a), depthClamp);
            sum += vec2(d, d * d) * w;
            wsum += w;
        }
        // 权重和为 0（实际不会出现）时按无遮挡处理
        vec2 moments = wsum > 1e-6 ? sum / wsum : vec2(depthClamp, depthClamp * depthClamp);

        ivec2 dst = depthTile + ivec2(1) + local;
        if (!overwrite)
            moments = mix(texelFetch(depthHistory, dst, 0).rg, moments, alpha);

        sDepth[t] = moments;
        imageStore(depthOut, dst, vec4(moments, 0.0, 0.0));
    }

    barrier();

    // 5) 边框：先深度、再辐照度，每个线程最多一个 texel
    const int depthBorderCount = 4 * DDGI_DEPTH_TILE - 4;
    const int irrBorderCount = 4 * DDGI_IRR_TILE - 4;
    int b = int(t);
    if (b < depthBorderCount)
    {
        ivec2 p = ddgiBorderTexelCoord(b, DDGI_DEPTH_TILE);
        ivec2 src = ddgiBorderSourceTexel(p, DDGI_DEPTH_INNER);
        imageStore(depthOut, depthTile + p, vec4(sDepth[src.y * DDGI_DEPTH_INNER + src.x], 0.0, 0.0));
    }
    else if (b < depthBorderCount + irrBorderCount)
    {
        ivec2 p = ddgiBorderTexelCoord(b - depthBorderCount, DDGI_IRR_TILE);
        ivec2 src = ddgiBorderSourceTexel(p, DDGI_IRR_INNER);
        imageStore(irradianceOut, irrTile + p, sIrr[src.y * DDGI_IRR_INNER + src.x]);
    }
}

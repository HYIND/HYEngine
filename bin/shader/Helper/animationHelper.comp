vec4 CalculateIfHasAnimationData(vec4 pos)
{
    if(animationMeta.animationcount > 0)
        return CalculateAnimationData(pos);
    return pos;
}

CalucateResult CalculateIfHasAnimationData(vec4 pos, vec3 normal, vec3 tangent, vec3 bitangent)
{
    if(animationMeta.animationcount > 0)
        return CalculateAnimationData(pos, normal, tangent, bitangent);

    CalucateResult r;
    r.pos = pos;
    r.normal = normal;
    r.tangent = tangent;
    r.bitangent = bitangent;
    return r;
}


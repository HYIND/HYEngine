const float linera_radius_factor = 0.8;	//距离到底0.8光照半径改用线性衰减，使光强平滑衰减至0，消除截断
const float linera_radius_factor2 = linera_radius_factor * linera_radius_factor;
const float one_minus_linera_radius_factor = 1.0f - linera_radius_factor;



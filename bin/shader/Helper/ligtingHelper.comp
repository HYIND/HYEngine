vec3 CalcLighting(
    mat4 view, vec3 viewPos, float cameraFarPlane,
	sampler2D atlasMap,
    vec3 fragPos, vec3 fragNormal, 
	PBRProperties prop
)
{
	vec3 viewDir = normalize(fragPos - viewPos);		

	vec3 lightColor = vec3(0.f,0.f,0.f);
	for(uint i = 0;i < dirLightMetaData.dirLightCount; i++)
		lightColor += CalcDirLight(dirLightMetaData.info[i], atlasMap, fragNormal, fragPos, view, viewDir, prop);
	for(uint i = 0;i < pointLightMetaData.pointLightCount; i++)
		lightColor += CalcPointLight(pointLightMetaData.info[i], atlasMap, fragNormal, viewPos, cameraFarPlane, fragPos, viewDir, prop);
	for(uint i = 0;i < spotLightMetaData.spotLightCount; i++)
		lightColor += CalcSpotLight(spotLightMetaData.info[i], atlasMap, fragNormal, fragPos, viewDir, prop);

	return lightColor;
}


DirLightCascade GetCascade(vec4 fragPosViewSpace, int cascadeFirst, int cascadeCount)
{
    float depthValue = abs(fragPosViewSpace.z);

	int start = cascadeFirst;
	int end = cascadeFirst + cascadeCount;
    for (int i = start; i < end; ++i)
    {
        if (depthValue < dirLightCascadeData.info[i].cascadePlaneDistance)
           	return dirLightCascadeData.info[i];
    }

	return dirLightCascadeData.info[end - 1];
}

float SamplerAtlasMap(vec2 subTexPos, sampler2D atlasMap, vec2 atlasSize, vec2 subStart, vec2 subSize)
{
	vec2 subPixelPos = subTexPos * subSize;
	subPixelPos.x = clamp(subPixelPos.x, 1, subSize.x - 1);
	subPixelPos.y = clamp(subPixelPos.y, 1, subSize.y - 1);
	vec2 atlasTexPos = (subStart + subPixelPos) * atlasSize;

	return texture(atlasMap, atlasTexPos).r;
}

float SamplerAtlasCubeMap(vec3 dir, sampler2D atlasMap, vec2 atlasSize, vec2 subStart[6], vec2 subSize[6])
{
    vec3 absDir = abs(dir);

	int faceIndex;
    float ma;
    vec2 sc;      // 剩余两个分量

	// === 1. 判断主面 ===
	if (absDir.x >= absDir.y && absDir.x >= absDir.z) {
        // X 轴为主
        if (dir.x > 0.0) {
            faceIndex = 0; // +X (Right)
			// sc = vec2(-dir.z, -dir.y);
            sc = vec2(-dir.z, -dir.y);
        } else {
            faceIndex = 1; // -X (Left)
			sc = vec2(dir.z, -dir.y);
            // sc = vec2(dir.z, -dir.y);
        }
		ma = absDir.x;
    } 
    else if (absDir.y >= absDir.x && absDir.y >= absDir.z) {
        // Y 轴为主
        if (dir.y > 0.0) {
            faceIndex = 2; // +Y (Top)
            sc = vec2(dir.x, dir.z);
        } else {
            faceIndex = 3; // -Y (Bottom)
            sc = vec2(dir.x, -dir.z);
        }
		ma = absDir.y;
    } 
    else {
        // Z 轴为主
        if (dir.z > 0.0) {
            faceIndex = 4; // +Z (Front)
            sc = vec2(dir.x, -dir.y);
        } else {
            faceIndex = 5; // -Z (Back)
            sc = vec2(-dir.x, -dir.y);
        }
		ma = absDir.z;
    }

 	// === 2. 计算 UV 坐标 (映射到 0-1) ===
	// sc.y = -sc.y;
	vec2 uv = (sc / ma + 1.0) * 0.5;
	uv.y = 1.0f - uv.y;

	return SamplerAtlasMap(uv, atlasMap, atlasSize, subStart[faceIndex], subSize[faceIndex]);
}

float SamplerAtlasMapWithCompare(vec2 subTexPos, sampler2D atlasMap, vec2 atlasSize, vec2 subStart, vec2 subSize, float refDepth)
{
	return SamplerAtlasMap(subTexPos, atlasMap, atlasSize, subStart, subSize) < refDepth ? 0.f : 1.f;
}

float SamplerAtlasCubeMapWithCompare(vec3 dir, sampler2D atlasMap, vec2 atlasSize, vec2 subStart[6], vec2 subSize[6], float refDepth)
{
	return SamplerAtlasCubeMap(dir, atlasMap, atlasSize, subStart, subSize) < refDepth ? 0.f : 1.f;
}

vec3 NormalBias(vec3 fragPos, vec3 lightDir, vec3 normal, float biasFactor)
{
	float bias = biasFactor * (1.0 - dot(normalize(normal), lightDir));
	vec3 shiftedPos = fragPos + normal * bias;
	return shiftedPos;
}

float DirLightShadowCalculation(vec4 fragPosLightSpace, sampler2D atlasMap, vec2 subStart, vec2 subSize)
{
	vec2 texelSize = 1.0 / subSize;
	vec2 atlasSize = 1.0 / textureSize(atlasMap, 0);

    vec3 projCoords = fragPosLightSpace.xyz / fragPosLightSpace.w;
    float currentDepth = projCoords.z;
	currentDepth = clamp(currentDepth, 0.0, 1.0);
	
    projCoords = projCoords * 0.5 + 0.5;

	if(currentDepth >= 1.0)
        return 0.0;

	// return 1.0 - SamplerAtlasMapWithCompare(projCoords.xy, atlasMap, atlasSize, subStart, subSize, currentDepth); 

	float shadow = 0.0;
	for(int x = -1; x <= 1; ++x)
	{
		for(int y = -1; y <= 1; ++y)
		{
			// float pcfDepth = SamplerAtlasMap(projCoords.xy + vec2(x, y) * texelSize, atlasMap, atlasSize, subStart, subSize);  
			// shadow += currentDepth > pcfDepth ? 1.0 : 0.0;     

			float temp = 1.0 - SamplerAtlasMapWithCompare(projCoords.xy + vec2(x, y) * texelSize, atlasMap, atlasSize, subStart, subSize, currentDepth);  
			shadow += temp;
		}    
	}
	shadow /= 9.0;

    return shadow;
}

float PointLightShadowCalculation(vec3 cameraPos, float cameraFarPlane, vec3 fragPos, vec3 lightPos, sampler2D atlasMap, vec2 subStart[6], vec2 subSize[6], float radius)
{
	vec3 lightToFrag = fragPos - lightPos;
    float currentDepth = length(fragPos - lightPos);

	vec2 atlasSize = 1.0 / textureSize(atlasMap, 0);

    float distanceFactor = (radius - currentDepth) * 0.002;

	// float distanceFactor = (radius - currentDepth) / radius;
    // distanceFactor = distanceFactor * distanceFactor;
	// float depthBias = distanceFactor + 0.2;
	
	float depthBias = distanceFactor;
    float refDepth = (currentDepth - depthBias) / radius;

	float shadow = 0.0;

	int samplenumber = 1;
	int sampleWidth = 1 + samplenumber * 2;
	int sumsamplecount = sampleWidth * sampleWidth * sampleWidth;

	float stride = (1.0 + (length(cameraPos - fragPos) / cameraFarPlane)) / 25.0;

	float min_offset = -samplenumber * stride;
	float max_offset = -min_offset;

	for(float x = min_offset; x <= max_offset; x += stride)
	{
		for(float y = min_offset; y <= max_offset; y += stride)
		{
			for(float z = min_offset; z <= max_offset; z += stride)
			{
				float temp = SamplerAtlasCubeMapWithCompare(normalize(lightToFrag + vec3(x, y, z)), atlasMap, atlasSize, subStart, subSize, refDepth);
				shadow += temp;
			}
		}
	}
    return 1.0f - shadow / float(sumsamplecount);
}

vec3 CalcDirLightWithoutShadow(DirLight light, vec3 normal, vec3 viewDir, PBRProperties prop)
{
	vec3 radiance = light.color * light.luxIntensity;

	float NdotL;
	vec3 diffuse = vec3(0.0);
	vec3 specular = vec3(0.0);

	CalcBDRF(normal, -viewDir, -light.direction, prop.albedo, prop.metallic, prop.roughness, NdotL, diffuse, specular);

	vec3 Lo = diffuse + specular;
	vec3 lightingColor = Lo * radiance * NdotL;

	vec3 result = lightingColor;

#ifdef Virtual_Ambient_Enable
		vec3 ambient = vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
		result = max(result, ambient);
#endif

	return result;
}

vec3 CalcPointLightWithoutShadow(PointLight light, vec3 normal, vec3 fragPos, vec3 viewDir, PBRProperties prop)
{
	float dist = length(light.position - fragPos);
    if(dist >= light.radius)
		return vec3(0.f);

	float linera_radius = light.radius * linera_radius_factor;
    float attenuation = dist <= linera_radius ?
						1.0 / (dist * dist + 1) 
						: mix(1.0 / (linera_radius_factor2 * light.radius * light.radius + 1), 0.0, (dist - linera_radius) / (one_minus_linera_radius_factor * light.radius));
    vec3 radiance = light.color * light.cdIntensity * attenuation;

	float NdotL;
	vec3 diffuse = vec3(0.0);
	vec3 specular = vec3(0.0);

	CalcBDRF(normal, -viewDir,  normalize(light.position - fragPos), prop.albedo, prop.metallic, prop.roughness, NdotL, diffuse, specular);

	vec3 Lo = diffuse + specular;	
	vec3 lightingColor = Lo * radiance * NdotL;

	vec3 result = lightingColor;

#ifdef Virtual_Ambient_Enable
		vec3 ambient = vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
		result = max(result, ambient);
#endif

	return result;
}

vec3 CalcSpotLightWithoutShadow(SpotLight light, vec3 normal, vec3 fragPos, vec3 viewDir, PBRProperties prop)
{
    
	float dist = length(light.position - fragPos);
    if(dist >= light.radius)
		return vec3(0.f);

	float intensity = 1.0f;
	float outerCutOff = min(light.cutOff ,light.outerCutOff);
	vec3 lightDir = normalize(fragPos - light.position);

	float theta = dot(lightDir, normalize(light.direction));
	if(theta < outerCutOff)
	{
		return vec3(0.f);
	}
	else if (theta < light.cutOff)
	{
		float epsilon  = light.cutOff - outerCutOff;
		intensity = clamp((theta - outerCutOff) / epsilon, 0.0f, 1.0f); 
	}

  	float linera_radius = light.radius * linera_radius_factor;
    float attenuation = dist <= linera_radius ?
						1.0 / (dist * dist + 1) 
						: mix(1.0 / (linera_radius_factor2 * light.radius * light.radius + 1), 0.0, (dist - linera_radius) / (one_minus_linera_radius_factor * light.radius));
	vec3 radiance = light.color * light.cdIntensity * attenuation;

	float NdotL;
	vec3 diffuse = vec3(0.0);
	vec3 specular = vec3(0.0);

	CalcBDRF(normal, -viewDir,  normalize(light.position - fragPos), prop.albedo, prop.metallic, prop.roughness, NdotL, diffuse, specular);

	vec3 Lo = diffuse + specular;
	vec3 lightingColor = Lo * radiance * NdotL;

	vec3 result = lightingColor * intensity;              
	
#ifdef Virtual_Ambient_Enable
		vec3 ambient = vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
		result = max(result, ambient);
#endif 

	return result;
}


vec3 CalcDirLight(DirLight light, sampler2D atlasMap, vec3 normal, vec3 fragPos, mat4 cameraView ,vec3 viewDir, PBRProperties prop)
{
    vec3 shiftedPos = NormalBias(fragPos, normalize(light.direction), normal, 0.1);
	DirLightCascade cascade = GetCascade(cameraView * vec4(shiftedPos, 1.0f), light.cascadeFirst, light.cascadeCount);
	vec4 fragPosLightSpace = cascade.lightSpaceMatrix * vec4(shiftedPos, 1.0);
	float shadow = DirLightShadowCalculation(fragPosLightSpace, atlasMap, 
											vec2(cascade.atlasX, cascade.atlasY),
	 										vec2(cascade.atlasWidth, cascade.atlasHeight));
    shadow = clamp(shadow, 0.f, 1.f);

	vec3 radiance = light.color * light.luxIntensity;
	if (shadow >= 1.0f)
	{
#ifdef Virtual_Ambient_Enable
		return vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
#else
		return vec3(0.f);
#endif 
	}

	float NdotL;
	vec3 diffuse = vec3(0.0);
	vec3 specular = vec3(0.0);

	CalcBDRF(normal, -viewDir, -light.direction, prop.albedo, prop.metallic, prop.roughness, NdotL, diffuse, specular);

	vec3 Lo = diffuse + specular;
	vec3 lightingColor = Lo * radiance * NdotL;

	vec3 result = (1.0 - shadow) * lightingColor;

#ifdef Virtual_Ambient_Enable
		vec3 ambient = vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
		result = max(result, ambient);
#endif

	return result;
}

vec3 CalcPointLight(PointLight light, sampler2D atlasMap, vec3 normal, vec3 cameraPos, float cameraFarPlane, vec3 fragPos, vec3 viewDir, PBRProperties prop)
{
	float dist = length(light.position - fragPos);
    if(dist >= light.radius)
		return vec3(0.f);

	// vec3 shiftedPos = NormalBias(fragPos, normalize(fragPos - light.position), normal, 0.2);
	float shadow = PointLightShadowCalculation(cameraPos, cameraFarPlane, fragPos, light.position, atlasMap, light.atlasStart, light.atlasSize, light.radius);    
    shadow = clamp(shadow, 0.f, 1.f);

	float linera_radius = light.radius * linera_radius_factor;
    float attenuation = dist <= linera_radius ?
						1.0 / (dist * dist + 1) 
						: mix(1.0 / (linera_radius_factor2 * light.radius * light.radius + 1), 0.0, (dist - linera_radius) / (one_minus_linera_radius_factor * light.radius));
    vec3 radiance = light.color * light.cdIntensity * attenuation;
	if (shadow >= 1.0f)
	{
#ifdef Virtual_Ambient_Enable
		return vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
#else
		return vec3(0.f);
#endif 
	}

	float NdotL;
	vec3 diffuse = vec3(0.0);
	vec3 specular = vec3(0.0);

	CalcBDRF(normal, -viewDir,  normalize(light.position - fragPos), prop.albedo, prop.metallic, prop.roughness, NdotL, diffuse, specular);

	vec3 Lo = diffuse + specular;	
	vec3 lightingColor = Lo * radiance * NdotL;

	vec3 result = (1.0 - shadow) * lightingColor;

#ifdef Virtual_Ambient_Enable
		vec3 ambient = vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
		result = max(result, ambient);
#endif

	return result;
}

vec3 CalcSpotLight(SpotLight light, sampler2D atlasMap, vec3 normal, vec3 fragPos, vec3 viewDir, PBRProperties prop)
{
    
	float dist = length(light.position - fragPos);
    if(dist >= light.radius)
		return vec3(0.f);

	float intensity = 1.0f;
	float outerCutOff = min(light.cutOff ,light.outerCutOff);
	vec3 lightDir = normalize(fragPos - light.position);

	float theta = dot(lightDir, normalize(light.direction));
	if(theta < outerCutOff)
	{
		return vec3(0.f);
	}
	else if (theta < light.cutOff)
	{
		float epsilon  = light.cutOff - outerCutOff;
		intensity = clamp((theta - outerCutOff) / epsilon, 0.0f, 1.0f); 
	}

	vec3 shiftedPos = NormalBias(fragPos, lightDir, normal, 0.1);
	vec4 fragPosLightSpace = light.lightSpaceMatrix * vec4(shiftedPos, 1.0);
	float shadow = DirLightShadowCalculation(fragPosLightSpace, atlasMap, vec2(light.atlasX, light.atlasY), vec2(light.atlasWidth, light.atlasHeight));   
    shadow = clamp(shadow, 0.f, 1.f);

  	float linera_radius = light.radius * linera_radius_factor;
    float attenuation = dist <= linera_radius ?
						1.0 / (dist * dist + 1) 
						: mix(1.0 / (linera_radius_factor2 * light.radius * light.radius + 1), 0.0, (dist - linera_radius) / (one_minus_linera_radius_factor * light.radius));
	vec3 radiance = light.color * light.cdIntensity * attenuation;
	if (shadow >= 1.0f)
	{
#ifdef Virtual_Ambient_Enable
		return vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
#else
		return vec3(0.f);
#endif 
	}

	float NdotL;
	vec3 diffuse = vec3(0.0);
	vec3 specular = vec3(0.0);

	CalcBDRF(normal, -viewDir,  normalize(light.position - fragPos), prop.albedo, prop.metallic, prop.roughness, NdotL, diffuse, specular);

	vec3 Lo = diffuse + specular;
	vec3 lightingColor = Lo * radiance * NdotL;

	vec3 result = (1.0 - shadow) * lightingColor * intensity;              
	
#ifdef Virtual_Ambient_Enable
		vec3 ambient = vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
		result = max(result, ambient);
#endif 

	return result;
}

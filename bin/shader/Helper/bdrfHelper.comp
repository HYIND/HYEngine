
const float PI = 3.14159265359;

struct PBRProperties
{
    vec3 albedo;
    float metallic;
    float roughness; 
    float ambientOcclusion;
};

//BDRF
float DistributionGGX(float NdotH, float roughness);
float GeometrySchlickGGX(float NdotX, float roughness);
float GeometrySmith(float NdotL, float NdotV, float roughness);
vec3 fresnelSchlick(vec3 F0, float VdotH);
void CalcBDRF(
	vec3 normal, vec3 fragToViewDir, vec3 fragToLightDir,
	vec3 albedo, float metallic, float roughness,
	inout float NdotL, inout vec3 diffuse, inout vec3 specular);

float DistributionGGX(float NdotH, float roughness) {
    float a = roughness * roughness;
    float a2 = a * a;
    float denom = NdotH * NdotH * (a2 - 1.0) + 1.0;
    return a2 / (PI * denom * denom);
}

float GeometrySchlickGGX(float NdotX, float roughness) {
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return NdotX / (NdotX * (1.0 - k) + k);
}

float GeometrySmith(float NdotL, float NdotV, float roughness) {
    float ggx1 = GeometrySchlickGGX(NdotV, roughness);
    float ggx2 = GeometrySchlickGGX(NdotL, roughness);
    return ggx1 * ggx2;
}

vec3 fresnelSchlick(vec3 F0, float VdotH) {
	float x = 1.0 - VdotH;
	float x2 = x * x;
	float x5 = x2 * x2 * x;
    return F0 + (1.0 - F0) * x5;
}

void CalcBDRFDiffuse(vec3 albedo, float metallic, inout vec3 diffuse)
{
	// vec3 kS = F;
	// vec3 kD = vec3(1.0) - kS;
	// kD *= (1.0 - metallic);	  

	vec3 kD = vec3(1.0) - metallic;	//对于直接光照，忽略掉1-F的部分，防止在高光区域周围出现一圈“暗环”，视觉效果差
	diffuse = kD * albedo / PI;
}

void CalcBDRFSpecular(
	vec3 normal, vec3 fragToViewDir, vec3 fragToLightDir,
	vec3 albedo, float metallic, float roughness,
	inout float NdotL, inout vec3 specular)
{	
	vec3 N = normalize(normal);           	// 表面法线
	vec3 V = normalize(fragToViewDir); 		// 视线反方向（从表面指向摄像机）
	vec3 L = normalize(fragToLightDir); 	// 光线方向（从表面指向光源）
	vec3 H = normalize(V + L);            	// 半角向量
	NdotL = max(dot(N, L), 0.0);			// 表面法线x指向光线
	float NdotV = max(dot(N, V), 0.0);		// 表面法线x指向摄像机
	float NdotH = max(dot(N, H), 0.0);		// 表面法线x半程向量
	float VdotH = max(dot(V, H), 0.0);		// 指向摄像机x半程向量

    if (NdotL <= 0.0) {
        specular = vec3(0.0);
		return;
    }

	vec3 F0 = mix(vec3(0.02), albedo, metallic);

	// Specular = F × G × D / (4 × NdotL × NdotV)
	float D = DistributionGGX(NdotH, roughness);			//法线分布项 D
    float G = GeometrySmith(NdotL, NdotV, roughness);		//几何遮蔽项 G
	vec3 F = fresnelSchlick(F0, VdotH);

	specular = (F * G * D) / (4.0 * NdotL * NdotV + 0.0001);	//Specular, 0.0001防止除0
}

void CalcBDRF(
	vec3 normal, vec3 fragToViewDir, vec3 fragToLightDir,
	vec3 albedo, float metallic, float roughness,
	inout float NdotL, inout vec3 diffuse, inout vec3 specular)
{
 	CalcBDRFDiffuse(albedo, metallic, diffuse);
	CalcBDRFSpecular(normal, fragToViewDir, fragToLightDir, albedo, metallic, roughness, NdotL, specular);
}
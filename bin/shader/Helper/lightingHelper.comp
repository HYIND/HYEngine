// fragNormal：着色法线（带法线贴图），用于 BRDF；geoNormal：几何法线（插值顶点法线），只用于阴影的法线偏移。
// 阴影图是按真实三角形光栅化的，偏移方向 / 大小要按真实几何面算，法线贴图的扰动会让明暗交界处漏光、阴影边缘爬动
vec3 CalcLightingWithGeometryNormal(
    mat4 view, vec3 viewPos, float cameraFarPlane,
	sampler2D atlasMap,
    vec3 fragPos, vec3 fragNormal, vec3 geoNormal,
	PBRProperties prop
)
{
	vec3 viewDir = normalize(fragPos - viewPos);

	// 双面材质时几何法线可能和着色法线不在同一侧，翻到同一侧，偏移才是往表面「外面」推
	vec3 geoN = normalize(geoNormal);
	if (dot(geoN, fragNormal) < 0.0)
		geoN = -geoN;

	vec3 lightColor = vec3(0.f,0.f,0.f);
	for(uint i = 0;i < dirLightMetaData.dirLightCount; i++)
		lightColor += CalcDirLight(dirLightMetaData.info[i], atlasMap, fragNormal, geoN, fragPos, view, viewDir, prop);
	for(uint i = 0;i < pointLightMetaData.pointLightCount; i++)
		lightColor += CalcPointLight(pointLightMetaData.info[i], atlasMap, fragNormal, geoN, fragPos, viewDir, prop);
	for(uint i = 0;i < spotLightMetaData.spotLightCount; i++)
		lightColor += CalcSpotLight(spotLightMetaData.info[i], atlasMap, fragNormal, geoN, fragPos, viewDir, prop);

	return lightColor;
}

// 没有几何法线的调用方：用着色法线代替（阴影偏移会受法线贴图影响）
vec3 CalcLighting(
    mat4 view, vec3 viewPos, float cameraFarPlane,
	sampler2D atlasMap,
    vec3 fragPos, vec3 fragNormal, 
	PBRProperties prop
)
{
	return CalcLightingWithGeometryNormal(view, viewPos, cameraFarPlane, atlasMap, fragPos, fragNormal, fragNormal, prop);
}


DirLightCascade GetCascade(vec4 fragPosViewSpace, int cascadeFirst, int cascadeCount)
{
    float depthValue = abs(fragPosViewSpace.z);

	int start = cascadeFirst;
	int end = cascadeFirst + cascadeCount;
    for (int i = start; i < end - 1; ++i)
    {
        if (depthValue < cascadeDistances.values[i])
           	return dirLightCascadeData.info[i];
    }

	return dirLightCascadeData.info[end - 1];
}

// 方向光阴影的距离权重：1 = 完整阴影，0 = 不算阴影。
// 超出阴影距离的点不再落到最后一级级联里（那里采样会被夹到子图边缘，出现拉长的条纹），
// 阴影距离末尾一段平滑渐隐。没有分到任何级联（图集放不下）时也按无阴影处理。
// viewDepth 是相机视空间深度的绝对值，和 GetCascade 的判断一致
float DirLightShadowDistanceFade(DirLight light, float viewDepth)
{
	if (!light.castShadow || light.cascadeCount <= 0 || viewDepth >= light.shadowFadeEnd)
		return 0.0;
	if (viewDepth <= light.shadowFadeStart)
		return 1.0;
	return 1.0 - smoothstep(light.shadowFadeStart, light.shadowFadeEnd, viewDepth);
}

// ---------------- 阴影偏移 ----------------
// 分工：深度方向的偏移由画阴影图时的硬件斜率深度偏移（depthBias，每盏灯 shadowSlopeBias）负责，已经写进阴影图，
// 采样时直接用接收点的原始深度比较，不再减偏移；接收端只做法线偏移，补掠射角（斜率偏移在这里要么不够、要么过大）。

// 阴影贴图一个 texel 在 worldPos 处对应的世界尺寸。
// 正交（方向光级联）：clip.w = 1，|row0.xyz| = 2 / 投影宽度；透视（聚光）：clip.w = 到光源的视深，|row0.xyz| = 1 / tan(半张角)
float ShadowTexelWorldSize(mat4 lightSpaceMatrix, vec3 worldPos, float resolution)
{
	vec3 row0 = vec3(lightSpaceMatrix[0][0], lightSpaceMatrix[1][0], lightSpaceMatrix[2][0]);
	vec4 row3 = vec4(lightSpaceMatrix[0][3], lightSpaceMatrix[1][3], lightSpaceMatrix[2][3], lightSpaceMatrix[3][3]);
	float w = abs(dot(row3, vec4(worldPos, 1.0)));
	return 2.0 * w / max(length(row0) * resolution, 1e-6);
}

// 法线偏移：沿几何法线外推 texel × biasTexels × sinθ（θ 是法线和光线的夹角）。
// 正对光源时 sinθ = 0 不偏移（接触阴影不脱开），掠射时最大；偏移量以 texel 为单位，近处级联 / 离光源近时自然很小，薄物体不会被推穿
vec3 ShadowNormalOffset(vec3 geoNormal, vec3 toLight, float texelWorld, float biasTexels)
{
	float NdotL = clamp(dot(geoNormal, toLight), -1.0, 1.0);
	float sinTheta = sqrt(max(1.0 - NdotL * NdotL, 0.0));
	return geoNormal * (texelWorld * biasTexels * sinTheta);
}

// 点光源 cube 每个面的透视投影近平面，必须和 LightShadowDepthPass.cpp 的 kPointShadowNearPlane 一致
const float kPointShadowNearPlane = 0.1;

// 点光源阴影图存的是 cube 面透视投影 vkPerspective(90°, 1, near, radius) 的硬件深度（Vulkan [0,1]）。
// axisDistance 是点在这个面朝向轴上的距离（不是欧氏距离）
float PointShadowFaceDepth(float axisDistance, float farPlane)
{
	float n = kPointShadowNearPlane;
	float z = max(axisDistance, n);
	return farPlane * (z - n) / ((farPlane - n) * z);
}

// 主轴：0 = x，1 = y，2 = z。判定顺序必须和 SamplerAtlasCubeMap 选面一致
int CubeMajorAxis(vec3 v)
{
	vec3 a = abs(v);
	if (a.x >= a.y && a.x >= a.z)
		return 0;
	return a.y >= a.z ? 1 : 2;
}

// 参考深度：采样方向 sampleDir 落在哪个面，就用接收点在那个面朝向轴上的距离。
// PCF 采样跨到相邻面时，主轴变了，必须按采样点所在的面重新算（线性距离不需要，透视深度需要）
float PointShadowRefDepth(vec3 sampleDir, vec3 lightToFrag, float farPlane)
{
	int axis = CubeMajorAxis(sampleDir);
	return PointShadowFaceDepth(abs(lightToFrag[axis]), farPlane);
}

float SamplerAtlasMap(vec2 subTexPos, sampler2D atlasMap, vec2 atlasSize, vec2 subStart, vec2 subSize)
{
	vec2 subPixelPos = subTexPos * subSize;
	subPixelPos.x = clamp(subPixelPos.x, 1, subSize.x - 1);
	subPixelPos.y = clamp(subPixelPos.y, 1, subSize.y - 1);
	vec2 atlasTexPos = (subStart + subPixelPos) * atlasSize;

	return texture(atlasMap, atlasTexPos).r;
}

float SamplerAtlasCubeMap(vec3 dir, sampler2D atlasMap, vec2 atlasSize, vec2 subStart[6], vec2 subSize[6])
{
    vec3 absDir = abs(dir);

	int faceIndex;
    float ma;
    vec2 sc;      // 剩余两个分量

	// === 1. 判断主面 ===
	if (absDir.x >= absDir.y && absDir.x >= absDir.z) {
        // X 轴为主
        if (dir.x > 0.0) {
            faceIndex = 0; // +X (Right)
			// sc = vec2(-dir.z, -dir.y);
            sc = vec2(-dir.z, -dir.y);
        } else {
            faceIndex = 1; // -X (Left)
			sc = vec2(dir.z, -dir.y);
            // sc = vec2(dir.z, -dir.y);
        }
		ma = absDir.x;
    } 
    else if (absDir.y >= absDir.x && absDir.y >= absDir.z) {
        // Y 轴为主
        if (dir.y > 0.0) {
            faceIndex = 2; // +Y (Top)
            sc = vec2(dir.x, dir.z);
        } else {
            faceIndex = 3; // -Y (Bottom)
            sc = vec2(dir.x, -dir.z);
        }
		ma = absDir.y;
    } 
    else {
        // Z 轴为主
        if (dir.z > 0.0) {
            faceIndex = 4; // +Z (Front)
            sc = vec2(dir.x, -dir.y);
        } else {
            faceIndex = 5; // -Z (Back)
            sc = vec2(-dir.x, -dir.y);
        }
		ma = absDir.z;
    }

 	// === 2. 计算 UV 坐标 (映射到 0-1) ===
	// sc.y = -sc.y;
	vec2 uv = sc / ma * 0.5 + 0.5;
	uv.y = 1.0f - uv.y;

	return SamplerAtlasMap(uv, atlasMap, atlasSize, subStart[faceIndex], subSize[faceIndex]);
}

float SamplerAtlasMapWithCompare(vec2 subTexPos, sampler2D atlasMap, vec2 atlasSize, vec2 subStart, vec2 subSize, float refDepth)
{
	return SamplerAtlasMap(subTexPos, atlasMap, atlasSize, subStart, subSize) < refDepth ? 0.f : 1.f;
}

float SamplerAtlasCubeMapWithCompare(vec3 dir, sampler2D atlasMap, vec2 atlasSize, vec2 subStart[6], vec2 subSize[6], float refDepth)
{
	return SamplerAtlasCubeMap(dir, atlasMap, atlasSize, subStart, subSize) < refDepth ? 0.f : 1.f;
}

vec3 NormalBias(vec3 fragPos, vec3 lightDir, vec3 normal, float biasFactor)
{
	float bias = biasFactor * (1.0 - dot(normalize(normal), lightDir));
	vec3 shiftedPos = fragPos + normal * bias;
	return shiftedPos;
}

float DirLightShadowCalculation(vec4 fragPosLightSpace, sampler2D atlasMap, vec2 subStart, vec2 subSize)
{
	vec2 texelSize = 1.0 / subSize;
	vec2 atlasSize = 1.0 / textureSize(atlasMap, 0);

    vec3 projCoords = fragPosLightSpace.xyz / fragPosLightSpace.w;
    float currentDepth = projCoords.z;
	currentDepth = clamp(currentDepth, 0.0, 1.0);
	
    projCoords = projCoords * 0.5 + 0.5;

	if(currentDepth >= 1.0)
        return 0.0;

	float shadow = 0.0;
	for(int x = -1; x <= 1; ++x)
	{
		for(int y = -1; y <= 1; ++y)
		{
			float temp = 1.0 - SamplerAtlasMapWithCompare(projCoords.xy + vec2(x, y) * texelSize, atlasMap, atlasSize, subStart, subSize, currentDepth);  
			shadow += temp;
		}    
	}
	shadow /= 9.0;

    return shadow;
}

float DirLightFastShadowCalculation(vec4 fragPosLightSpace, sampler2D atlasMap, vec2 subStart, vec2 subSize)
{
	vec2 texelSize = 1.0 / subSize;
	vec2 atlasSize = 1.0 / textureSize(atlasMap, 0);

    vec3 projCoords = fragPosLightSpace.xyz / fragPosLightSpace.w;
    float currentDepth = projCoords.z;
	currentDepth = clamp(currentDepth, 0.0, 1.0);
	
    projCoords = projCoords * 0.5 + 0.5;

	if(currentDepth >= 1.0)
        return 0.0;

	return 1.0 - SamplerAtlasMapWithCompare(projCoords.xy, atlasMap, atlasSize, subStart, subSize, currentDepth); 
}


// 3×3 PCF：在接收点处垂直于光线的平面上按一个 texel 的世界尺寸偏移，每个采样按自己落到的面算参考深度。
// 深度偏移已经由硬件斜率偏移写进阴影图，这里不再减偏移
float PointLightShadowCalculation(vec3 fragPos, vec3 lightPos, sampler2D atlasMap, vec2 subStart[6], vec2 subSize[6], float radius)
{
	vec3 lightToFrag = fragPos - lightPos;
	float dist = length(lightToFrag);
	if (dist <= 1e-4)
		return 0.0;

	vec2 atlasSize = 1.0 / textureSize(atlasMap, 0);

	vec3 L = lightToFrag / dist;
	vec3 helperAxis = abs(L.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
	vec3 T = normalize(cross(helperAxis, L));
	vec3 B = cross(L, T);

	vec3 a = abs(lightToFrag);
	float axisDistance = max(a.x, max(a.y, a.z));
	float texelWorld = 2.0 * axisDistance / max(subSize[0].x, 1.0);

	float lit = 0.0;
	for (int x = -1; x <= 1; ++x)
	{
		for (int y = -1; y <= 1; ++y)
		{
			vec3 sampleDir = lightToFrag + (float(x) * T + float(y) * B) * texelWorld;
			float refDepth = PointShadowRefDepth(sampleDir, lightToFrag, radius);
			lit += SamplerAtlasCubeMapWithCompare(sampleDir, atlasMap, atlasSize, subStart, subSize, refDepth);
		}
	}
	return 1.0 - lit / 9.0;
}

float PointLightFastShadowCalculation(vec3 fragPos, vec3 lightPos, sampler2D atlasMap, vec2 subStart[6], vec2 subSize[6], float radius)
{
	vec3 lightToFrag = fragPos - lightPos;
	vec2 atlasSize = 1.0 / textureSize(atlasMap, 0);
	float refDepth = PointShadowRefDepth(lightToFrag, lightToFrag, radius);
	return 1.0 - SamplerAtlasCubeMapWithCompare(lightToFrag, atlasMap, atlasSize, subStart, subSize, refDepth);
}

vec3 CalcDirLightWithoutShadow(DirLight light, vec3 normal, vec3 viewDir, PBRProperties prop)
{
	vec3 radiance = light.color * light.luxIntensity;

	float NdotL;
	vec3 diffuse = vec3(0.0);
	vec3 specular = vec3(0.0);

	CalcBDRF(normal, -viewDir, -light.direction, prop.albedo, prop.metallic, prop.roughness, NdotL, diffuse, specular);

	vec3 Lo = diffuse + specular;
	vec3 lightingColor = Lo * radiance * NdotL;

	vec3 result = lightingColor;

#ifdef Virtual_Ambient_Enable
		vec3 ambient = vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
		result = max(result, ambient);
#endif

	return result;
}

vec3 CalcPointLightWithoutShadow(PointLight light, vec3 normal, vec3 fragPos, vec3 viewDir, PBRProperties prop)
{
	float dist = length(light.position - fragPos);
    if(dist >= light.radius)
		return vec3(0.f);

	float linera_radius = light.radius * linera_radius_factor;
    float attenuation = dist <= linera_radius ?
						1.0 / (dist * dist + 1) 
						: mix(1.0 / (linera_radius_factor2 * light.radius * light.radius + 1), 0.0, (dist - linera_radius) / (one_minus_linera_radius_factor * light.radius));
    vec3 radiance = light.color * light.cdIntensity * attenuation;

	float NdotL;
	vec3 diffuse = vec3(0.0);
	vec3 specular = vec3(0.0);

	CalcBDRF(normal, -viewDir,  normalize(light.position - fragPos), prop.albedo, prop.metallic, prop.roughness, NdotL, diffuse, specular);

	vec3 Lo = diffuse + specular;	
	vec3 lightingColor = Lo * radiance * NdotL;

	vec3 result = lightingColor;

#ifdef Virtual_Ambient_Enable
		vec3 ambient = vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
		result = max(result, ambient);
#endif

	return result;
}

vec3 CalcSpotLightWithoutShadow(SpotLight light, vec3 normal, vec3 fragPos, vec3 viewDir, PBRProperties prop)
{
    
	float dist = length(light.position - fragPos);
    if(dist >= light.radius)
		return vec3(0.f);

	float intensity = 1.0f;
	float outerCutOff = min(light.cutOff ,light.outerCutOff);
	vec3 lightDir = normalize(fragPos - light.position);

	float theta = dot(lightDir, normalize(light.direction));
	if(theta < outerCutOff)
	{
		return vec3(0.f);
	}
	else if (theta < light.cutOff)
	{
		float epsilon  = light.cutOff - outerCutOff;
		intensity = clamp((theta - outerCutOff) / epsilon, 0.0f, 1.0f); 
	}

  	float linera_radius = light.radius * linera_radius_factor;
    float attenuation = dist <= linera_radius ?
						1.0 / (dist * dist + 1) 
						: mix(1.0 / (linera_radius_factor2 * light.radius * light.radius + 1), 0.0, (dist - linera_radius) / (one_minus_linera_radius_factor * light.radius));
	vec3 radiance = light.color * light.cdIntensity * attenuation;

	float NdotL;
	vec3 diffuse = vec3(0.0);
	vec3 specular = vec3(0.0);

	CalcBDRF(normal, -viewDir,  normalize(light.position - fragPos), prop.albedo, prop.metallic, prop.roughness, NdotL, diffuse, specular);

	vec3 Lo = diffuse + specular;
	vec3 lightingColor = Lo * radiance * NdotL;

	vec3 result = lightingColor * intensity;              
	
#ifdef Virtual_Ambient_Enable
		vec3 ambient = vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
		result = max(result, ambient);
#endif 

	return result;
}


vec3 CalcDirLight(DirLight light, sampler2D atlasMap, vec3 normal, vec3 geoNormal, vec3 fragPos, mat4 cameraView ,vec3 viewDir, PBRProperties prop)
{
	float shadow = 0.f;
	if (light.castShadow)
	{
		// 选级联、阴影距离渐隐用接收点的原始位置；法线偏移量取决于选中级联的 texel 尺寸，所以放在选级联之后
		vec4 fragPosViewSpace = cameraView * vec4(fragPos, 1.0f);
		float shadowFade = DirLightShadowDistanceFade(light, abs(fragPosViewSpace.z));
		if (shadowFade > 0.0)
		{
			DirLightCascade cascade = GetCascade(fragPosViewSpace, light.cascadeFirst, light.cascadeCount);
			vec2 subSize = vec2(cascade.atlasWidth, cascade.atlasHeight);
			float texelWorld = ShadowTexelWorldSize(cascade.lightSpaceMatrix, fragPos, subSize.x);
			vec3 shiftedPos = fragPos + ShadowNormalOffset(geoNormal, -normalize(light.direction), texelWorld, light.shadowNormalBias);
			vec4 fragPosLightSpace = cascade.lightSpaceMatrix * vec4(shiftedPos, 1.0);
			shadow = DirLightShadowCalculation(fragPosLightSpace, atlasMap, vec2(cascade.atlasX, cascade.atlasY), subSize);
			shadow = clamp(shadow, 0.f, 1.f) * shadowFade;
		}
	}

	vec3 radiance = light.color * light.luxIntensity;
	if (shadow >= 1.0f)
	{
#ifdef Virtual_Ambient_Enable
		return vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
#else
		return vec3(0.f);
#endif 
	}

	float NdotL;
	vec3 diffuse = vec3(0.0);
	vec3 specular = vec3(0.0);

	CalcBDRF(normal, -viewDir, -light.direction, prop.albedo, prop.metallic, prop.roughness, NdotL, diffuse, specular);

	vec3 Lo = diffuse + specular;
	vec3 lightingColor = Lo * radiance * NdotL;

	vec3 result = (1.0 - shadow) * lightingColor;

#ifdef Virtual_Ambient_Enable
		vec3 ambient = vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
		result = max(result, ambient);
#endif

	return result;
}

vec3 CalcPointLight(PointLight light, sampler2D atlasMap, vec3 normal, vec3 geoNormal, vec3 fragPos, vec3 viewDir, PBRProperties prop)
{
	float dist = length(light.position - fragPos);
    if(dist >= light.radius)
		return vec3(0.f);

	float shadow = 0.f;
	if (light.castShadow)
	{
		// cube 面是 90° 透视：接收点处一个 texel 的世界尺寸 = 2 × 接收点在该面朝向轴上的距离 / 分辨率
		vec3 a = abs(fragPos - light.position);
		float axisDistance = max(a.x, max(a.y, a.z));
		float texelWorld = 2.0 * axisDistance / max(light.atlasSize[0].x, 1.0);
		vec3 shiftedPos = fragPos + ShadowNormalOffset(geoNormal, normalize(light.position - fragPos), texelWorld, light.shadowNormalBias);
		shadow = PointLightShadowCalculation(shiftedPos, light.position, atlasMap, light.atlasStart, light.atlasSize, light.radius);
		shadow = clamp(shadow, 0.f, 1.f);
	}

#ifdef Virtual_Ambient_Enable
	float linera_radius = light.radius * linera_radius_factor;
    float attenuation = dist <= linera_radius ?
						1.0 / (dist * dist + 1) 
						: mix(1.0 / (linera_radius_factor2 * light.radius * light.radius + 1), 0.0, (dist - linera_radius) / (one_minus_linera_radius_factor * light.radius));
    vec3 radiance = light.color * light.cdIntensity * attenuation;
	if (shadow >= 1.0f)
		return vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
#else
	if (shadow >= 1.0f)
		return vec3(0.f);

	float linera_radius = light.radius * linera_radius_factor;
    float attenuation = dist <= linera_radius ?
						1.0 / (dist * dist + 1) 
						: mix(1.0 / (linera_radius_factor2 * light.radius * light.radius + 1), 0.0, (dist - linera_radius) / (one_minus_linera_radius_factor * light.radius));
    vec3 radiance = light.color * light.cdIntensity * attenuation;	
#endif 

	float NdotL;
	vec3 diffuse = vec3(0.0);
	vec3 specular = vec3(0.0);

	CalcBDRF(normal, -viewDir,  normalize(light.position - fragPos), prop.albedo, prop.metallic, prop.roughness, NdotL, diffuse, specular);

	vec3 Lo = diffuse + specular;	
	vec3 lightingColor = Lo * radiance * NdotL;

	vec3 result = (1.0 - shadow) * lightingColor;

#ifdef Virtual_Ambient_Enable
		vec3 ambient = vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
		result = max(result, ambient);
#endif

	return result;
}

vec3 CalcSpotLight(SpotLight light, sampler2D atlasMap, vec3 normal, vec3 geoNormal, vec3 fragPos, vec3 viewDir, PBRProperties prop)
{
    
	float dist = length(light.position - fragPos);
    if(dist >= light.radius)
		return vec3(0.f);

	float intensity = 1.0f;
	float outerCutOff = min(light.cutOff ,light.outerCutOff);
	vec3 lightDir = normalize(fragPos - light.position);

	float theta = dot(lightDir, normalize(light.direction));
	if(theta < outerCutOff)
	{
		return vec3(0.f);
	}
	else if (theta < light.cutOff)
	{
		float epsilon  = light.cutOff - outerCutOff;
		intensity = clamp((theta - outerCutOff) / epsilon, 0.0f, 1.0f); 
	}

	float shadow = 0.f;
	if (light.castShadow)
	{
		// 透视投影：texel 世界尺寸随到光源的视深线性变大。lightDir 是光源指向接收点，所以朝光方向是 -lightDir
		vec2 subSize = vec2(light.atlasWidth, light.atlasHeight);
		float texelWorld = ShadowTexelWorldSize(light.lightSpaceMatrix, fragPos, subSize.x);
		vec3 shiftedPos = fragPos + ShadowNormalOffset(geoNormal, -lightDir, texelWorld, light.shadowNormalBias);
		vec4 fragPosLightSpace = light.lightSpaceMatrix * vec4(shiftedPos, 1.0);
		shadow = DirLightShadowCalculation(fragPosLightSpace, atlasMap, vec2(light.atlasX, light.atlasY), subSize);
		shadow = clamp(shadow, 0.f, 1.f);
	}

  	float linera_radius = light.radius * linera_radius_factor;
    float attenuation = dist <= linera_radius ?
						1.0 / (dist * dist + 1) 
						: mix(1.0 / (linera_radius_factor2 * light.radius * light.radius + 1), 0.0, (dist - linera_radius) / (one_minus_linera_radius_factor * light.radius));
	vec3 radiance = light.color * light.cdIntensity * attenuation;
	if (shadow >= 1.0f)
	{
#ifdef Virtual_Ambient_Enable
		return vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
#else
		return vec3(0.f);
#endif 
	}

	float NdotL;
	vec3 diffuse = vec3(0.0);
	vec3 specular = vec3(0.0);

	CalcBDRF(normal, -viewDir,  normalize(light.position - fragPos), prop.albedo, prop.metallic, prop.roughness, NdotL, diffuse, specular);

	vec3 Lo = diffuse + specular;
	vec3 lightingColor = Lo * radiance * NdotL;

	vec3 result = (1.0 - shadow) * lightingColor * intensity;              
	
#ifdef Virtual_Ambient_Enable
		vec3 ambient = vec3(0.015) * radiance * prop.albedo * prop.ambientOcclusion;
		result = max(result, ambient);
#endif 

	return result;
}
#endif 

// IBL 拆成漫反射 / 镜面两项（都已乘 AO），供只需要其中一项的调用方使用（如 DDGI 接管漫反射时）
void CalculateIBLLightingSplit(vec3 viewDir, vec3 normal, PBRProperties prop, samplerCube IBLDiffuse, samplerCube IBLPrefilter, sampler2D IBLBrdfLUT,
    out vec3 outDiffuse, out vec3 outSpecular)
{
    vec3 diffuse;
 	CalcBDRFDiffuse(prop.albedo, prop.metallic, diffuse);
    vec3 irradiance = texture(IBLDiffuse, normal).rgb;
    vec3 diffuseColor = irradiance * diffuse;

    vec3 reflectionDir = reflect(viewDir, normal);
    float prefilterMipLevel = prop.roughness * float(textureQueryLevels(IBLPrefilter) - 1);    

    vec3 prefilteredColor = textureLod(IBLPrefilter, reflectionDir, prefilterMipLevel).rgb;

	vec3 F0 = mix(vec3(0.02), prop.albedo, prop.metallic);
    
	float NdotV = max(dot(normal, -viewDir), 0.0);
    vec2 values = texture(IBLBrdfLUT, vec2(NdotV, prop.roughness)).xy;
    float A = values.x;
    float B = values.y;
    vec3 brdf = F0 * A + B;

    vec3 specColor = prefilteredColor * brdf;

    outDiffuse = diffuseColor * prop.ambientOcclusion;
    outSpecular = specColor * prop.ambientOcclusion;
}

vec3 CalculateIBLLighting(vec3 viewDir, vec3 normal, PBRProperties prop, samplerCube IBLDiffuse, samplerCube IBLPrefilter, sampler2D IBLBrdfLUT)
{
    vec3 diffuseColor, specColor;
    CalculateIBLLightingSplit(viewDir, normal, prop, IBLDiffuse, IBLPrefilter, IBLBrdfLUT, diffuseColor, specColor);
    return diffuseColor + specColor;
}
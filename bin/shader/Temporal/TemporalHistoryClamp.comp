#version 450 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in;

// 时域累积的历史裁剪（ReLAX 的 history clamping，TemporalAccumulate.comp 之后执行）：
//   盒子 = 本帧快速历史（只累积几帧）在 3×3 邻域里的 YCoCg 均值 ± γ·σ。快速历史已经平均过几帧，σ 主要是真实的空间变化，
//   不再是单帧噪声：不会满屏随机裁剪；色块边缘处盒子跨两侧会变宽（少裁，不闪）。
//   累积结果超出盒子时裁到盒子上；超出越多历史长度越往快速历史的帧数缩（anti-lag），变化后几帧内重新收敛。
// 只改累积结果的 rgb 和矩里的历史长度（alpha 里的命中距离不动），之后才写回历史 / 做空域滤波。

layout (push_constant) uniform Param {
    float clampGamma;           // <= 0：不裁剪
    float antilagStrength;      // 超出盒子时缩短历史的力度，0 = 只裁不缩
    float fastFrames;           // 快速历史的帧数（历史最多缩到这么短）
    uint debugMode;             // Scene3DRenderOption::DenoiseDebugMode，1 = 历史长度，3 = 裁剪量
    float maxLength;            // 历史长度视图的归一化上限（maxAccumulateCount）
};

layout (binding = 1, rgba16f) uniform image2D accumColor;      // 时域累积结果（读写）
layout (binding = 2, rgba16f) uniform image2D accumMoments;    // 时域矩（读写），w = 历史长度
layout (binding = 3) uniform sampler2D fastHistory;            // 本帧快速历史
layout (binding = 4) uniform sampler2D depthMap;
layout (binding = 5, rgba16f) uniform image2D debugImage;

const uint kDebugHistoryLength = 1u;
const uint kDebugClipAmount = 3u;
const float kSkyDepth = 0.99994;

vec3 RGBToYCoCg(vec3 c)
{
    return vec3(
         0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
         0.5  * c.r             - 0.5  * c.b,
        -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 YCoCgToRGB(vec3 c)
{
    float tmp = c.x - c.z;
    return vec3(tmp + c.y, c.x + c.z, tmp - c.y);
}

// 沿 history → center 方向裁剪到以 center 为中心、半径 extent 的 AABB 上
vec3 ClipToAABB(vec3 history, vec3 center, vec3 extent)
{
    vec3 d = history - center;
    vec3 unit = abs(d) / max(extent, vec3(1e-5));
    float m = max(unit.x, max(unit.y, unit.z));
    return m > 1.0 ? center + d / m : history;
}

// 0 → 黑；(0, 1] → 蓝 → 青 → 绿 → 黄 → 红
vec3 DebugHeat(float t)
{
    if (t <= 0.0)
        return vec3(0.0);
    t = clamp(t, 0.0, 1.0);
    return clamp(vec3(1.5) - abs(4.0 * t - vec3(3.0, 2.0, 1.0)), 0.0, 1.0);
}

void StoreClipDebug(ivec2 coord, vec3 color)
{
    if (debugMode == kDebugClipAmount)
        imageStore(debugImage, coord, vec4(color, 1.0));
}

// 历史长度视图：anti-lag 之后、真正写回历史的长度。黑 = 没有历史
void StoreLengthDebug(ivec2 coord, float historyLength)
{
    if (debugMode != kDebugHistoryLength)
        return;
    float maxL = max(maxLength, 2.0);
    vec3 c = historyLength <= 1.0 ? vec3(0.0) : DebugHeat((historyLength - 1.0) / (maxL - 1.0));
    imageStore(debugImage, coord, vec4(c, 1.0));
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(accumColor);
    if (any(greaterThanEqual(coord, size)))
        return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    if (textureLod(depthMap, uv, 0.0).r >= kSkyDepth)
    {
        StoreClipDebug(coord, vec3(0.0));
        StoreLengthDebug(coord, 0.0);
        return;
    }

    vec4 moments = imageLoad(accumMoments, coord);
    float historyLength = moments.w;
    // 这一帧没有历史（刚被重置）：没什么可裁的
    if (clampGamma <= 0.0 || historyLength <= 1.0)
    {
        StoreClipDebug(coord, historyLength <= 1.0 ? vec3(0.0) : vec3(0.06));
        StoreLengthDebug(coord, historyLength);
        return;
    }

    // 快速历史 3×3 统计（YCoCg），跳过天空
    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    float count = 0.0;
    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            ivec2 c = clamp(coord + ivec2(x, y), ivec2(0), size - 1);
            if (textureLod(depthMap, (vec2(c) + 0.5) / vec2(size), 0.0).r >= kSkyDepth)
                continue;
            vec3 f = RGBToYCoCg(texelFetch(fastHistory, c, 0).rgb);
            m1 += f;
            m2 += f * f;
            count += 1.0;
        }
    }
    m1 /= count;
    m2 /= count;
    vec3 sigma = sqrt(max(m2 - m1 * m1, vec3(0.0)));
    // 下限：平坦区域（σ≈0）不至于把盒子压成一个点
    vec3 extent = max(clampGamma * sigma, vec3(0.01 * max(m1.x, 0.0) + 1e-4));

    vec4 color = imageLoad(accumColor, coord);
    vec3 accum = RGBToYCoCg(color.rgb);
    vec3 unit = abs(accum - m1) / extent;
    float d = max(unit.x, max(unit.y, unit.z));      // 离盒子中心多少个半径（> 1 才裁）

    if (d > 1.0)
    {
        color.rgb = max(YCoCgToRGB(ClipToAABB(accum, m1, extent)), vec3(0.0));
        imageStore(accumColor, coord, color);

        // anti-lag：超出 1.5 → 3.5 个半径，历史长度从原值平滑缩到快速历史的帧数。
        // 刚超出一点（噪声、亮点）只裁不缩，否则光滑表面上的历史被反复砍短，一直闪
        float lag = clamp((d - 1.5) * 0.5 * antilagStrength, 0.0, 1.0);
        moments.w = mix(historyLength, min(historyLength, max(fastFrames, 1.0)), lag);
        imageStore(accumMoments, coord, moments);
    }

    StoreClipDebug(coord, d <= 1.0 ? vec3(0.06) : DebugHeat((d - 1.0) / 3.0));
    StoreLengthDebug(coord, moments.w);
}

#version 450 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in;

#include "shader/dataDef/camerauboDef.comp"

layout(binding = 0) uniform Params
{
    uint historyValid;
    float historyWeight;
    float motionWeightScale;
    float depthThreshold;
    float normalThreshold;
};

layout(binding = 1, rgba16f) uniform image2D outputColor;
layout(binding = 2) uniform sampler2D currentColorTexture;
layout(binding = 3) uniform sampler2D historyColorTexture;
layout(binding = 4) uniform sampler2D currentDepthTexture;
layout(binding = 5) uniform sampler2D currentNormalTexture;
layout(binding = 6) uniform sampler2D motionVectorTexture;
layout(binding = 7) uniform sampler2D previousDepthTexture;
layout(binding = 8) uniform sampler2D previousNormalTexture;

vec3 RGBToYCoCg(vec3 color)
{
    float co = color.r - color.b;
    float temp = color.b + co * 0.5;
    float cg = color.g - temp;
    float y = temp + cg * 0.5;
    return vec3(y, co, cg);
}

vec3 YCoCgToRGB(vec3 color)
{
    float temp = color.x - color.z * 0.5;
    float g = color.z + temp;
    float b = temp - color.y * 0.5;
    float r = b + color.y;
    return vec3(r, g, b);
}

float LinearDepth(float depth)
{
    return camera.farPlane * camera.nearPlane /
        (camera.farPlane - depth * (camera.farPlane - camera.nearPlane));
}

vec2 ReprojectSky(vec2 uv)
{
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 viewPoint = camera.invProjection * vec4(ndc, 1.0, 1.0);
    vec3 viewDir = normalize(viewPoint.xyz / viewPoint.w);
    vec3 worldDir = normalize(mat3(camera.invView) * viewDir);
    vec4 previousClip = prevcamera.projView * vec4(prevcamera.position + worldDir * camera.farPlane, 1.0);
    if (previousClip.w <= 0.0)
        return vec2(-1.0);
    return previousClip.xy / previousClip.w * 0.5 + 0.5;
}

void StoreCurrent(ivec2 coord, vec4 color)
{
    imageStore(outputColor, coord, color);
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputColor);
    if (any(greaterThanEqual(coord, size)))
        return;

    vec2 currentUV = (vec2(coord) + 0.5) / vec2(size);
    vec4 currentColor = texelFetch(currentColorTexture, coord, 0);
    if (historyValid == 0)
    {
        StoreCurrent(coord, currentColor);
        return;
    }

    float currentDepth = texelFetch(currentDepthTexture, coord, 0).r;
    bool isSky = currentDepth >= 0.99994;
    vec2 motion = texelFetch(motionVectorTexture, coord, 0).xy;
    vec2 historyUV = isSky ? ReprojectSky(currentUV) : currentUV - motion;
    if (any(lessThanEqual(historyUV, vec2(0.0))) || any(greaterThanEqual(historyUV, vec2(1.0))))
    {
        StoreCurrent(coord, currentColor);
        return;
    }

    float previousDepth = texture(previousDepthTexture, historyUV).r;
    bool historyValidAtPixel = false;
    if (isSky)
    {
        historyValidAtPixel = previousDepth >= 0.99994;
    }
    else if (previousDepth < 0.99994)
    {
        vec3 currentNormal = normalize(texelFetch(currentNormalTexture, coord, 0).xyz);
        vec3 previousNormal = normalize(texture(previousNormalTexture, historyUV).xyz);
        float currentLinearDepth = LinearDepth(currentDepth);
        float previousLinearDepth = LinearDepth(previousDepth);
        float relativeDepthError = abs(currentLinearDepth - previousLinearDepth) /
            max(max(currentLinearDepth, previousLinearDepth), 1.0);
        historyValidAtPixel = dot(currentNormal, previousNormal) >= normalThreshold
            && relativeDepthError <= depthThreshold;
    }

    if (!historyValidAtPixel)
    {
        StoreCurrent(coord, currentColor);
        return;
    }

    vec3 neighborhoodMin = vec3(3.402823e+38);
    vec3 neighborhoodMax = vec3(-3.402823e+38);
    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            ivec2 sampleCoord = clamp(coord + ivec2(x, y), ivec2(0), size - 1);
            vec3 sampleColor = RGBToYCoCg(texelFetch(currentColorTexture, sampleCoord, 0).rgb);
            neighborhoodMin = min(neighborhoodMin, sampleColor);
            neighborhoodMax = max(neighborhoodMax, sampleColor);
        }
    }

    vec4 historyColor = texture(historyColorTexture, historyUV);
    vec3 clippedHistory = YCoCgToRGB(clamp(RGBToYCoCg(historyColor.rgb), neighborhoodMin, neighborhoodMax));
    float motionPixels = length(motion * vec2(size));
    float historyBlend = clamp(historyWeight, 0.0, 0.99) * exp(-max(motionWeightScale, 0.0) * motionPixels);
    StoreCurrent(coord, vec4(mix(currentColor.rgb, clippedHistory, historyBlend), currentColor.a));
}

#version 450 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif


layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in; 

#include "shader/dataDef/camerauboDef.comp"

layout (binding = 0) uniform Params
{
    float historyWeight;
	float motionWeightScale;
    float depthThreshold;
    float positiondistThreshold;
    float normalThreshold;
};    

layout (binding = 1, rgba16f) uniform image2D outputImage;
layout (binding = 2) uniform sampler2D rawTexture;
layout (binding = 3) uniform sampler2D historyColorTexture;
layout (binding = 4) uniform sampler2D positionMap;
layout (binding = 5) uniform sampler2D normalMap;
layout (binding = 6) uniform sampler2D depthMap;
layout (binding = 7) uniform sampler2D motionMap;
layout (binding = 8) uniform sampler2D prevPositionMap;
layout (binding = 9) uniform sampler2D prevNormalMap;
layout (binding = 10) uniform sampler2D prevDepthMap;


float DepthBufferConvertToViewDepth(float depth)
{
    return camera.farPlane * camera.nearPlane / (camera.farPlane - depth * (camera.farPlane - camera.nearPlane));
}

void GetDepthNormal(vec2 uv, inout float depth, inout vec3 normal)
{    
    depth = texture(depthMap, uv).r;
    normal = normalize(texture(normalMap, uv).rgb);
}

bool IsSky(float depth)
{
    return depth >= 0.99994;
}

void main() 
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outputImage);

    if (any(greaterThanEqual(coord, imageSize)))
        return;

    vec2 currentUV = (vec2(coord) + vec2(0.5f)) / imageSize;
    vec4 currentColor = texture(rawTexture, currentUV).rgba;

    vec2 motionVector = clamp(texture(motionMap, currentUV).xy, -1, 1);
    vec2 historyUV = currentUV - motionVector;

    // 边界检查（如果上一帧没这个像素，直接返回当前帧）
    if (any(lessThanEqual(historyUV, vec2(0.0))) || any(greaterThanEqual(historyUV, vec2(1.0))))
    {
        imageStore(outputImage, coord, currentColor);
        return;
    }

    float currentDepth = texture(depthMap, currentUV).r;
    float historyDepth = texture(prevDepthMap, historyUV).r;

    bool currentIsSky = IsSky(currentDepth);
    bool historyIsSky = IsSky(historyDepth);

    if (currentIsSky != historyIsSky)
    {
        imageStore(outputImage, coord, currentColor);
        return;
    }

    bool historyValid = false;

    if (currentIsSky)
    {
        historyValid = true;
    }
    else 
    {
        vec3 currentNormal = texture(normalMap, currentUV).xyz;
        vec3 currentWorldPos = texture(positionMap, currentUV).xyz;

        vec3 historyNormal = texture(prevNormalMap, historyUV).xyz;
        vec3 historyWorldPos = texture(prevPositionMap, historyUV).xyz;

        float currentLinearDepth = DepthBufferConvertToViewDepth(currentDepth);
        float historyLinearDepth = DepthBufferConvertToViewDepth(historyDepth);

        float normalSimilarity = dot(currentNormal, historyNormal);
        bool normalValid = normalSimilarity > normalThreshold;

        float depthDiff = abs(currentLinearDepth - historyLinearDepth); 
        bool depthValid = depthDiff < depthThreshold;

        vec3 d = currentWorldPos - historyWorldPos;
        float positionDiff2 = dot(d, d);
        bool positionValid = positionDiff2 < positiondistThreshold * positiondistThreshold;

        historyValid = normalValid && depthValid && positionValid;
    }

    if (!historyValid)
    {
        imageStore(outputImage, coord, currentColor);
        return;       
    }

    vec4 historyColor = texture(historyColorTexture, historyUV).rgba;

    // AABB 钳制（消除拖影）
    vec4 minColor = currentColor;
    vec4 maxColor = currentColor;

    // 取周围 11x11 的最小最大值
    for (int x = -5; x <= 5; x++) {
        for (int y = -5; y <= 5; y++) {
            ivec2 sampleCoord = coord + ivec2(x, y);
            sampleCoord = clamp(sampleCoord, ivec2(0), imageSize - 1);
            vec2 uv = (vec2(sampleCoord) + vec2(0.5f)) / imageSize;

            vec4 neighbor = texture(rawTexture, uv).rgba;
            minColor = min(minColor, neighbor);
            maxColor = max(maxColor, neighbor);
        }
    }
    historyColor = clamp(historyColor, minColor * 0.8, maxColor * 1.25);

    float motionPixels = length(motionVector * vec2(imageSize));
    float historyBlendFactor = clamp(historyWeight, 0.0, 0.99) * exp(-max(motionWeightScale, 0.0) * motionPixels);

    vec4 finalColor = mix(currentColor, historyColor, historyBlendFactor);

    imageStore(outputImage, coord, finalColor);
}
#version 450 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in; 

#include "shader/dataDef/camerauboDef.comp"

// SVGF 的 À-trous 小波滤波（一轮）。C++ 端：先跑一次 SVGF-Variance.comp 得到初始方差，再迭代本 shader。
// 与原实现的区别：
//   * 亮度边缘用本轮输入颜色的亮度（原来每轮都用时域 M1，噪声已被前几轮滤掉，边缘判断仍按原始噪声做）；
//   * σ_l = luminanceFactor × sqrt(3×3 高斯预滤波后的方差)，方差随颜色一起逐轮传递（权重取平方），
//     越往后方差越小、亮度边缘越严，避免后面大步长的轮次把细节抹平；
//   * B3 样条核权重 h 参与加权（原来算了 kernelWeight 却没乘进去，等于 5×5 盒式核）。
// 方差图：R32F，>= 0 为方差，-1 为天空（预滤波时跳过）。
// 镜面信号（specularMode = 1）：滤波半径按反射的模糊程度限制 —— 反射波瓣在屏幕上的尺寸
//   ≈ 波瓣半角 × 命中距离 / (视深 + 命中距离) × 视深 / 像素覆盖尺寸（虚像离相机越远、表面越光滑越小），
//   每个采样点再乘 exp(-(像素距离 / 半径)²)。光滑表面的反射基本不被空域抹糊，粗糙表面不受影响。
//   命中距离取输入的 alpha（时域累积后的命中距离）。

const float h[5] = float[](
    1.0 / 16.0,
    1.0 / 4.0,
    3.0 / 8.0,
    1.0 / 4.0,
    1.0 / 16.0
);

layout (binding = 0) uniform Params
{
    float normalFactor;
    float depthFactor;
    float luminanceFactor;     // σ_l，SVGF 推荐 4。是方差标准差的倍数，不是绝对亮度
    uint specularMode;         // 1 = 镜面信号：按粗糙度 / 命中距离限制滤波半径
    float specularRadiusScale; // 镜面信号的半径倍数（越大越糊、越干净）
};

layout (binding = 1, rgba16f) uniform image2D curPassImage;
layout (binding = 2) uniform sampler2D lastPassImage;
layout (binding = 3) uniform sampler2D gNormal;
layout (binding = 4) uniform sampler2D depthMap;
layout (binding = 5) uniform sampler2D momentTexture;     // 不再使用（方差改由 binding 6 逐轮传递），保留绑定
layout (binding = 6) uniform sampler2D varianceIn;
layout (binding = 7, r32f) uniform image2D varianceOut;
layout (binding = 8) uniform sampler2D metallicRoughnessMap;    // 只在 specularMode = 1 时读（.g = 粗糙度）

layout (push_constant) uniform Param{
    int curPassIndex;
};

const float kSkyDepth = 0.99994;

float DepthBufferConvertToViewDepth(float depth)
{
    return camera.farPlane * camera.nearPlane / (camera.farPlane - depth * (camera.farPlane - camera.nearPlane));
}

float GetLuminance(vec3 color)
{
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

// 线性深度对「输出图像素」的梯度：在输出图 UV 上前后各偏一个输出像素采样，
// 与按输出像素计的偏移同一单位，深度图（全分辨率）与输出图（RT 为 2/3）分辨率无关。
vec2 GetDepthGradient(vec2 uvCenter, vec2 outputTexel)
{
    vec2 uvL = clamp(uvCenter - vec2(outputTexel.x, 0.0), vec2(0.0), vec2(1.0));
    vec2 uvR = clamp(uvCenter + vec2(outputTexel.x, 0.0), vec2(0.0), vec2(1.0));
    vec2 uvT = clamp(uvCenter - vec2(0.0, outputTexel.y), vec2(0.0), vec2(1.0));
    vec2 uvB = clamp(uvCenter + vec2(0.0, outputTexel.y), vec2(0.0), vec2(1.0));

    float zL = DepthBufferConvertToViewDepth(textureLod(depthMap, uvL, 0.0).r);
    float zR = DepthBufferConvertToViewDepth(textureLod(depthMap, uvR, 0.0).r);
    float zT = DepthBufferConvertToViewDepth(textureLod(depthMap, uvT, 0.0).r);
    float zB = DepthBufferConvertToViewDepth(textureLod(depthMap, uvB, 0.0).r);

    return vec2(zR - zL, zB - zT) * 0.5;
}

// 法线 / 深度的边缘权重（方差估计与 À-trous 共用）
float GeometryWeight(vec3 centerNormal, float centerZ, vec2 depthGradient, float depthEpsilon,
                     vec3 sampleNormal, float sampleZ, vec2 offsetPixels)
{
    float normalWeight = pow(max(dot(centerNormal, sampleNormal), 0.0), normalFactor);
    float depthWeight = exp(-abs(centerZ - sampleZ) / (depthFactor * abs(dot(depthGradient, offsetPixels)) + depthEpsilon));
    return normalWeight * depthWeight;
}

float FilteredVariance(ivec2 coord, ivec2 size)
{
    // 3×3 高斯：中心 1/4，边 1/8，角 1/16
    float sum = 0.0;
    float wsum = 0.0;
    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            float v = texelFetch(varianceIn, clamp(coord + ivec2(x, y), ivec2(0), size - 1), 0).r;
            if (v < 0.0)
                continue;
            float k = (x == 0 ? 0.5 : 0.25) * (y == 0 ? 0.5 : 0.25);
            sum += v * k;
            wsum += k;
        }
    }
    return wsum > 0.0 ? sum / wsum : 0.0;
}

void main() 
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(curPassImage);

    if (coord.x >= imageSize.x || coord.y >= imageSize.y)
        return;

    vec2 texel = 1.0 / vec2(imageSize);
    vec2 uvCenter = (vec2(coord) + vec2(0.5f)) * texel;

    float centerDepth = textureLod(depthMap, uvCenter, 0.0).r;
    if (centerDepth >= kSkyDepth)
    {
        imageStore(varianceOut, coord, vec4(-1.0));
        return;
    }

    vec3 centerNormal = normalize(textureLod(gNormal, uvCenter, 0.0).rgb);
    float centerZ = DepthBufferConvertToViewDepth(centerDepth);
    vec2 depthGradient = GetDepthGradient(uvCenter, texel);
    // 正对相机的平面梯度≈0，深度缓冲的量化误差就足以把权重压成 0，加一个随视深的小下限（0.1%）
    float depthEpsilon = max(centerZ * 1e-3, 1e-4);

    vec4 centerColor = textureLod(lastPassImage, uvCenter, 0.0);
    float centerLuminance = GetLuminance(centerColor.rgb);
    float centerVariance = max(texelFetch(varianceIn, coord, 0).r, 0.0);
    float sigmaL = luminanceFactor * sqrt(FilteredVariance(coord, imageSize) + 1e-10) + 1e-6;

    // 镜面信号：反射在屏幕上的模糊半径（像素）。没打中物体（命中距离 = tMax）时退化为波瓣半角 / 像素视角
    float specularRadius = 1e6;
    if (specularMode != 0u)
    {
        float roughness = clamp(textureLod(metallicRoughnessMap, uvCenter, 0.0).g, 0.0, 1.0);
        float alpha = roughness * roughness;
        float lobeTan = alpha * 1.73;   // GGX 约 75% 能量的半角
        float hitDist = max(centerColor.a, 0.0);
        float pixelWorld = 2.0 * centerZ / max(abs(camera.projection[1][1]) * float(imageSize.y), 1e-6);
        specularRadius = max(specularRadiusScale * lobeTan * hitDist / (centerZ + hitDist + 1e-4) * centerZ / max(pixelWorld, 1e-6), 1.0);
    }

    vec4 total = vec4(0.0);
    float totalWeight = 0.0;
    float totalVariance = 0.0;

    // Atrous 核心
    int curStep = 1 << curPassIndex;

    for (int y = -2; y <= 2; y++) 
    {
        for (int x = -2; x <= 2; x++) 
        {
            ivec2 stepCoord = ivec2(x, y) * curStep;
            ivec2 sampleCoord = clamp(coord + stepCoord, ivec2(0), imageSize - 1);
            vec2 uv = (vec2(sampleCoord) + vec2(0.5f)) * texel;

            float sampleDepth = textureLod(depthMap, uv, 0.0).r;
            if (sampleDepth >= kSkyDepth)
                continue;

            vec3 sampleNormal = normalize(textureLod(gNormal, uv, 0.0).rgb);
            float sampleZ = DepthBufferConvertToViewDepth(sampleDepth);
            vec4 sampleColor = textureLod(lastPassImage, uv, 0.0);
            float sampleVariance = max(texelFetch(varianceIn, sampleCoord, 0).r, 0.0);

            float kernelWeight = h[x + 2] * h[y + 2];
            float geometryWeight = GeometryWeight(centerNormal, centerZ, depthGradient, depthEpsilon,
                                                  sampleNormal, sampleZ, vec2(stepCoord));
            float luminanceWeight = exp(-abs(centerLuminance - GetLuminance(sampleColor.rgb)) / sigmaL);

            float weight = kernelWeight * geometryWeight * luminanceWeight;
            if (specularMode != 0u && (x != 0 || y != 0))
            {
                float r = length(vec2(stepCoord)) / specularRadius;
                weight *= exp(-r * r);
            }

            total += sampleColor * weight;
            totalVariance += sampleVariance * weight * weight;
            totalWeight += weight;
        }
    }

    vec4 result = centerColor;
    float resultVariance = centerVariance;
    if (totalWeight > 1e-6)
    {
        result = total / totalWeight;
        resultVariance = totalVariance / (totalWeight * totalWeight);
    }

    imageStore(curPassImage, coord, result);
    imageStore(varianceOut, coord, vec4(resultVariance));
}

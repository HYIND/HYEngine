vec2 getRandom(int sampleIndex) 
{
    uint seed = uint(gl_GlobalInvocationID.x) * 197u 
            + uint(gl_GlobalInvocationID.y) * 927u 
            + uint(sampleIndex) * 269u 
            + uint(frameIndex) * 777u;
    return pcg_float2(seed);
}

// 生成随机方向（法线半球）
vec3 sampleHemisphere(vec3 normal, vec2 random)
{
    float r1 = random.x;
    float r2 = random.y;
    
    // 余弦加权采样
    float cosTheta = sqrt(r1);
    float theta = acos(cosTheta);
    float phi = 2.0 * PI * r2;
    
    vec3 dir = vec3(
        sin(theta) * cos(phi),
        sin(theta) * sin(phi),
        cos(theta)
    );
    
    // 将局部坐标转到世界空间（以法线为Z轴）
    vec3 up = abs(normal.y) < 0.999 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);

    vec3 samplerDir = normalize(tangent * dir.x + bitangent * dir.y + normal * dir.z);

    return samplerDir;
}

float calculateOpacity(MaterialData material, vec2 uv)
{
	if (material.alphamode == 0)
		return material.opacity;

	float opacity = material.opacity;
	if (material.texture_opacity_count > 0)
		opacity *= texture(material.texture_opacity, uv).r;
	else 
		opacity *= texture(material.texture_albedo, uv).a;

	if (material.alphamode == 1)	//Mask
		opacity = opacity > material.maskthreshold ? 1.0f : 0.f;

	return opacity;
}

void getPBRProperties(MaterialData material, vec2 uv, inout vec3 albedo, inout float metallic, inout float roughness, inout float ambientOcclusion)
{
    albedo = material.texture_albedo_count > 0 ? 
            texture(material.texture_albedo, uv).rgb * material.albedo
            :material.albedo;

    ambientOcclusion = material.texture_ao_count > 0 ? 
                    texture(material.texture_ao, uv).r 
                    : material.ambientOcclusion;

	if (material.texture_metallicroughness_count > 0)
	{
        vec2 values = texture(material.texture_metallicroughness, uv).gb;
        metallic = values.x;
        roughness = values.y;
	}
    else if (material.texture_metallic_count > 0 && material.texture_roughness_count > 0 
            && uint64_t(material.texture_metallic) == uint64_t(material.texture_roughness))
    {
        vec2 values = texture(material.texture_metallic, uv).gb;
        metallic = values.x;
        roughness = values.y;
    }
	else 
	{
        metallic = material.texture_metallic_count > 0 ?
                texture(material.texture_metallic, uv).b
                : material.metallic;

        roughness = material.texture_roughness_count > 0 ? 
                texture(material.texture_roughness, uv).g
                : material.roughness;
	}
}

vec3 calculateEmission(MaterialData material, vec2 uv)
{
    return material.texture_emissive_count > 0 ? 
            texture(material.texture_emissive, uv).rgb * material.emissionColor
            :material.emissionColor * material.emissionStrength;
}

//根据光线入射方向和表面的关系计算反射光线的比例
vec3 calculateRelfectFact(vec3 rayDir, vec3 normal, vec3 f0)
{
    float cosTheta = max(dot(-rayDir, normal), 0.0);
    float x = clamp(1 - cosTheta, 0, 1);
    float x2 = x * x;
    float x5 = x2 * x2 *x;
    return f0 + (1.0f - f0) * x5;	//反射光强度
}

bool intersectTriangle(Ray ray, Triangle tri, inout float outT, inout vec3 position , inout float outU, inout float outV) 
{
    
    const float EPSILON = 0.0000001;
    
    vec3 edge1 = tri.v1.position - tri.v0.position;
    vec3 edge2 = tri.v2.position - tri.v0.position;
    vec3 h = cross(ray.direction, edge2);
    float a = dot(edge1, h);
    
    if (abs(a) < EPSILON) return false;
    
    float f = 1.0 / a;
    vec3 s = ray.origin - tri.v0.position;
    float u = f * dot(s, h);
    
    if (u < 0.0 || u > 1.0) return false;
    
    vec3 q = cross(s, edge1);
    float v = f * dot(ray.direction, q);
    
    if (v < 0.0 || u + v > 1.0) return false;
    
    float t = f * dot(edge2, q);
    
    if (t <= 0) return false;

    if (t > ray.tMin && t < ray.tMax) {
        position = ray.origin + ray.direction * t;
        outT = t;
        outU = u;
        outV = v;
        return true;
    }
    
    return false;
}

bool intersectAABB(Ray ray , vec3 invDir, vec3 aabbmin, vec3 aabbmax) 
{
    vec3 t1 = (aabbmin - ray.origin) * invDir;
    vec3 t2 = (aabbmax - ray.origin) * invDir;
    
    vec3 tMin = min(t1, t2);
    vec3 tMax = max(t1, t2);
    
    float tNear = max(max(tMin.x, tMin.y), tMin.z);
    float tFar = min(min(tMax.x, tMax.y), tMax.z);
    
    return tNear <= tFar && tFar >= ray.tMin && tNear <= ray.tMax;
}

bool findHitPointOnMeshData(int index, inout Ray worldRay, inout HitInfo hit)
{
    bool isHit = false;

    // MeshMatData meshmatdata = meshmatDataBuffer.meshmatdata[index];
    MeshData meshdata = meshmatDataBuffer.meshmatdata[index].mesh;
    MaterialData materialdata = meshmatDataBuffer.meshmatdata[index].mat;

    Ray localRay;

    vec3 localDir = mat3(meshdata.invModel) * worldRay.direction;
    float dirLen = length(localDir);

    localRay.origin = vec3(meshdata.invModel * vec4(worldRay.origin, 1.0));
    localRay.direction = normalize(localDir);
    localRay.tMin = worldRay.tMin * dirLen;
    localRay.tMax = worldRay.tMax * dirLen;

    vec3 invDir = 1.0 / localRay.direction;

    // 栈模拟递归
    int stack[Max_Recursive_Depth + 1];
    int top = 0;

    BVHNode node;
    stack[top++] = meshdata.bvhNodeCount - 1;  // 根节点索引

    float t, u, v;
    vec3 localposition;
    Triangle tri;
    Triangle_Extension tri_ext;

    while (top > 0) {
        int nodeIdx = meshdata.bvhNodeFirst + stack[--top];
        node = meshBVHNodeBuffer.nodes[nodeIdx];
        
        // 测试 AABB
        if (!intersectAABB(localRay, invDir, node.min, node.max)) continue;

        // 判断是否为叶子节点
        if (node.leftChild == -1 && node.rightChild == -1) 
        {
            for (int idx = node.idFirst; idx < node.idFirst + node.idCount; idx++) 
            {
                // int triIdx = meshBVHIndicesBuffer.indices[meshdata.bvhIndicesFirst + m];       
                tri = triangleBuffer.triangles[meshdata.triangleFirst + idx];
                if (intersectTriangle(localRay, tri, t , localposition, u, v)) 
                {
                    t /= dirLen;
                    if (t < hit.t) 
                    {
                        tri_ext = triangleExtBuffer.triangleExts[meshdata.triangleFirst + idx];

                        vec2 texCoords = (1.0 - u - v) * tri_ext.v0.texCoords + u * tri_ext.v1.texCoords + v * tri_ext.v2.texCoords;
                        float opacity = calculateOpacity(materialdata, texCoords);
                        if (opacity < 0.01) continue;

                        vec3 localNormal = normalize((1.0 - u - v) * tri_ext.v0.normal + u * tri_ext.v1.normal + v * tri_ext.v2.normal);
                        vec3 localTangent = normalize((1.0 - u - v) * tri_ext.v0.Tangent + u * tri_ext.v1.Tangent + v * tri_ext.v2.Tangent);
                        vec3 localBitangent = normalize((1.0 - u - v) * tri_ext.v0.Bitangent + u * tri_ext.v1.Bitangent + v * tri_ext.v2.Bitangent);

                        if(dot(localRay.direction, localNormal) > 0)
                        {
                            if (materialdata.twosided == 1)
                            {
                                localNormal = -localNormal;
                                localTangent = -localTangent;
                                localBitangent = -localBitangent;
                            }
                            else 
                                continue;
                        }
 
                        vec3 T = normalize(meshdata.invTransModel * localTangent  );
                        vec3 B = normalize(meshdata.invTransModel * localBitangent);
                        vec3 N = normalize(meshdata.invTransModel * localNormal   );

                        worldRay.tMax = t;
                        hit.t = t;
                        hit.position = vec3(meshdata.model * vec4(localposition, 1.0f));
                        hit.tangent = T;
                        hit.bitangent = B;
                        hit.normal = N;
                        hit.texCoords = texCoords;
                        hit.materialdata = meshmatDataBuffer.meshmatdata[index].mat;
                    }

                    localRay.tMax = t;
                    isHit = true;
                }
            }
        } 
        else{
           if (top >= (Max_Recursive_Depth - 1)) break;

            // 内部节点：压入子节点（先压右，后压左）
            stack[top++] = node.rightChild;
            stack[top++] = node.leftChild;
        }
    }

    return isHit;
}

bool traceScene(Ray ray, inout HitInfo hit) 
{
    bool isHit = false;

    vec3 invDir = 1.0 / ray.direction;

    // 栈模拟递归
    int stack[Max_Recursive_Depth + 1];
    int top = 0;

    BVHNode node;
    stack[top++] = worldBVHNodeBuffer.nodeCount - 1;  // 根节点索引

    while (top > 0) {
        int nodeIdx = stack[--top];
        node = worldBVHNodeBuffer.nodes[nodeIdx];
        
        // 测试 AABB
        if (!intersectAABB(ray, invDir, node.min, node.max)) continue;

        // 判断是否为叶子节点
        if (node.leftChild == -1 && node.rightChild == -1) 
        {
            // 叶子节点：遍历该节点下的所有 mesh
            for (int idx = node.idFirst; idx < (node.idFirst + node.idCount); idx++) 
            {
                if(findHitPointOnMeshData(idx, ray, hit))
                    isHit = true;             
            }
        } 
        else{
            if (top >= (Max_Recursive_Depth - 1)) break;
                
            // 内部节点：压入子节点（先压右，后压左）
            stack[top++] = node.rightChild;
            stack[top++] = node.leftChild;
        }
    }

    return isHit;
}

bool traceRayWithHemisphereSample(vec3 position, vec3 normal, int maxBounce, inout vec3 indirectColors[Max_Bounce_limit + 1], inout int hitCount, int sampleId) 
{
    bool isHit = false;
    float throughput = 1.0f;

    for (int depth = 0; depth <= maxBounce; depth++) 
    {
        // 生成随机半球方向，进行追踪
        vec2 random = getRandom(sampleId * (maxBounce + 1) + depth);
        vec3 samplerDir = sampleHemisphere(normal, random);

        int index = hitCount;

        Ray ray;
        ray.origin = position + normal * 0.001;
        ray.direction = samplerDir;
        ray.tMin = tMin;
        ray.tMax = tMax;

        HitInfo hit;
        hit.t = ray.tMax;
        if(!traceScene(ray, hit))
            break;

        hitCount++;
        isHit = true;

        //计算该点光照颜色
        vec3 albedo;
        float metallic, roughness, ambientOcclusion;
	    getPBRProperties(hit.materialdata, hit.texCoords, albedo, metallic, roughness, ambientOcclusion);

        normal = hit.materialdata.texture_normal_count > 0 ?
            normalize(mat3(hit.tangent, hit.bitangent, hit.normal) * normalize(texture(hit.materialdata.texture_normal, hit.texCoords).rgb * 2.0 - 1.0))
            : hit.normal;

        position = hit.position;

        vec3 emission = calculateEmission(hit.materialdata, hit.texCoords);
        vec3 lightingColor = CalcLighting(
            camera.view, ray.origin, camera.farPlane,
            atlasShadowMap, 
            position, normal, 
            albedo, metallic, 
            roughness, ambientOcclusion
            );

        lightingColor = fresnelSchlickColorCalculate(lightingColor, normal, normalize(ray.origin - position), albedo, metallic, roughness, ambientOcclusion);
        vec3 color = lightingColor + emission;

        float dist = distance(ray.origin, position);
        float attenuation = 1.0 / (1.0 + dist * DistanceFactor);

        indirectColors[index] = color * attenuation;
        // indirectColors[index] = vec3(1,1,0);

        throughput *= attenuation;
        if (throughput < 0.02) 
            break;

    }

    return isHit;
}

vec3 tracePath(vec3 position, vec3 normal, int sampleCount, int bounce) 
{
    vec3 totalIndirect = vec3(0.0);

    for (int i = 0; i < sampleCount; i++) 
    {
        int hitCount = 0;
        vec3 indirectColors[Max_Bounce_limit + 1];

        if(traceRayWithHemisphereSample(position, normal, bounce, indirectColors, hitCount, i))
        {
            vec3 result = vec3(0.f);
            for (int i = hitCount - 1; i >= 0; i--)       
                result += indirectColors[i];

            totalIndirect += result;
        }
        
        // 能量贡献递减时提前退出
        if (i > 4 && length(totalIndirect) < 0.001)  // 连续5个样本都没命中
        {
            break;
        }
    }

    return sampleCount > 0 ?  totalIndirect / float(sampleCount) : vec3(0.f);
}

void calculateFirstBounceRayData(inout HitInfo info, inout Ray ray, vec2 uv)
{
    vec3 normal = normalize(texture(gNormal, uv).rgb);

	vec3 fragPos = texture(gPosition, uv).rgb;
    
    vec2 ndc = uv * 2.0 - 1.0;
    float aspect = float(screenSize.x) / float(screenSize.y);
    ndc.x *= aspect;
    float tanHalfFov = tan(radians(camera.fov) * 0.5);
    vec3 localRayDir = normalize(vec3(ndc * tanHalfFov, -1.0));
    vec3 worldRayDir = mat3(camera.invView) * localRayDir;
    vec3 reflectDir = normalize(reflect(worldRayDir, normal));

    info.position = fragPos;
    info.normal = normal;

    ray.origin = fragPos + normal * 0.002;
    ray.direction = reflectDir;
    ray.tMin = tMin;
    ray.tMax = tMax;
}

void ProcessWithGBuffer()
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    vec2 pixelCenter = pixelCoord + 0.5;
    if (pixelCoord.x >= screenSize.x || pixelCoord.y >= screenSize.y || maxBounce < 0) {
        return;
    }

    vec2 uv = pixelCenter / screenSize;

    // imageStore(outputImage, pixelCoord, vec4(meshmatDataBuffer.meshmatdata[1].mat.albedo, 1.0));
    // return;

    float depth = texture(depthMap, uv).r;
    if(depth >= 0.99999)
        return;

    vec3 albedo = texture(gAlbedoOpacity, uv).rgb;   
    vec2 values = texture(gMetallicRoughness, uv).rg;
    float metallic = values.r;
    float roughness = values.g;
    float ambientOcclusion = clamp(texture(SSAOMap, uv).r, 0.f, 1.f);

    int bounce = clamp(maxBounce, 0 , Max_Bounce_limit);
    if(ambientOcclusion < 0.02 || bounce <= 0)
        return;

    Ray ray;
    HitInfo firstInfo;
    calculateFirstBounceRayData(firstInfo, ray, uv);

    int sampleCount = max(1, sampleRayCount);
    vec3 color = tracePath(ray.origin, firstInfo.normal, sampleCount, bounce);

    vec3 result = fresnelSchlickColorCalculate(color, firstInfo.normal, normalize(camera.position - ray.origin), albedo, metallic, roughness, ambientOcclusion);

    imageStore(outputImage, pixelCoord, vec4(result, 1.0));
}

void main()
{
    ProcessWithGBuffer();
}
layout(binding = 0, rgba16f) uniform image2D outputImage;

struct Ray {
    vec3 origin;
    vec3 direction;
    float tMin;
    float tMax;
};

struct HitInfo {
    vec3 position;
    vec3 tangent;
    vec3 bitangent;
    vec3 normal;
    vec2 texCoords;
    float t;
    MaterialData materialdata;
};

vec3 fresnelSchlickRoughness(float cosTheta, vec3 F0, float roughness)
{
    return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}   

vec3 fresnelSchlickColorCalculate(vec3 color, vec3 normal, vec3 fragPosToView, vec3 albedo, float metallic, float roughness, float ambientOcclusion)
{
    vec3 F0 = mix(vec3(0.02), albedo, metallic);

    vec3 N = normal;
    vec3 V = normalize(fragPosToView);

    float NdotV = max(dot(N, V), 0.0);
    vec3 F_env = fresnelSchlickRoughness(NdotV, F0, roughness);  // 粗糙度修正菲涅尔
    vec3 kS_env = F_env;
    vec3 kD = 1.0 - kS_env;
    kD *= (1.0 - metallic);

    vec3 result = kD * color * albedo;

    result *= GIIntensity;
    result = mix(result, result * ambientOcclusion, AOIntensity);

    return result;
}

// 计算 Halton 序列
float halton(uint index, int base) 
{
    float result = 0.0;
    float f = 1.0;
    uint i = index;
    while (i > 0) 
    {
        f /= float(base);
        result += f * float(i % base);
        i /= base;
    }
    return result;
}

uint pcg_hash(uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float pcg_float(uint seed) {
    return float(pcg_hash(seed)) / 4294967296.0;
}

vec2 pcg_float2(uint seed) {
    uint h1 = pcg_hash(seed);
    uint h2 = pcg_hash(h1 + 0x9e3779b9u);
    return vec2(float(h1), float(h2)) / 4294967296.0;
}


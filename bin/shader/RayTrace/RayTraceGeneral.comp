vec3 RotateNormal(vec3 normal, float r1, float r2)
{
    float theta = acos(r1);
    float phi = 2.0 * PI * r2;
    
    vec3 dir = vec3(
        sin(theta) * cos(phi),
        sin(theta) * sin(phi),
        cos(theta)
    );
    
    // 将局部坐标转到世界空间（以法线为Z轴）
    vec3 up = abs(normal.y) < 0.999 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);

    vec3 samplerDir = normalize(tangent * dir.x + bitangent * dir.y + normal * dir.z);

    return samplerDir;
}

// 生成余弦加权半球随机方向
vec3 ImportanceSampleCosine(vec3 normal, vec2 random)
{
    float r1 = random.x;
    float r2 = random.y;  
    r1 = sqrt(r1); // 余弦加权
    return RotateNormal(normal, r1, r2);
}

// 生成GGX权重半球随机方向
vec3 ImportanceSampleGGX(float roughness, vec3 normal, vec3 viewDir, vec2 random)
{
    float r1 = random.x;
    float r2 = random.y;  

    // 生成局部坐标系的 H（假设 N 朝上）
    float a = roughness * roughness;
    float a2 = a * a;
    float phi = 2.0 * PI * r1;
    float cosTheta = sqrt((1.0 - r2) / (1.0 + (a2 - 1.0) * r2));
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

    // 本地空间的 H 向量 (z轴为N)
    vec3 H_local = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);

    vec3 N = normal;
    vec3 V = normalize(-viewDir);

    // 构建 TBN 矩阵
    vec3 up = abs(N.y) < 0.999 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);
    
    // 将 H 转换到世界空间
    vec3 H = normalize(tangent * H_local.x + bitangent * H_local.y + N * H_local.z);

    vec3 L = reflect(-V, H);

    // // 计算正确的 PDF（基于 L 空间，补上雅可比）
    // float NdotH = max(dot(N, H), 0.0);
    // float VdotH = max(dot(V, H), 0.0);
    
    // // 局部空间的 D（为了算 PDF，必须用局部的夹角，但 cosTheta 已经等于 NdotH，因为 H 转到了世界，且 TBN 是正交的）
    // float denom = cosTheta * cosTheta * (a2 - 1.0) + 1.0;
    // float D = a2 / (PI * denom * denom);
    
    // float pdf_H = D * cosTheta;             // H 空间的 PDF
    // pdf_L = pdf_H / (4.0 * VdotH + 0.0001); // L 空间的 PDF
    
    return L;
}

float calculateOpacity(MaterialData material, vec2 uv)
{
	if (material.alphamode == 0)
		return material.opacity;

	float opacity = material.opacity;
	if (material.texture_opacity_count > 0)
		opacity *= texture(material.texture_opacity, uv).r;
	else 
		opacity *= texture(material.texture_albedo, uv).a;

	if (material.alphamode == 1)	//Mask
		opacity = opacity > material.maskthreshold ? 1.0f : 0.f;

	return opacity;
}

void getPBRProperties(MaterialData material, vec2 uv, inout PBRProperties prop)
{
    prop.albedo = material.texture_albedo_count > 0 ? 
            texture(material.texture_albedo, uv).rgb * material.albedo
            :material.albedo;

    prop.ambientOcclusion = material.texture_ao_count > 0 ? 
                    texture(material.texture_ao, uv).r 
                    : material.ambientOcclusion;

	if (material.texture_metallicroughness_count > 0)
	{
        vec2 values = texture(material.texture_metallicroughness, uv).gb;
        prop.metallic = values.x;
        prop.roughness = values.y;
	}
    else if (material.texture_metallic_count > 0 && material.texture_roughness_count > 0 
            && uint64_t(material.texture_metallic) == uint64_t(material.texture_roughness))
    {
        vec2 values = texture(material.texture_metallic, uv).gb;
        prop.metallic = values.x;
        prop.roughness = values.y;
    }
	else 
	{
        prop.metallic = material.texture_metallic_count > 0 ?
                texture(material.texture_metallic, uv).b
                : material.metallic;

        prop.roughness = material.texture_roughness_count > 0 ? 
                texture(material.texture_roughness, uv).g
                : material.roughness;
	}
}

vec3 calculateEmission(MaterialData material, vec2 uv)
{
    return material.texture_emissive_count > 0 ? 
            texture(material.texture_emissive, uv).rgb * material.emissionColor
            :material.emissionColor * material.emissionStrength;
}

vec3 CalcContribute_UniformSample(vec3 light, vec3 lightPos, vec3 fragPos, vec3 fragNormal)
{
    vec3 N = normalize(fragNormal);           	        // 表面法线
	vec3 L = normalize(lightPos - fragPos); 	        // 光线方向（从表面指向光源）
    float NdotL = max(dot(N, L), 0.0);			        // 表面法线x指向光线

	vec3 Contribute = light * NdotL * 2.0 * PI;
	return Contribute;
}

vec3 CalcContribute_CosineSample(vec3 light)
{
	return light * PI;
}

vec3 CalcContribute_GGXSample(
	vec3 normal, vec3 fragToViewDir, vec3 fragToLightDir,
	vec3 albedo, float metallic, float roughness)
{	
	vec3 N = normalize(normal);           	// 表面法线
	vec3 V = normalize(fragToViewDir); 		// 视线反方向（从表面指向摄像机）
	vec3 L = normalize(fragToLightDir); 	// 光线方向（从表面指向光源）
	vec3 H = normalize(V + L);            	// 半角向量
	float NdotL = max(dot(N, L), 0.0);		// 表面法线x指向光线
	float NdotV = max(dot(N, V), 0.0);		// 表面法线x指向摄像机
	float NdotH = max(dot(N, H), 0.0);		// 表面法线x半程向量
	float VdotH = max(dot(V, H), 0.0);		// 指向摄像机x半程向量

    if (NdotL <= 0.0)
        return vec3(0.0);

	vec3 F0 = mix(vec3(0.02), albedo, metallic);

    float G = GeometrySmith(NdotL, NdotV, roughness);
	vec3 F = fresnelSchlick(F0, VdotH);

	vec3 specular = (F * G) * VdotH / (NdotV * NdotH + 0.0001);
    return specular;
}

bool intersectTriangle(Ray ray, Triangle tri, inout float outT, inout vec3 position , inout float outU, inout float outV) 
{
    
    const float EPSILON = 0.0000001;
    
    vec3 edge1 = tri.v1.position - tri.v0.position;
    vec3 edge2 = tri.v2.position - tri.v0.position;
    vec3 h = cross(ray.direction, edge2);
    float a = dot(edge1, h);
    
    if (abs(a) < EPSILON) return false;
    
    float f = 1.0 / a;
    vec3 s = ray.origin - tri.v0.position;
    float u = f * dot(s, h);
    
    if (u < 0.0 || u > 1.0) return false;
    
    vec3 q = cross(s, edge1);
    float v = f * dot(ray.direction, q);
    
    if (v < 0.0 || u + v > 1.0) return false;
    
    float t = f * dot(edge2, q);
    
    if (t <= 0) return false;

    if (t > ray.tMin && t < ray.tMax) {
        position = ray.origin + ray.direction * t;
        outT = t;
        outU = u;
        outV = v;
        return true;
    }
    
    return false;
}

bool intersectAABB(Ray ray , vec3 invDir, vec3 aabbmin, vec3 aabbmax) 
{
    vec3 t1 = (aabbmin - ray.origin) * invDir;
    vec3 t2 = (aabbmax - ray.origin) * invDir;
    
    vec3 tMin = min(t1, t2);
    vec3 tMax = max(t1, t2);
    
    float tNear = max(max(tMin.x, tMin.y), tMin.z);
    float tFar = min(min(tMax.x, tMax.y), tMax.z);
    
    return tNear <= tFar && tFar >= ray.tMin && tNear <= ray.tMax;
}

bool findHitPointOnMeshData(int index, inout Ray worldRay, inout HitInfo hit)
{
    bool isHit = false;

    // MeshMatData meshmatdata = meshmatDataBuffer.meshmatdata[index];
    MeshData meshdata = meshmatDataBuffer.meshmatdata[index].mesh;
    MaterialData materialdata = meshmatDataBuffer.meshmatdata[index].mat;

    Ray localRay;

    vec3 localDir = mat3(meshdata.invModel) * worldRay.direction;
    float dirLen = length(localDir);

    localRay.origin = vec3(meshdata.invModel * vec4(worldRay.origin, 1.0));
    localRay.direction = normalize(localDir);
    localRay.tMin = worldRay.tMin * dirLen;
    localRay.tMax = worldRay.tMax * dirLen;

    vec3 invDir = 1.0 / localRay.direction;

    // 栈模拟递归
    int stack[Max_Recursive_Depth + 1];
    int top = 0;

    BVHNode node;
    stack[top++] = meshdata.bvhNodeCount - 1;  // 根节点索引

    float t, u, v;
    vec3 localposition;
    Triangle tri;
    Triangle_Extension tri_ext;

    while (top > 0) {
        int nodeIdx = meshdata.bvhNodeFirst + stack[--top];
        node = meshBVHNodeBuffer.nodes[nodeIdx];
        
        // 测试 AABB
        if (!intersectAABB(localRay, invDir, node.min, node.max)) continue;

        // 判断是否为叶子节点
        if (node.leftChild == -1 && node.rightChild == -1) 
        {
            for (int idx = node.idFirst; idx < node.idFirst + node.idCount; idx++) 
            {
                // int triIdx = meshBVHIndicesBuffer.indices[meshdata.bvhIndicesFirst + m];       
                tri = triangleBuffer.triangles[meshdata.triangleFirst + idx];
                if (intersectTriangle(localRay, tri, t , localposition, u, v)) 
                {
                    t /= dirLen;
                    if (t < hit.t) 
                    {
                        tri_ext = triangleExtBuffer.triangleExts[meshdata.triangleFirst + idx];

                        vec2 texCoords = (1.0 - u - v) * tri_ext.v0.texCoords + u * tri_ext.v1.texCoords + v * tri_ext.v2.texCoords;
                        float opacity = calculateOpacity(materialdata, texCoords);
                        if (opacity < 0.01) continue;

                        vec3 localNormal = normalize((1.0 - u - v) * tri_ext.v0.normal + u * tri_ext.v1.normal + v * tri_ext.v2.normal);
                        vec3 localTangent = normalize((1.0 - u - v) * tri_ext.v0.Tangent + u * tri_ext.v1.Tangent + v * tri_ext.v2.Tangent);
                        vec3 localBitangent = normalize((1.0 - u - v) * tri_ext.v0.Bitangent + u * tri_ext.v1.Bitangent + v * tri_ext.v2.Bitangent);

                        if(dot(localRay.direction, localNormal) > 0)
                        {
                            if (materialdata.twosided == 1)
                            {
                                localNormal = -localNormal;
                                localTangent = -localTangent;
                                localBitangent = -localBitangent;
                            }
                            else 
                                continue;
                        }
 
                        vec3 T = normalize(meshdata.invTransModel * localTangent  );
                        vec3 B = normalize(meshdata.invTransModel * localBitangent);
                        vec3 N = normalize(meshdata.invTransModel * localNormal   );

                        worldRay.tMax = t;
                        hit.t = t;
                        hit.position = vec3(meshdata.model * vec4(localposition, 1.0f));
                        hit.tangent = T;
                        hit.bitangent = B;
                        hit.normal = N;
                        hit.texCoords = texCoords;
                        hit.materialdata = meshmatDataBuffer.meshmatdata[index].mat;
                    }

                    localRay.tMax = t;
                    isHit = true;
                }
            }
        } 
        else{
           if (top >= (Max_Recursive_Depth - 1)) break;

            // 内部节点：压入子节点（先压右，后压左）
            stack[top++] = node.rightChild;
            stack[top++] = node.leftChild;
        }
    }

    return isHit;
}

bool traceScene(Ray ray, inout HitInfo hit) 
{
    bool isHit = false;

    vec3 invDir = 1.0 / ray.direction;

    // 栈模拟递归
    int stack[Max_Recursive_Depth + 1];
    int top = 0;

    BVHNode node;
    stack[top++] = worldBVHNodeBuffer.nodeCount - 1;  // 根节点索引

    while (top > 0) {
        int nodeIdx = stack[--top];
        node = worldBVHNodeBuffer.nodes[nodeIdx];
        
        // 测试 AABB
        if (!intersectAABB(ray, invDir, node.min, node.max)) continue;

        // 判断是否为叶子节点
        if (node.leftChild == -1 && node.rightChild == -1) 
        {
            // 叶子节点：遍历该节点下的所有 mesh
            for (int idx = node.idFirst; idx < (node.idFirst + node.idCount); idx++) 
            {
                if(findHitPointOnMeshData(idx, ray, hit))
                    isHit = true;             
            }
        } 
        else{
            if (top >= (Max_Recursive_Depth - 1)) break;
                
            // 内部节点：压入子节点（先压右，后压左）
            stack[top++] = node.rightChild;
            stack[top++] = node.leftChild;
        }
    }

    return isHit;
}

float calc_P_Spec(PBRProperties prop)
{
    vec3 F0 = mix(vec3(0.02), prop.albedo, prop.metallic);
    float avgF0 = (F0.r + F0.g + F0.b) / 3.0;
    float p_spec = clamp(avgF0 * (1.0 - prop.roughness) + prop.roughness * 0.1, 0.05, 0.95);
    return p_spec;
}
#version 460
#extension GL_EXT_ray_tracing : enable

#ifndef Max_Bounce_limit
#define Max_Bounce_limit 5
#endif

#include "shader/dataDef/MaterialTextureDef.comp"
#include "shader/dataDef/camerauboDef.comp"
#include "shader/Helper/lightingHelper.comp"
#include "shader/RTCoreRayTrace/RayTraceGeneral.comp"
#include "shader/Filter/IndirectDemodulation.comp"

// 反射光线上的高度雾（和主画面同一份参数，见 ReflectionFog.comp）；体积雾的散射用阴影光线判断可见性
#define REFLECT_FOG_BINDING 25
#define REFLECT_FOG_RAY_VISIBLE(p, toLight, maxDist) (!TraceShadowRay((p), (toLight), 0.01, (maxDist)))
#include "shader/Volume/ReflectionFog.comp"


//光追参数
layout (binding = 5) uniform Params
{
    float tMin;
    float tMax;
    uint maxBounce;       // 最大反射次数
    uint sampleRayCount;
    uint frameIndex;
};

layout (binding = 6) uniform CubeParams
{
    bool CubeEnable;
    bool IBLEnable;
    bool DDGIEnable;    // 命中点的漫反射间接光取自 DDGI（DDGI 开启且有可用体积时）
};

layout(binding = 7, rgba16f) uniform image2D outputImage;
layout (binding = 8) uniform sampler2D gPosition;
layout (binding = 9) uniform sampler2D gNormal;
layout (binding = 10) uniform sampler2D gAlbedoOpacity;
layout (binding = 11) uniform sampler2D gMetallicRoughness;
layout (binding = 12) uniform sampler2D depthMap;
layout (binding = 13) uniform sampler2D atlasShadowMap;
layout (binding = 14) uniform sampler2D SSAOMap;
layout (binding = 15) uniform samplerCube cubeMap;
layout (binding = 16) uniform samplerCube IBLDiffuse;
layout (binding = 17) uniform samplerCube IBLPrefilter;
layout (binding = 18) uniform sampler2D IBLBrdfLUT;

// DDGI（与 DDGIApply 同一份图集 / UBO / 体积表），DDGIEnable 为 0 时不绑定
#define DDGI_UBO_BINDING 19
#define DDGI_VOLUME_BINDING 20
#include "shader/DDGI/DDGICore.comp"
#include "shader/DDGI/DDGIUniforms.comp"
layout (binding = 21) uniform sampler2D ddgiIrradianceTex;
layout (binding = 22) uniform sampler2D ddgiDepthTex;
layout (binding = 23) uniform sampler2D ddgiProbeDataTex;
// 第一次反弹命中点的世界空间运动（上一帧位置 - 本帧位置），xyz = 运动，w = 1 有效 / 0 没打中物体。时域累积按它重投影虚像
layout(binding = 24, rgba16f) uniform image2D outputHitMotionImage;
#include "shader/DDGI/DDGISample.comp"

const float RussianRouletteFactor = 0.8f;

// 反射路径命中点自身的漫反射间接光（命中点多在屏幕外，取不到屏幕空间的结果）：
// DDGI 的 Lbar × kD·albedo × energy（与 DDGIApply 相同的约定），DDGI 没覆盖到的权重回退到 IBL 漫反射。
vec3 reflectHitDiffuseIndirect(vec3 pos, vec3 normal, vec3 toViewer, PBRProperties prop)
{
    vec3 kdAlbedo = prop.albedo * (1.0 - prop.metallic);
    vec3 result = vec3(0.0);
    float remaining = 1.0;
    if (DDGIEnable)
        result = kdAlbedo * ddgiSampleIrradianceEx(pos, normal, toViewer, remaining) * ddgi.shadingParams.z;
    if (IBLEnable && remaining > 1e-3)
        result += remaining * kdAlbedo / PI * textureLod(IBLDiffuse, normal, 0.0).rgb;
    return result * prop.ambientOcclusion;
}

vec3 traceRay(
    vec3 viewPos, 
    vec3 fragPos, vec3 fragNormal,
    PBRProperties prop,
    uint maxBounce, 
    uint sampleId,
    float coneSpread,           // Ray Cone 扩散角（像素对应的角度，严格版：各次反弹不变）
    float coneWidth0,           // Ray Cone 在起点（G-buffer 表面）处的宽度
    inout float firstHitT,      // 第一次反弹的命中距离；没打中几何（取环境 / 没取到）时不改（调用方给 tMax）
    inout vec3 firstHitMotion   // 第一次反弹命中点的世界空间运动（上一帧 - 本帧）；没打中时不改
) 
{

    vec3 colors[Max_Bounce_limit + 1];
    vec3 contributeFacts[Max_Bounce_limit + 1];
    // 每一段（起点 → 命中点 / 天空）的雾：到达起点的辐亮度 = L × fogT + fogS
    vec3 fogT[Max_Bounce_limit + 1];
    vec3 fogS[Max_Bounce_limit + 1];
    int hitCount = 0;

    float throughput = 1.0f;
    float coneWidth = coneWidth0;
    // 光路从相机算起已经走过的距离（雾的起始距离按它扣）：先是相机 → 镜面
    float pathLength = distance(viewPos, fragPos);

    uint seedbase = uint(gl_LaunchIDEXT.x) * 197u 
            + uint(gl_LaunchIDEXT.y) * 927u
            + uint(frameIndex) * 777u;

    for (uint depth = 0; depth < maxBounce; depth++) 
    {
        uint seed = seedbase + uint(sampleId * (maxBounce + 1) + depth) * 269u;

        Ray ray;
        ray.origin = fragPos + fragNormal * 0.001;
        ray.tMin = tMin;
        ray.tMax = tMax;

        HitInfo hit;
        hit.t = ray.tMax;

        bool captureCube = false;

        {
            // GGX重要性采样specular
            vec2 random = getRandom(seed);
            ray.direction = ImportanceSampleGGX(prop.roughness, fragNormal, normalize(ray.origin - viewPos), random);

            if(!traceScene(ray, hit))
            {
                if (CubeEnable)
                    captureCube = true;
                else 
                    break;
            }

            // 计算该点向前一个点高光传递贡献
            contributeFacts[hitCount] = CalcContribute_GGXSample(fragNormal, normalize(viewPos - ray.origin), ray.direction, prop.albedo, prop.metallic, prop.roughness);
        }

        // 这一段的雾（打到天空时按无穷远；体积雾散射仅首跳采样）
        {
            float segLength = captureCube ? 0.0 : distance(ray.origin, hit.position);
            float fogJitter = pcg_float(seed ^ 0x9e3779b9u);
            ReflectFogSegment(ray.origin, ray.direction, segLength, captureCube, pathLength, depth == 0u, fogJitter, fogT[hitCount], fogS[hitCount]);
            pathLength += segLength;
        }

        if (depth == 0u && !captureCube)
        {
            firstHitT = distance(hit.position, ray.origin);
            firstHitMotion = hit.prevPosition - hit.position;
        }

        if (!captureCube)
        {
            // 计算该点光照颜色。光追里没有导数，按 Ray Cone 显式选 mip
            float coneLod = rayConeAdvance(coneWidth, coneSpread, hit);
            getPBRPropertiesLod(hit.materialdata, hit.texCoords, coneLod, prop);

            vec3 normal = calculateNormalLod(hit.materialdata, hit.normal, mat3(hit.tangent, hit.bitangent, hit.normal), hit.texCoords, coneLod);

            vec3 emission = calculateEmissionLod(hit.materialdata, hit.texCoords, coneLod);
            vec3 lightingColor = CalcLightingWithShadowRay(ray.origin, hit.position, normal, prop);
            // 命中点出射辐亮度 = 直接光 + 自发光 + 漫反射间接光（DDGI / IBL）
            vec3 indirectDiffuse = reflectHitDiffuseIndirect(hit.position, normal, -ray.direction, prop);
            colors[hitCount] = lightingColor + emission + indirectDiffuse;

            // 路径在这个命中点停下（材质不再追踪 / 达到最大次数）时，补上命中点自身的 IBL 镜面；
            // 俄罗斯轮盘终止的不补（已由 throughput 补偿）
            if (IBLEnable && (prop.metallic < 0.15 || prop.roughness > 0.8 || depth + 1u >= maxBounce))
            {
                vec3 unusedDiffuse, hitSpecular;
                CalculateIBLLightingSplit(ray.direction, normal, prop, IBLDiffuse, IBLPrefilter, IBLBrdfLUT, unusedDiffuse, hitSpecular);
                colors[hitCount] += hitSpecular;
            }

            viewPos = ray.origin;
            fragPos = hit.position;
            fragNormal = normal;
        }
        else 
        {
            vec3 indirectColor = texture(cubeMap, ray.direction).rgb;
            colors[hitCount] = indirectColor;
        }

        contributeFacts[hitCount] = contributeFacts[hitCount] / throughput;
        hitCount++;

        if (captureCube || prop.metallic < 0.15 || prop.roughness > 0.8 || (pcg_float(seed * 72789645u + 29157653u) >= RussianRouletteFactor))
            break;
        throughput *= RussianRouletteFactor;
    }

    if (hitCount > 0)
    {
        vec3 result = vec3(0.f);
        for (int i = hitCount - 1; i >= 0; i--)
        {
            // 命中点出射（自身 + 更深的反射）经过这一段的雾，再乘起点的镜面贡献
            result = ((result + colors[i]) * fogT[i] + fogS[i]) * contributeFacts[i];
        }
        return result;
    }

    return vec3(0.f);
}

vec3 tracePath(
    vec3 viewPos, 
    vec3 fragPos, vec3 fragNormal,
    PBRProperties prop,
    uint maxBounce,
    uint sampleCount,
    float coneSpread,
    float coneWidth0,
    out float hitDistance,
    out vec4 hitMotion
    ) 
{
    vec3 totalIndirect = vec3(0.0);
    float hitSum = 0.0;
    float hitSamples = 0.0;
    vec3 motionSum = vec3(0.0);

    for (uint i = 0; i < sampleCount; i++) 
    {
        float firstHitT = tMax;
        vec3 firstHitMotion = vec3(0.0);
        totalIndirect += traceRay(viewPos, fragPos, fragNormal, prop, maxBounce, i, coneSpread, coneWidth0, firstHitT, firstHitMotion);
        if (firstHitT < tMax)
        {
            hitSum += firstHitT;
            hitSamples += 1.0;
            motionSum += firstHitMotion;
        }
    }

    // 命中距离（时域累积的虚像重投影用）：打中几何的样本取平均；都没打中时为 tMax（环境在无穷远，只剩相机旋转）
    hitDistance = hitSamples > 0.0 ? hitSum / hitSamples : max(tMax, 1e-3);
    hitMotion = hitSamples > 0.0 ? vec4(motionSum / hitSamples, 1.0) : vec4(0.0);

    return sampleCount > 0 ?  totalIndirect / float(sampleCount) : vec3(0.f);
}

void calculateFirstHitInfo(inout HitInfo info, vec2 uv)
{
    vec3 normal = normalize(texture(gNormal, uv).rgb);
	vec3 fragPos = texture(gPosition, uv).rgb;
    info.position = fragPos + normal * 0.001;
    info.normal = normal;
}

void main() 
{
    ivec2 pixelCoord = ivec2(gl_LaunchIDEXT.xy);
    ivec2 imageSize = imageSize(outputImage);

    if (pixelCoord.x >= imageSize.x || pixelCoord.y >= imageSize.y || maxBounce < 0) {
        return;
    }
    
    vec2 pixelCenter = vec2(pixelCoord) + 0.5;
    vec2 uv = pixelCenter / imageSize;

    float depth = texture(depthMap, uv).r;
    if(depth >= 0.99994)
        return;

    if(maxBounce <= 0)
        return;

    vec2 values = texture(gMetallicRoughness, uv).rg;
    PBRProperties prop;
    prop.albedo = texture(gAlbedoOpacity, uv).rgb;   
    prop.metallic = values.r;
    prop.roughness = values.g;
    prop.ambientOcclusion = clamp(texture(SSAOMap, uv).r, 0.f, 1.f);

    if (prop.metallic < 0.15 || prop.roughness > 0.8)
    {
        if (IBLEnable)
        {
            vec3 fragPos = texture(gPosition, uv).rgb;
            vec3 fragNormal = normalize(texture(gNormal, uv).rgb);

            vec3 viewDir = normalize(fragPos - camera.position);
            // 镜面合成只收镜面：不追踪的像素只回退 IBL 镜面，漫反射由漫反射合成 / LightingPass 负责
            vec3 unusedDiffuse, color;
            CalculateIBLLightingSplit(viewDir, fragNormal, prop, IBLDiffuse, IBLPrefilter, IBLBrdfLUT, unusedDiffuse, color);
            // 去调制（与追踪路径同一个除数），全分辨率上采样时乘回
            color /= IndirectDemodulationSpecular(prop.albedo, prop.metallic, prop.roughness, clamp(dot(fragNormal, -viewDir), 0.0, 1.0));
            color = clamp(color, vec3(0.f), vec3(1000.f));
            // 只有环境反射：虚像在无穷远（命中距离 = tMax）
            imageStore(outputImage, pixelCoord, vec4(color, max(tMax, 1e-3)));
            imageStore(outputHitMotionImage, pixelCoord, vec4(0.0));
        }
        return;
    }

    HitInfo firstHit;
    calculateFirstHitInfo(firstHit, uv);

    // Ray Cone 初始锥：扩散角 = 这张输出图上一个像素对应的角度，起点宽度 = 该像素在 G-buffer 表面上的覆盖宽度
    float coneSpread = rayConePixelSpread(camera.projection, float(imageSize.y));
    float coneWidth0 = coneSpread * distance(camera.position, firstHit.position);

    float hitDistance = 0.0;
    vec4 hitMotion = vec4(0.0);
    vec3 color = tracePath(camera.position, firstHit.position, firstHit.normal, prop, clamp(maxBounce, uint(1) , uint(Max_Bounce_limit)), max(uint(1), sampleRayCount), coneSpread, coneWidth0, hitDistance, hitMotion);
    // 去调制：除以接收面的镜面反射率，降噪只处理入射光照；全分辨率上采样时乘回（IndirectUpsample.comp）
    vec3 viewToFrag = normalize(camera.position - texture(gPosition, uv).rgb);
    color /= IndirectDemodulationSpecular(prop.albedo, prop.metallic, prop.roughness, clamp(dot(firstHit.normal, viewToFrag), 0.0, 1.0));
    color = clamp(color, vec3(0.f), vec3(1000.f));
    // alpha：第一次反弹的命中距离（TemporalAccumulate 的镜面信号）
    imageStore(outputImage, pixelCoord, vec4(color, hitDistance));
    imageStore(outputHitMotionImage, pixelCoord, hitMotion);
}
#version 460

#ifndef Max_Bounce_limit
#define Max_Bounce_limit 5
#endif

#include "shader/dataDef/MaterialTextureDef.comp"
#include "shader/dataDef/camerauboDef.comp"
#include "shader/Helper/lightingHelper.comp"
#include "shader/RTCoreRayTrace/RayTraceGeneral.comp"
#include "shader/Filter/IndirectDemodulation.comp"


//光追参数
layout (binding = 5) uniform Params
{
    float tMin;
    float tMax;
    uint maxBounce;       // 最大反射次数
    uint sampleRayCount;
    float GIIntensity;
    uint frameIndex;
};

layout (binding = 6) uniform CubeParams
{
    bool CubeEnable;
};

layout(binding = 7, rgba16f) uniform image2D outputImage;
layout (binding = 8) uniform sampler2D gPosition;
layout (binding = 9) uniform sampler2D gNormal;
layout (binding = 10) uniform sampler2D gAlbedoOpacity;
layout (binding = 11) uniform sampler2D gMetallicRoughness;
layout (binding = 12) uniform sampler2D depthMap;
layout (binding = 13) uniform sampler2D atlasShadowMap;
layout (binding = 14) uniform sampler2D SSAOMap;
layout (binding = 15) uniform samplerCube cubeMap;
// 路径追踪拆成两路：outputImage = 漫反射（alpha 1），outputSpecularImage = 镜面（alpha = 第一次反弹的命中距离）
layout(binding = 16, rgba16f) uniform image2D outputSpecularImage;
// 镜面那一路第一次反弹命中点的世界空间运动（上一帧位置 - 本帧位置），w = 1 有效。时域累积按它重投影虚像
layout(binding = 17, rgba16f) uniform image2D outputSpecularHitMotionImage;

const float RussianRouletteFactor = 0.8f;

vec3 traceRay(
    vec3 viewPos, 
    vec3 fragPos, vec3 fragNormal,
    PBRProperties prop,
    uint maxBounce, 
    uint sampleId,
    float lobeRandom,           // 第一次反弹选镜面 / 漫反射用的随机数（tracePath 里分层生成）
    out bool firstSpecular,     // 第一次反弹走的是不是镜面
    inout float firstHitT,      // 第一次反弹的命中距离；没打中几何时不改，调用方给 tMax
    inout vec3 firstHitMotion   // 第一次反弹命中点的世界空间运动（上一帧 - 本帧）；没打中时不改
) 
{
    firstSpecular = false;

    vec3 colors[Max_Bounce_limit + 1];
    vec3 contributeFacts[Max_Bounce_limit + 1];
    int hitCount = 0;

    float throughput = 1.0f;

    uint seedbase = uint(gl_LaunchIDEXT.x) * 197u 
            + uint(gl_LaunchIDEXT.y) * 927u
            + uint(frameIndex) * 777u;

    for (uint depth = 0; depth < maxBounce; depth++) 
    {
        uint seed = seedbase + uint(sampleId * (maxBounce + 1) + depth) * 269u;

        Ray ray;
        ray.origin = fragPos + fragNormal * 0.001;
        ray.tMin = tMin;
        ray.tMax = tMax;

        HitInfo hit;
        hit.t = ray.tMax;

        bool captureCube = false;

        // 根据材质，随机选取走高光采样还是漫反射采样
        float p_spec = calc_P_Spec(prop);
        // 第一次反弹的波瓣概率限制在 [0.25, 0.75]（纯金属没有漫反射，直接取 1）：拆成两路后各自单独降噪，
        // 概率太小的那一路几乎每帧都没有样本、偶尔来一个就是 1/p 倍的亮点，累积后在画面上闪烁。
        // 任何 (0, 1) 的概率都是无偏的（权重除以同一个 p_spec），只是方差分配不同（NRD 的建议）
        if (depth == 0u)
            p_spec = prop.metallic >= 0.99 ? 1.0 : clamp(p_spec, 0.25, 0.75);
        bool spec = (depth == 0u ? lobeRandom : pcg_float(seed * 7476405u + 2891453u)) < p_spec;
        if (depth == 0u)
            firstSpecular = spec;
        if (spec)
        {
            // GGX重要性采样specular
            vec2 random = getRandom(seed);
            ray.direction = ImportanceSampleGGX(prop.roughness, fragNormal, normalize(ray.origin - viewPos), random);

            if(!traceScene(ray, hit))
            {
                if (CubeEnable)
                    captureCube = true;
                else 
                    break;
            }
            // 计算该点向前一个点高光传递贡献
            contributeFacts[hitCount] = CalcContribute_GGXSample(fragNormal, normalize(viewPos - ray.origin), ray.direction, prop.albedo, prop.metallic, prop.roughness) / p_spec;
        }
        else 
        {
            // 余弦加权重要性采样diffuse
            vec2 random = getRandom(seed);
            ray.direction = ImportanceSampleCosine(fragNormal, random);

            if(!traceScene(ray, hit))
            {
                if (CubeEnable)
                    captureCube = true;
                else 
                    break;
            }
    
            // 计算该点向前一个点漫反射传递贡献
            vec3 diffuse = vec3(0.0);
            CalcBDRFDiffuse(prop.albedo, prop.metallic, diffuse);
            contributeFacts[hitCount] = CalcContribute_CosineSample(diffuse) / (1.0 - p_spec);
        }

        if (depth == 0u && !captureCube)
        {
            firstHitT = distance(hit.position, ray.origin);
            firstHitMotion = hit.prevPosition - hit.position;
        }

        if (!captureCube)
        {
            //计算该点光照颜色
            getPBRProperties(hit.materialdata, hit.texCoords, prop);

            vec3 normal = calculateNormal(hit.materialdata, hit.normal, mat3(hit.tangent, hit.bitangent, hit.normal), hit.texCoords);

            vec3 emission = calculateEmission(hit.materialdata, hit.texCoords);
            vec3 lightingColor = CalcLightingWithShadowRay(ray.origin, hit.position, normal, prop);
            colors[hitCount] = lightingColor + emission;

            viewPos = ray.origin;
            fragPos = hit.position;
            fragNormal = normal;
        }
        else 
        {
            vec3 indirectColor = texture(cubeMap, ray.direction).rgb;
            colors[hitCount] = indirectColor;
        }

        contributeFacts[hitCount] = contributeFacts[hitCount] / throughput;
        hitCount++;

        if (captureCube || (pcg_float(seed * 72789645u + 29157653u) >= RussianRouletteFactor))
            break;
        throughput *= RussianRouletteFactor;
    }

    if (hitCount > 0)
    {
        vec3 result = vec3(0.f);
        for (int i = hitCount - 1; i >= 0; i--)
        {
            result = (result + colors[i]) * contributeFacts[i];
        }
        return result;
    }

    return vec3(0.f);
}

void tracePath(
    vec3 viewPos, 
    vec3 fragPos, vec3 fragNormal,
    PBRProperties prop,
    uint maxBounce,
    uint sampleCount,
    out vec3 diffuseOut,
    out vec3 specularOut,
    out float specularHitDistance,
    out vec4 specularHitMotion
    ) 
{
    // 按第一次反弹选的波瓣拆成漫反射 / 镜面两路（各自降噪，镜面那一路做虚像重投影）。
    // 每个样本的权重已经除过 p_spec / (1 - p_spec)，两路都除以总样本数，相加就是原来的估计。
    // 第一次反弹的波瓣分层选：每个像素一个随机偏移，样本 i 用 fract(偏移 + i / N)。单个样本仍是均匀分布（无偏），
    // 但一个像素里镜面样本数固定在 N·p_spec 上下 1 个以内，镜面那一路不容易整片没有样本
    uint pixelSeed = uint(gl_LaunchIDEXT.x) * 197u + uint(gl_LaunchIDEXT.y) * 927u + uint(frameIndex) * 777u;
    float lobeOffset = pcg_float(pixelSeed * 5871943u + 1442695u);

    vec3 diffuseSum = vec3(0.0);
    vec3 specularSum = vec3(0.0);
    float hitSum = 0.0;
    float hitSamples = 0.0;
    vec3 motionSum = vec3(0.0);
    float specularSamples = 0.0;

    for (uint i = 0; i < sampleCount; i++) 
    {
        float lobeRandom = fract(lobeOffset + float(i) / float(max(sampleCount, 1u)));
        bool isSpecular = false;
        float firstHitT = tMax;
        vec3 firstHitMotion = vec3(0.0);
        vec3 c = traceRay(viewPos, fragPos, fragNormal, prop, maxBounce, i, lobeRandom, isSpecular, firstHitT, firstHitMotion);
        if (isSpecular)
        {
            specularSum += c;
            specularSamples += 1.0;
            if (firstHitT < tMax)
            {
                hitSum += firstHitT;
                hitSamples += 1.0;
                motionSum += firstHitMotion;
            }
        }
        else
            diffuseSum += c;
    }

    float invCount = sampleCount > 0u ? 1.0 / float(sampleCount) : 0.0;
    diffuseOut = diffuseSum * invCount;
    specularOut = specularSum * invCount;
    // 镜面命中距离：打中几何的镜面样本取平均；有镜面样本但都没打中时为 tMax；这一帧没有镜面样本为 0（时域累积取邻域）
    specularHitDistance = hitSamples > 0.0 ? hitSum / hitSamples : (specularSamples > 0.0 ? max(tMax, 1e-3) : 0.0);
    specularHitMotion = hitSamples > 0.0 ? vec4(motionSum / hitSamples, 1.0) : vec4(0.0);
}

void calculateFirstHitInfo(inout HitInfo info, vec2 uv)
{
    vec3 normal = normalize(texture(gNormal, uv).rgb);
	vec3 fragPos = texture(gPosition, uv).rgb;
    info.position = fragPos + normal * 0.001;
    info.normal = normal;
}

void main() 
{
    ivec2 pixelCoord = ivec2(gl_LaunchIDEXT.xy);
    ivec2 imageSize = imageSize(outputImage);

    if (pixelCoord.x >= imageSize.x || pixelCoord.y >= imageSize.y || maxBounce < 0) {
        return;
    }

    vec2 pixelCenter = vec2(pixelCoord) + 0.5;
    vec2 uv = pixelCenter / imageSize;

    float depth = texture(depthMap, uv).r;
    if(depth >= 0.99994)
        return;

    if(maxBounce <= 0)
        return;

    vec2 values = texture(gMetallicRoughness, uv).rg;
    PBRProperties prop;
    prop.albedo = texture(gAlbedoOpacity, uv).rgb;   
    prop.metallic = values.r;
    prop.roughness = values.g;
    prop.ambientOcclusion = clamp(texture(SSAOMap, uv).r, 0.f, 1.f);

    HitInfo firstHit;
    calculateFirstHitInfo(firstHit, uv);

    vec3 diffuseColor, specularColor;
    float specularHitDistance;
    vec4 specularHitMotion;
    tracePath(camera.position, firstHit.position, firstHit.normal, prop, clamp(maxBounce, uint(1) , uint(Max_Bounce_limit)), max(uint(1), sampleRayCount),
        diffuseColor, specularColor, specularHitDistance, specularHitMotion);
    diffuseColor *= GIIntensity;
    specularColor *= GIIntensity;
    // 去调制：两路分别除以接收面的漫反射率 / 镜面反射率，降噪只处理入射光照；全分辨率上采样时乘回（IndirectUpsample.comp mode 3）
    vec3 viewToFrag = normalize(camera.position - texture(gPosition, uv).rgb);
    float NdotV = clamp(dot(firstHit.normal, viewToFrag), 0.0, 1.0);
    diffuseColor /= IndirectDemodulationDiffuse(prop.albedo, prop.metallic);
    specularColor /= IndirectDemodulationSpecular(prop.albedo, prop.metallic, prop.roughness, NdotV);
    diffuseColor = clamp(diffuseColor, vec3(0.f), vec3(1000.f));
    specularColor = clamp(specularColor, vec3(0.f), vec3(1000.f));
    imageStore(outputImage, pixelCoord, vec4(diffuseColor, 1.0));
    imageStore(outputSpecularImage, pixelCoord, vec4(specularColor, specularHitDistance));
    imageStore(outputSpecularHitMotionImage, pixelCoord, specularHitMotion);
}
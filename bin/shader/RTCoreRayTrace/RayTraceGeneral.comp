vec3 RotateNormal(vec3 normal, float r1, float r2)
{
    float theta = acos(r1);
    float phi = 2.0 * PI * r2;
    
    vec3 dir = vec3(
        sin(theta) * cos(phi),
        sin(theta) * sin(phi),
        cos(theta)
    );
    
    // 将局部坐标转到世界空间（以法线为Z轴）
    vec3 up = abs(normal.y) < 0.999 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitangent = cross(normal, tangent);

    vec3 samplerDir = normalize(tangent * dir.x + bitangent * dir.y + normal * dir.z);

    return samplerDir;
}

// 生成余弦加权半球随机方向
vec3 ImportanceSampleCosine(vec3 normal, vec2 random)
{
    float r1 = random.x;
    float r2 = random.y;  
    r1 = sqrt(r1); // 余弦加权
    return RotateNormal(normal, r1, r2);
}

// 生成GGX权重半球随机方向
vec3 ImportanceSampleGGX(float roughness, vec3 normal, vec3 viewDir, vec2 random)
{
    float r1 = random.x;
    float r2 = random.y;  

    // 生成局部坐标系的 H（假设 N 朝上）
    float a = roughness * roughness;
    float a2 = a * a;
    float phi = 2.0 * PI * r1;
    float cosTheta = sqrt((1.0 - r2) / (1.0 + (a2 - 1.0) * r2));
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

    // 本地空间的 H 向量 (z轴为N)
    vec3 H_local = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);

    vec3 N = normal;
    vec3 V = normalize(-viewDir);

    // 构建 TBN 矩阵
    vec3 up = abs(N.y) < 0.999 ? vec3(0, 1, 0) : vec3(1, 0, 0);
    vec3 tangent = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);
    
    // 将 H 转换到世界空间
    vec3 H = normalize(tangent * H_local.x + bitangent * H_local.y + N * H_local.z);

    vec3 L = reflect(-V, H);

    // // 计算正确的 PDF（基于 L 空间，补上雅可比）
    // float NdotH = max(dot(N, H), 0.0);
    // float VdotH = max(dot(V, H), 0.0);
    
    // // 局部空间的 D（为了算 PDF，必须用局部的夹角，但 cosTheta 已经等于 NdotH，因为 H 转到了世界，且 TBN 是正交的）
    // float denom = cosTheta * cosTheta * (a2 - 1.0) + 1.0;
    // float D = a2 / (PI * denom * denom);
    
    // float pdf_H = D * cosTheta;             // H 空间的 PDF
    // pdf_L = pdf_H / (4.0 * VdotH + 0.0001); // L 空间的 PDF
    
    return L;
}


void getPBRProperties(MaterialData material, vec2 uv, inout PBRProperties prop)
{
    getPBRProperties(material, uv, prop.albedo, prop.metallic, prop.roughness, prop.ambientOcclusion);
}

vec3 CalcContribute_UniformSample(vec3 light, vec3 lightPos, vec3 fragPos, vec3 fragNormal)
{
    vec3 N = normalize(fragNormal);           	        // 表面法线
	vec3 L = normalize(lightPos - fragPos); 	        // 光线方向（从表面指向光源）
    float NdotL = max(dot(N, L), 0.0);			        // 表面法线x指向光线

	vec3 Contribute = light * NdotL * 2.0 * PI;
	return Contribute;
}

vec3 CalcContribute_CosineSample(vec3 light)
{
	return light * PI;
}

vec3 CalcContribute_GGXSample(
	vec3 normal, vec3 fragToViewDir, vec3 fragToLightDir,
	vec3 albedo, float metallic, float roughness)
{	
	vec3 N = normalize(normal);           	// 表面法线
	vec3 V = normalize(fragToViewDir); 		// 视线反方向（从表面指向摄像机）
	vec3 L = normalize(fragToLightDir); 	// 光线方向（从表面指向光源）
	vec3 H = normalize(V + L);            	// 半角向量
	float NdotL = max(dot(N, L), 0.0);		// 表面法线x指向光线
	float NdotV = max(dot(N, V), 0.0);		// 表面法线x指向摄像机
	float NdotH = max(dot(N, H), 0.0);		// 表面法线x半程向量
	float VdotH = max(dot(V, H), 0.0);		// 指向摄像机x半程向量

    if (NdotL <= 0.0)
        return vec3(0.0);

	vec3 F0 = mix(vec3(0.02), albedo, metallic);

    float G = GeometrySmith(NdotL, NdotV, roughness);
	vec3 F = fresnelSchlick(F0, VdotH);

	vec3 specular = (F * G) * VdotH / (NdotV * NdotH + 0.0001);
    return specular;
}

bool traceScene(Ray ray, inout HitInfo hit) 
{
    traceRayEXT(topLevelAS,
        gl_RayFlagsOpaqueEXT, 
        0xFF, 0, 0, 0,
        ray.origin, ray.tMin, ray.direction, ray.tMax, 
        0
    );

    if(payload.isHit)
    {
        hit.position = payload.position;
        hit.tangent = payload.tangent;
        hit.bitangent = payload.bitangent;
        hit.normal = payload.normal;
        hit.texCoords = payload.texCoords;
        hit.t = payload.t;
        hit.materialdata = materials[payload.materialIndex];
    }

    return payload.isHit;
}

float calc_P_Spec(PBRProperties prop)
{
    vec3 F0 = mix(vec3(0.02), prop.albedo, prop.metallic);
    float avgF0 = (F0.r + F0.g + F0.b) / 3.0;
    float p_spec = clamp(avgF0 * (1.0 - prop.roughness) + prop.roughness * 0.1, 0.05, 0.95);
    return p_spec;
}

vec3 CalcLightingWithShadowRay(
    vec3 viewPos,
    vec3 fragPos, vec3 fragNormal, 
	PBRProperties prop
)
{
	vec3 viewDir = normalize(fragPos - viewPos);		
    vec3 rayOrigin = fragPos + fragNormal * 0.001;

	vec3 lightColor = vec3(0.f,0.f,0.f);
	for(uint i = 0;i < dirLightMetaData.dirLightCount; i++)
    {
        vec3 fragTolightDir = -dirLightMetaData.info[i].direction;
        const float lightDistance = 10000.f;
        payload.isHit = true;
        traceRayEXT(topLevelAS,
            gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
            0xFF, 0, 0, 0,
            rayOrigin, 0.001, fragTolightDir, lightDistance,
            0
        );
        if (payload.isHit)
            continue;
		lightColor += CalcDirLightWithoutShadow(dirLightMetaData.info[i], fragNormal, viewDir, prop);
    }
	for(uint i = 0;i < pointLightMetaData.pointLightCount; i++)
    {
        vec3 fragTolightDir = pointLightMetaData.info[i].position - rayOrigin;
        const float lightDistance = distance(rayOrigin, pointLightMetaData.info[i].position);
        payload.isHit = true;
        traceRayEXT(topLevelAS,
            gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
            0xFF, 0, 0, 0,
            rayOrigin, 0.001, fragTolightDir, lightDistance,
            0
        );
        if (payload.isHit)
            continue;
		lightColor += CalcPointLightWithoutShadow(pointLightMetaData.info[i], fragNormal, fragPos, viewDir, prop);
    }
	for(uint i = 0;i < spotLightMetaData.spotLightCount; i++)
    {
        vec3 fragTolightDir = pointLightMetaData.info[i].position - rayOrigin;
        const float lightDistance = distance(rayOrigin, pointLightMetaData.info[i].position);
        payload.isHit = true;
        traceRayEXT(topLevelAS,
            gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
            0xFF, 0, 0, 0,
            rayOrigin, 0.001, fragTolightDir, lightDistance,
            0
        );
        if (payload.isHit)
            continue;
		lightColor += CalcSpotLightWithoutShadow(spotLightMetaData.info[i], fragNormal, fragPos, viewDir, prop);
    }

	return lightColor;
}
#version 450 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in;

layout (binding = 0, rgba16f) uniform image2D outPutColor;

layout (binding = 1) uniform sampler2D image;

layout (push_constant) uniform Param{
	float weight[5];
	bool horizontal;
};

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outPutColor);

    if (coord.x >= imageSize.x || coord.y >= imageSize.y)
        return;

    vec2 TexCoords = (vec2(coord) + vec2(0.5)) / vec2(imageSize);

	vec2 tex_offset = 1.0 / textureSize(image, 0);
	vec3 result = texture(image, TexCoords).rgb * weight[0];
	if(horizontal)
	{
		for(int i = 1; i < 5; i++)
		{
			float offset = tex_offset.x * i;

			if (TexCoords.x - offset >= 0.0)
                result += texture(image, vec2(TexCoords.x - offset, TexCoords.y)).rgb * weight[i];
            if (TexCoords.x + offset <= 1.0)
                result += texture(image, vec2(TexCoords.x + offset, TexCoords.y)).rgb * weight[i];
		}
	}
	else 
	{
		for(int i = 1; i < 5; i++)
		{
			float offset = tex_offset.y * i;

			if (TexCoords.y - offset >= 0.0)
				result += texture(image, vec2(TexCoords.x, TexCoords.y - offset)).rgb * weight[i];
            if (TexCoords.y + offset <= 1.0)
				result += texture(image, vec2(TexCoords.x, TexCoords.y + offset)).rgb * weight[i];
		}
	}

	imageStore(outPutColor, coord, vec4(result, 1.0f));
}
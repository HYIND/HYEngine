#version 450 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in;

layout (binding = 0, rgba8) uniform image2D outPutColor;

layout (binding = 1) uniform sampler2D colorBuffer;
layout (binding = 2) uniform sampler2D bloomMap;

layout (push_constant) uniform Param{
    float exposureValue;
    float gammaValue;
    bool gammaEnable;
    bool bloomEnable;
    bool filpY;
};

vec3 debugshow();

vec3 aces(vec3 x) {
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp((x*(a*x+b))/(x*(c*x+d)+e), 0.0, 1.0);
}

vec3 expTone(vec3 x)
{
    return vec3(1.0) - exp(-x);
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outPutColor);

    if (coord.x >= imageSize.x || coord.y >= imageSize.y)
        return;

    vec2 TexCoords = (vec2(coord) + vec2(0.5)) / vec2(imageSize);

    vec3 scrColor = texture(colorBuffer, filpY ? vec2(TexCoords.x, 1.0 - TexCoords.y): TexCoords).rgb;
    vec3 result = scrColor;

    if(bloomEnable) 
    {
        vec3 bloomColor = texture(bloomMap, filpY ? vec2(TexCoords.x, 1.0 - TexCoords.y): TexCoords).rgb;
        result += bloomColor;  
    }

    result *= exposureValue;                    // 曝光控制

    // result = expTone(result)                 // 色调映射
    result = aces(result);                      // 色调映射

    if(gammaEnable) result = pow(result, vec3(1.0 / gammaValue));

    imageStore(outPutColor, coord, vec4(result, 1.0f));
}


#version 460 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in; 

#include "shader/dataDef/camerauboDef.comp"

layout (binding = 0) uniform Params
{
    vec3 fogColor;
    float globalDensity;        // 全局雾浓度
    float fogStartHeight;       // 雾起始高度
    float fogStartDistance;     // 雾起始距离
    float fogHeightFalloff;     // 高度衰减系数
};

layout (binding = 1, rgba16f) uniform image2D outputImage;
layout (binding = 2) uniform sampler2D colorMap;
layout (binding = 3) uniform sampler2D depthMap;


float DepthBufferConvertToViewDepth(float depth)
{
    return camera.farPlane * camera.nearPlane / (camera.farPlane - depth * (camera.farPlane - camera.nearPlane));
}

vec3 ReconstructWorldPosition(float depth, vec2 texCoords)
{
    vec4 ndcPos = vec4(texCoords * 2.0 - 1.0, depth, 1.0);
    
    vec4 viewPos = camera.invProjection * ndcPos;
    viewPos /= viewPos.w; // 透视除法
    
    // 逆视图变换到世界空间
    vec4 worldPos = camera.invView * viewPos;
    return worldPos.xyz;
}

vec3 GetViewDir(vec2 uv, float aspect)
{    
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.x *= aspect;
    ndc.y = -ndc.y;
    float tanHalfFov = tan(radians(camera.fov) * 0.5);
    vec3 localRayDir = normalize(vec3(ndc * tanHalfFov, -1.0));
    vec3 worldRayDir = mat3(camera.invView) * localRayDir;
    return worldRayDir;
}

const float MAX_DISTANCE = 1e5;

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outputImage);

    if (coord.x >= imageSize.x || coord.y >= imageSize.y)
        return;

    vec2 TexCoords = (vec2(coord) + vec2(0.5)) / vec2(imageSize);

    float samplerDepth = texture(depthMap, TexCoords).r;
    vec3 worldPos = vec3(0);
    if (samplerDepth < 0.99994)
        worldPos = ReconstructWorldPosition(samplerDepth, TexCoords);
    else 
        worldPos = camera.position + GetViewDir(TexCoords, float(imageSize.x) / float(imageSize.y)) * MAX_DISTANCE;

    float distanceDiff = distance(camera.position, worldPos);
    if (distanceDiff <= fogStartDistance)
        return;

    vec3 scrColor = texture(colorMap, TexCoords).rgb;

    float fogHeightDiff = worldPos.y - fogStartHeight;
    float fogDensity = globalDensity * exp(-fogHeightFalloff * fogHeightDiff);

    // float effectZ = camera.position.z - worldPos.z;
    // float falloff = fogHeightFalloff * effectZ;
    // float fogFactor = (1 - exp2(-falloff)) / falloff;

    float fog = fogDensity * max(distanceDiff - fogStartDistance, 0);
    fog = clamp(fog, 0.0, 1.0);
    
    vec3 result = mix(scrColor, fogColor, fog);
    imageStore(outputImage, coord, vec4(result, 1.0));
}

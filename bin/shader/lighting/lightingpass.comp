#version 450 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in;

#include "shader/dataDef/camerauboDef.comp"
#include "shader/Helper/lightingHelper.comp"
#include "shader/dataDef/GBufferPack.comp"

layout (binding = 0) uniform IBLParams
{
	bool IBLDiffuseEnable;		// 没有任何 GI Pass 时由 IBL 提供漫反射间接光
	bool IBLSpecularEnable;		// 没有反射 Pass 时由 IBL 提供镜面间接光
	uint ShadowDebugMode;		// 阴影调试：0 关，1 级联着色，2 阴影结果，3 阴影图内容（见 RenderOption.h ShadowDebugMode）
};

layout (binding = 1, rgba16f) uniform image2D outPutColor;

layout (binding = 2) uniform sampler2D gPosition;
layout (binding = 3) uniform sampler2D gNormal;
layout (binding = 4) uniform sampler2D gAlbedoOpacity;
layout (binding = 5) uniform sampler2D gMetallicRoughness;
layout (binding = 6) uniform sampler2D gEmission;
layout (binding = 7) uniform sampler2D ssao;
layout (binding = 8) uniform sampler2D atlasShadowMap;
layout (binding = 9) uniform sampler2D depthMap;
layout (binding = 10) uniform samplerCube IBLDiffuse;
layout (binding = 11) uniform samplerCube IBLPrefilter;
layout (binding = 12) uniform sampler2D IBLBrdfLUT;


// ---------------- 阴影调试 ----------------
// 只看编辑器里选中的那盏方向光（DirLight.shadowDebug）；选级联、法线偏移、投影、比较都和 CalcDirLight 完全一致
const vec3 kCascadeDebugColors[4] = vec3[4](
	vec3(1.0, 0.25, 0.2),	// 级联 0 红
	vec3(0.25, 0.9, 0.3),	// 级联 1 绿
	vec3(0.25, 0.45, 1.0),	// 级联 2 蓝
	vec3(1.0, 0.85, 0.2)	// 级联 3 黄
);

vec3 ShadowDebugColorForLight(uint mode, DirLight light, vec3 fragPos, vec3 shadingNormal, vec3 geoNormal, ivec2 coord)
{
	bool stripe = ((coord.x + coord.y) / 6) % 2 == 0;

	// 选中的灯没开投影：暗紫
	if (!light.castShadow)
		return vec3(0.15, 0.0, 0.15);

	// 开了投影但一个级联都没分到（图集放不下）：黑白斜纹
	if (light.cascadeCount <= 0)
		return stripe ? vec3(1.0) : vec3(0.0);

	vec4 viewPos = camera.view * vec4(fragPos, 1.0);
	float viewDepth = abs(viewPos.z);
	float fade = DirLightShadowDistanceFade(light, viewDepth);
	if (fade <= 0.0)
		return vec3(0.12);	// 超出阴影距离：暗灰

	// 和 GetCascade 相同的选法，但要拿到下标
	int cascadeIndex = light.cascadeFirst + light.cascadeCount - 1;
	for (int i = light.cascadeFirst; i < light.cascadeFirst + light.cascadeCount - 1; ++i)
	{
		if (viewDepth < cascadeDistances.values[i])
		{
			cascadeIndex = i;
			break;
		}
	}
	DirLightCascade cascade = dirLightCascadeData.info[cascadeIndex];
	int localIndex = cascadeIndex - light.cascadeFirst;

	vec3 geoN = normalize(geoNormal);
	if (dot(geoN, shadingNormal) < 0.0)
		geoN = -geoN;

	vec2 subStart = vec2(cascade.atlasX, cascade.atlasY);
	vec2 subSize = vec2(cascade.atlasWidth, cascade.atlasHeight);
	float texelWorld = ShadowTexelWorldSize(cascade.lightSpaceMatrix, fragPos, subSize.x);
	vec3 shiftedPos = fragPos + ShadowNormalOffset(geoN, -normalize(light.direction), texelWorld, light.shadowNormalBias);
	vec4 lightSpacePos = cascade.lightSpaceMatrix * vec4(shiftedPos, 1.0);
	vec3 proj = lightSpacePos.xyz / lightSpacePos.w;
	vec2 uv = proj.xy * 0.5 + 0.5;

	// 接收点投影到了所选级联的范围外（xy 出了子图，或深度出了 [0,1]）：品红斜纹。
	// 出现这个说明矩阵拟合 / 选级联有问题——这时阴影计算要么采到子图边缘、要么直接判成受光
	bool outOfRange = any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))) || proj.z < 0.0 || proj.z > 1.0;
	if (outOfRange)
		return stripe ? vec3(1.0, 0.0, 1.0) : vec3(0.2, 0.0, 0.2);

	float shadow = clamp(DirLightShadowCalculation(lightSpacePos, atlasShadowMap, subStart, subSize), 0.0, 1.0) * fade;

	if (mode == 1u)
	{
		vec3 c = kCascadeDebugColors[clamp(localIndex, 0, 3)] * mix(1.0, 0.25, shadow);
		if (fade < 1.0 && stripe)
			c *= 0.5;	// 阴影距离渐隐段：加斜纹
		return c;
	}
	if (mode == 2u)
		return vec3(1.0 - shadow);

	// mode 3：阴影图在接收点处存的深度
	vec2 atlasSizeInv = 1.0 / vec2(textureSize(atlasShadowMap, 0));
	float stored = SamplerAtlasMap(uv, atlasShadowMap, atlasSizeInv, subStart, subSize);
	if (stored >= 0.999999)
		return vec3(0.0, 0.9, 0.9);	// 青：这里阴影图是清屏值，没有任何物体画进来（被剔除 / 被裁掉）
	return stored < clamp(proj.z, 0.0, 1.0) ? vec3(0.9, 0.2, 0.2) : vec3(0.2, 0.8, 0.2);	// 红：有更近的遮挡物；绿：只有接收面自己
}

// 返回 false：没有选中的方向光，按正常画面渲染
bool ShadowDebugColor(uint mode, vec3 fragPos, vec3 shadingNormal, vec3 geoNormal, ivec2 coord, out vec3 outColor)
{
	outColor = vec3(0.0);
	int lightIndex = -1;
	for (uint i = 0; i < dirLightMetaData.dirLightCount; i++)
	{
		if (dirLightMetaData.info[i].shadowDebug)
		{
			lightIndex = int(i);
			break;
		}
	}
	if (lightIndex < 0)
		return false;
	outColor = ShadowDebugColorForLight(mode, dirLightMetaData.info[lightIndex], fragPos, shadingNormal, geoNormal, coord);
	return true;
}

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outPutColor);

    if (coord.x >= imageSize.x || coord.y >= imageSize.y)
        return;

    vec2 TexCoords = (vec2(coord) + vec2(0.5)) / vec2(imageSize);

	vec3 normal = texture(gNormal, TexCoords).rgb;
	if(length(normal) <= 0.001)
		return;

	float depth = texture(depthMap, TexCoords).r;
    if (depth > 0.99994)
        return;

	// gPosition.w 是打包的几何法线（不含法线贴图），阴影法线偏移用它
	vec4 positionData = texture(gPosition, TexCoords);
	vec3 fragPos = positionData.xyz;
	vec3 geometryNormal = UnpackGeometryNormal(positionData.w);
	vec4 metallicRoughness = texture(gMetallicRoughness, TexCoords);

	PBRProperties prop;
    prop.albedo = texture(gAlbedoOpacity, TexCoords).rgb;
	prop.metallic = metallicRoughness.r;
	prop.roughness = metallicRoughness.g;
	prop.ambientOcclusion = clamp(min(texture(ssao, TexCoords).r, metallicRoughness.b), 0.f, 1.f);

	vec3 color = vec3(0.f);

	vec3 emission = texture(gEmission, TexCoords).rgb;
	color += emission;
	
	// 阴影调试：直接输出调试颜色（不加自发光 / IBL），后面的间接光、体积、后处理仍会叠上去，看的时候建议先关 GI 和雾
	if (ShadowDebugMode != 0u)
	{
		vec3 debugColor;
		if (ShadowDebugColor(ShadowDebugMode, fragPos, normal, geometryNormal, coord, debugColor))
		{
			imageStore(outPutColor, coord, vec4(debugColor, 1.0));
			return;
		}
	}

	vec3 lightColor = CalcLightingWithGeometryNormal(camera.view, camera.position, camera.farPlane, atlasShadowMap, fragPos, normal, geometryNormal, prop);
	color += lightColor;

	if (IBLDiffuseEnable || IBLSpecularEnable)
	{
		vec3 viewDir = normalize(fragPos - camera.position);
		vec3 iblDiffuse, iblSpecular;
		CalculateIBLLightingSplit(viewDir, normal, prop, IBLDiffuse, IBLPrefilter, IBLBrdfLUT, iblDiffuse, iblSpecular);
		if (IBLDiffuseEnable)
			color += iblDiffuse;
		if (IBLSpecularEnable)
			color += iblSpecular;
	}

	imageStore(outPutColor, coord, vec4(color, 1.0));
}

#version 450 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in;

#include "shader/dataDef/camerauboDef.comp"
#include "shader/Helper/lightingHelper.comp"

layout (binding = 0) uniform IBLParams
{
	bool IBLEnable;
};

layout (binding = 1, rgba16f) uniform image2D outPutColor;

layout (binding = 2) uniform sampler2D gPosition;
layout (binding = 3) uniform sampler2D gNormal;
layout (binding = 4) uniform sampler2D gAlbedoOpacity;
layout (binding = 5) uniform sampler2D gMetallicRoughness;
layout (binding = 6) uniform sampler2D gEmission;
layout (binding = 7) uniform sampler2D ssao;
layout (binding = 8) uniform sampler2D atlasShadowMap;
layout (binding = 9) uniform sampler2D depthMap;
layout (binding = 10) uniform samplerCube IBLDiffuse;
layout (binding = 11) uniform samplerCube IBLPrefilter;
layout (binding = 12) uniform sampler2D IBLBrdfLUT;


void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outPutColor);

    if (coord.x >= imageSize.x || coord.y >= imageSize.y)
        return;

    vec2 TexCoords = (vec2(coord) + vec2(0.5)) / vec2(imageSize);

	vec3 normal = texture(gNormal, TexCoords).rgb;
	if(length(normal) <= 0.001)
		return;

	float depth = texture(depthMap, TexCoords).r;
    if (depth > 0.99994)
        return;

	vec3 fragPos = texture(gPosition, TexCoords).rgb;
	vec4 metallicRoughness = texture(gMetallicRoughness, TexCoords);

	PBRProperties prop;
    prop.albedo = texture(gAlbedoOpacity, TexCoords).rgb;
	prop.metallic = metallicRoughness.r;
	prop.roughness = metallicRoughness.g;
	prop.ambientOcclusion = clamp(min(texture(ssao, TexCoords).r, metallicRoughness.b), 0.f, 1.f);

	vec3 color = vec3(0.f);

	vec3 emission = texture(gEmission, TexCoords).rgb;
	color += emission;
	
	vec3 lightColor = CalcLighting(camera.view, camera.position, camera.farPlane, atlasShadowMap, fragPos, normal, prop);
	color += lightColor;

	if (IBLEnable)
	{
		vec3 viewDir = normalize(fragPos - camera.position);
		vec3 ambient = CalculateIBLLighting(viewDir, normal, prop, IBLDiffuse, IBLPrefilter, IBLBrdfLUT);
		color += ambient;
	}

	imageStore(outPutColor, coord, vec4(color, 1.0));
}

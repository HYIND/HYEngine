#version 460 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

#ifndef kernelRadius
#define kernelRadius 2
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in;


layout (binding = 0) uniform Param{
	float weight[kernelRadius * 2 + 1];
};

layout (binding = 1, rgba16f) uniform image2D outPutImage;
layout (binding = 2) uniform sampler2D inputImage;

void main()
{
    ivec2 outPutSize = imageSize(outPutImage);
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);

    if (coord.x >= outPutSize.x || coord.y >= outPutSize.y)
        return;

    vec2 center = (vec2(coord) + 0.5) / vec2(outPutSize);
    vec2 inputStride = 1.0 / vec2(textureSize(inputImage, 0));

    float totalWeight = 0;
	vec3 result = vec3(0);

    for (int y = -kernelRadius; y <= kernelRadius; ++y)
    {
        for (int x = -kernelRadius; x <= kernelRadius; ++x)
        {
            vec2 uv = center + vec2(x, y) * inputStride;
            uv = clamp(uv, vec2(0), vec2(1));

            float wx = weight[x + kernelRadius];
            float wy = weight[y + kernelRadius];

            float w = wx * wy;

            result += texture(inputImage, uv).rgb * w;
            totalWeight += w;
        }
    }

    // result += texture(inputImage, center).rgb;
    // totalWeight += 1;

    result /= totalWeight;
    
	imageStore(outPutImage, coord, vec4(result, 1.0f));
}

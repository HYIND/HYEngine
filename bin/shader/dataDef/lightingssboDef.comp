
struct DirLight {
	vec3 direction;
	vec3 color;

	float luxIntensity;

	bool castShadow;
	int cascadeFirst;
	int cascadeCount;

	bool volumeLightEnable;
	bool volumeLightEffectByAtmospher;
	float volumetricScatteringIntensity;

	// 阴影距离渐隐（相机视空间深度）：<= start 完整阴影，>= end 不算阴影
	float shadowFadeStart;
	float shadowFadeEnd;

	// 法线偏移（单位：阴影贴图 texel）
	float shadowNormalBias;

	// 阴影调试：这盏灯是编辑器里选中的那盏
	bool shadowDebug;
};

struct DirLightCascade
{
	mat4 lightSpaceMatrix;

	int atlasX;
	int atlasY;
	int atlasWidth;
	int atlasHeight;
};

struct PointLight {
	vec3 position;
	vec3 color;

	vec2 atlasStart[6];
	vec2 atlasSize[6];
	
	bool castShadow;
	float cdIntensity;
	float radius;

	bool volumeLightEnable;
	bool volumeLightEffectByAtmospher;
	float volumetricScatteringIntensity;

	// 法线偏移（单位：阴影贴图 texel）
	float shadowNormalBias;
};

struct SpotLight {
    vec3 position;
	vec3 color;
	vec3 direction;	

	float cdIntensity;

	bool castShadow;
    float cutOff;	
    float outerCutOff;

	float radius;

	int atlasX;
	int atlasY;
	int atlasWidth;
	int atlasHeight;

	bool volumeLightEnable;
	bool volumeLightEffectByAtmospher;
	float volumetricScatteringIntensity;

	// 法线偏移（单位：阴影贴图 texel），放在 mat4 之前原有的空隙里
	float shadowNormalBias;

	mat4 lightSpaceMatrix;
};

layout(set = 3, binding = 0) buffer DirLightMetaData
{
    uint dirLightCount;
    DirLight info[];
} dirLightMetaData;

layout(set = 3, binding = 1) buffer DirLightCascadeData
{
    uint dirLightCascadeCount;
    DirLightCascade info[];
} dirLightCascadeData;

layout(set = 3, binding = 2) buffer PointLightMetaData
{
    uint pointLightCount;
    PointLight info[];
} pointLightMetaData;

layout(set = 3, binding = 3) buffer SpotLightMetaData
{
    uint spotLightCount;
    SpotLight info[];
} spotLightMetaData;

layout(set = 3, binding = 4) buffer DirLightCascadeDistanceData
{
	float values[];
} cascadeDistances;

#extension GL_EXT_nonuniform_qualifier : require

#include "shader/dataDef/ShadowMaterialDataDef.comp"

layout(set = 5, binding = 0) buffer ShadowMaterial {
	ShadowMaterialData shadowMaterials[];
};
layout(set = 5, binding = 1) uniform sampler2D shadowMaterialTextures[];


float calculateOpacity(ShadowMaterialData material, vec2 uv)
{	
	float opacity = material.opacity;
	if(material.texture_opacity_count > 0)
		opacity *= texture(shadowMaterialTextures[nonuniformEXT(material.texture_opacity)], uv).r;
	else if (material.texture_albedo_count > 0)
		opacity *= texture(shadowMaterialTextures[nonuniformEXT(material.texture_albedo)], uv).a;

	if (material.alphamode == 1)	//Mask
		opacity = opacity > material.maskthreshold ? 1.0f : 0.f;

	return opacity;
}

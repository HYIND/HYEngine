#version 450 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

#ifndef Max_Bounce_limit
#define Max_Bounce_limit 3
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y) in; 

#include "shader/dataDef/camerauboDef.comp"

layout (binding = 0) uniform Params
{
    ivec2 screenSize;
    float tMin;
    float tMax;
    uint maxBounce;
    uint SampleRayCount;
    uint RayMarchingMaxStep;
    float SampleIndirectClampValue;
    float GIIntensity;
    float AOIntensity;
    float DistanceFactor;
    uint frameIndex;
};

layout (binding = 1, rgba16f) uniform image2D outputImage;
layout (binding = 2) uniform sampler2D gPosition;
layout (binding = 3) uniform sampler2D gNormal;
layout (binding = 4) uniform sampler2D gAlbedoOpacity;
layout (binding = 5) uniform sampler2D gMetallicRoughness;
layout (binding = 6) uniform sampler2D colorMap;
layout (binding = 7) uniform sampler2D depthMap;
layout (binding = 8) uniform sampler2D SSAOMap;
layout (binding = 9) uniform sampler2D hzbDepthMap;

#include "shader/Helper/bdrfHelper.comp"
#include "shader/ssr/SSGIGeneral.comp"

const float RussianRouletteFactor = 0.8f;

vec3 traceRay(
    vec3 viewPos, 
    vec3 fragPos, vec3 fragNormal,
    PBRProperties prop,
    uint maxBounce, 
    uint sampleId    
)
{
    vec2 screenSize = textureSize(colorMap, 0);

    vec3 colors[Max_Bounce_limit + 1];
    vec3 contributeFacts[Max_Bounce_limit + 1];
    int hitCount = 0;

    float throughput = 1.0f;

    uint seedbase = uint(gl_GlobalInvocationID.x) * 197u 
            + uint(gl_GlobalInvocationID.y) * 927u
            + uint(frameIndex) * 777u;

    for (uint depth = 0; depth < maxBounce; depth++) 
    {
        uint seed = seedbase + uint(sampleId * (maxBounce + 1) + depth) * 269u;
        Ray ray;
        ray.origin = fragPos + fragNormal * 0.002;
        ray.tMin = tMin;
        ray.tMax = tMax;

        vec2 uv;
        vec3 hitPosition, hitNormal;

        // 根据材质，随机选取走高光采样还是漫反射采样
        float p_spec = calc_P_Spec(prop);
        bool spec = (pcg_float(seed * 7476405u + 2891453u) < p_spec);
        if (spec)
        {
            // GGX重要性采样specular
            vec2 random = getRandom(seed);
            ray.direction = ImportanceSampleGGX(prop.roughness, fragNormal, normalize(ray.origin - viewPos), random);

            if(!traceScene(ray, screenSize, RayMarchingMaxStep, uv))
                break;

            hitPosition = texture(gPosition, uv).rgb;
            hitNormal = normalize(texture(gNormal, uv).rgb);

            float dist = distance(hitPosition, ray.origin);
            if(dist > tMax || dist < tMin)
                break;

            // 计算该点向前一个点高光传递贡献
            contributeFacts[hitCount] = CalcContribute_GGXSample(fragNormal, normalize(viewPos - ray.origin),  normalize(hitPosition - ray.origin), prop.albedo, prop.metallic, prop.roughness) / p_spec;
        }
        else 
        {
            // 余弦加权重要性采样diffuse
            vec2 random = getRandom(seed);
            ray.direction = ImportanceSampleCosine(fragNormal, random);

            if(!traceScene(ray, screenSize, RayMarchingMaxStep, uv))
                break;
    
            hitPosition = texture(gPosition, uv).rgb;
            hitNormal = normalize(texture(gNormal, uv).rgb);

            float dist = distance(hitPosition, ray.origin);
            if(dist > tMax || dist < tMin)
                break;

            // 计算该点向前一个点漫反射传递贡献
            vec3 diffuse = vec3(0.0);
            CalcBDRFDiffuse(prop.albedo, prop.metallic, diffuse);
            contributeFacts[hitCount] = CalcContribute_CosineSample(diffuse) / (1.0 - p_spec);
        }

	    getPBRProperties(uv, prop);

        float dist = distance(ray.origin, hitPosition);
        float attenuation = 1.0 / (1.0 + dist * DistanceFactor);
        vec3 lightingColor = texture(colorMap, uv).rgb;
        vec3 lightEnergy = lightingColor / (prop.albedo + 1e-4) * attenuation;
        vec3 indirectColor = prop.albedo * min(lightEnergy, SampleIndirectClampValue);        //钳制入射光强

        colors[hitCount] = indirectColor;

        viewPos = ray.origin;
        fragPos = hitPosition;
        fragNormal = hitNormal;

        contributeFacts[hitCount] = contributeFacts[hitCount] / throughput;

        hitCount++;

        if ((pcg_float(seed * 72789645u + 29157653u) >= RussianRouletteFactor))
            break;
        throughput *= RussianRouletteFactor;
    }

    if (hitCount > 0)
    {
        vec3 result = vec3(0.f);
        for (int i = hitCount - 1; i >= 0; i--)
        {
            result = (result + colors[i]) * contributeFacts[i];
        }
        return result;
    }

    return vec3(0.f);
}

vec3 tracePath(
    vec3 viewPos,
    vec3 fragPos, vec3 fragNormal, 
    PBRProperties prop,
    uint maxBounce,
    uint sampleCount
) 
{
    vec3 totalIndirect = vec3(0.0);

    for (uint i = 0; i < sampleCount; i++)
        totalIndirect += traceRay(viewPos, fragPos, fragNormal, prop, maxBounce, i);

    return sampleCount > 0 ?  totalIndirect / float(sampleCount) : vec3(0.f);
}

vec3 fresnelSchlickRoughness(float cosTheta, vec3 F0, float roughness)
{
    return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}   

void main()
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= screenSize.x || pixelCoord.y >= screenSize.y)
        return;

    vec2 pixelCenter = pixelCoord + 0.5;
    vec2 uv = pixelCenter / screenSize;

    float depth = texture(depthMap, uv).r;
    if(depth >= 0.99994)
        return;

    PBRProperties prop;
    getPBRProperties(uv, prop);

    if (prop.ambientOcclusion < 0.02)
        return;

    vec3 fragPos = texture(gPosition, uv).rgb;
    vec3 fragNormal = normalize(texture(gNormal, uv).rgb);

    vec3 color = tracePath(camera.position, fragPos, fragNormal, prop, clamp(maxBounce, uint(1) , uint(Max_Bounce_limit)), max(uint(1), SampleRayCount));
    color *= GIIntensity * mix(1.0, prop.ambientOcclusion, AOIntensity);
    color = clamp(color, vec3(0.f), vec3(1000.f));
    imageStore(outputImage, pixelCoord, vec4(color, 1.0));
}

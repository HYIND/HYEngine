#version 450 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

#ifndef Max_Bounce_limit
#define Max_Bounce_limit 3
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y) in; 

#include "shader/dataDef/camerauboDef.comp"

layout (binding = 0) uniform Params
{
    float tMin;
    float tMax;
    uint maxBounce;
    uint SampleRayCount;
    uint RayMarchingMaxStep;
    float GIIntensity;
    float AOIntensity;
    float DistanceFactor;
    uint frameIndex;
};

layout (binding = 1) uniform CubeParams
{
    bool CubeEnable;
};

layout (binding = 2, rgba16f) uniform image2D outputImage;
layout (binding = 3) uniform sampler2D gPosition;
layout (binding = 4) uniform sampler2D gNormal;
layout (binding = 5) uniform sampler2D gAlbedoOpacity;
layout (binding = 6) uniform sampler2D gMetallicRoughness;
layout (binding = 7) uniform sampler2D colorMap;
layout (binding = 8) uniform sampler2D depthMap;
layout (binding = 9) uniform sampler2D SSAOMap;
layout (binding = 10) uniform sampler2D hzbMinDepthMap;
layout (binding = 11) uniform samplerCube cubeMap;
// 路径追踪拆成两路：outputImage = 漫反射（alpha 1），outputSpecularImage = 镜面（alpha = 第一次反弹的命中距离）
layout (binding = 12, rgba16f) uniform image2D outputSpecularImage;

#include "shader/Helper/bdrfHelper.comp"
#include "shader/ssr/SSGIGeneral.comp"
#include "shader/Filter/IndirectDemodulation.comp"

// 反射部分（firstSpecular）光线上的高度雾（和主画面同一份参数，见 ReflectionFog.comp）。
// 屏幕空间没有阴影可查：体积雾模式下散射按看得到算
#define REFLECT_FOG_BINDING 13
#include "shader/Volume/ReflectionFog.comp"

const float RussianRouletteFactor = 0.8f;

vec3 traceRay(
    vec3 viewPos, 
    vec3 fragPos, vec3 fragNormal,
    PBRProperties prop,
    uint maxBounce, 
    uint sampleId,
    float lobeRandom,           // 第一次反弹选镜面 / 漫反射用的随机数（tracePath 里分层生成）
    out bool firstSpecular,     // 第一次反弹走的是不是镜面
    inout float firstHitT       // 第一次反弹的命中距离；没打中几何时不改，调用方给 tMax
)
{
    firstSpecular = false;
    vec2 imageSize = textureSize(colorMap, 0);

    vec3 colors[Max_Bounce_limit + 1];
    vec3 contributeFacts[Max_Bounce_limit + 1];
    // 每一段（起点 → 命中点 / 天空）的雾：到达起点的辐亮度 = L × fogT + fogS（仅镜面那一路计算）
    vec3 fogT[Max_Bounce_limit + 1];
    vec3 fogS[Max_Bounce_limit + 1];
    int hitCount = 0;

    float throughput = 1.0f;
    float pathLength = distance(viewPos, fragPos);

    uint seedbase = uint(gl_GlobalInvocationID.x) * 197u 
            + uint(gl_GlobalInvocationID.y) * 927u
            + uint(frameIndex) * 777u;

    for (uint depth = 0; depth < maxBounce; depth++) 
    {
        uint seed = seedbase + uint(sampleId * (maxBounce + 1) + depth) * 269u;
        Ray ray;
        ray.origin = fragPos + fragNormal * 0.002;
        ray.tMin = tMin;
        ray.tMax = tMax;

        vec2 uv;
        vec3 hitPosition, hitNormal;

        bool captureCube = false;

        // 根据材质，随机选取走高光采样还是漫反射采样
        float p_spec = calc_P_Spec(prop);
        // 第一次反弹的波瓣概率限制在 [0.25, 0.75]（纯金属没有漫反射，直接取 1）：拆成两路后各自单独降噪，
        // 概率太小的那一路几乎每帧都没有样本、偶尔来一个就是 1/p 倍的亮点，累积后在画面上闪烁。
        // 任何 (0, 1) 的概率都是无偏的（权重除以同一个 p_spec），只是方差分配不同（NRD 的建议）
        if (depth == 0u)
            p_spec = prop.metallic >= 0.99 ? 1.0 : clamp(p_spec, 0.25, 0.75);
        bool spec = (depth == 0u ? lobeRandom : pcg_float(seed * 7476405u + 2891453u)) < p_spec;
        if (depth == 0u)
            firstSpecular = spec;
        if (spec)
        {
            // GGX重要性采样specular
            vec2 random = getRandom(seed);
            ray.direction = ImportanceSampleGGX(prop.roughness, fragNormal, normalize(ray.origin - viewPos), random);

            if (!traceScene(ray, imageSize, RayMarchingMaxStep, uv))
            {
                if (CubeEnable)
                    captureCube = true;
                else 
                    break;
            }

            if (!captureCube)
            {
                hitPosition = texture(gPosition, uv).rgb;
                hitNormal = normalize(texture(gNormal, uv).rgb);

                float dist = distance(hitPosition, ray.origin);
                if(dist > tMax || dist < tMin)
                    break;
                // 计算该点向前一个点高光传递贡献
                contributeFacts[hitCount] = CalcContribute_GGXSample(fragNormal, normalize(viewPos - ray.origin),  normalize(hitPosition - ray.origin), prop.albedo, prop.metallic, prop.roughness) / p_spec;
            }
            else 
            {
                contributeFacts[hitCount] = CalcContribute_GGXSample(fragNormal, normalize(viewPos - fragPos), ray.direction, prop.albedo, prop.metallic, prop.roughness) / p_spec;
            }
        }
        else 
        {
            // 余弦加权重要性采样diffuse
            vec2 random = getRandom(seed);
            ray.direction = ImportanceSampleCosine(fragNormal, random);

            if (!traceScene(ray, imageSize, RayMarchingMaxStep, uv))
            {
                if (CubeEnable)
                    captureCube = true;
                else 
                    break;
            }

            if (!captureCube)
            {
                hitPosition = texture(gPosition, uv).rgb;
                hitNormal = normalize(texture(gNormal, uv).rgb);

                float dist = distance(hitPosition, ray.origin);
                if(dist > tMax || dist < tMin)
                    break;
            }
            
            // 计算该点向前一个点漫反射传递贡献
            vec3 diffuse = vec3(0.0);
            CalcBDRFDiffuse(prop.albedo, prop.metallic, diffuse);
            contributeFacts[hitCount] = CalcContribute_CosineSample(diffuse) / (1.0 - p_spec);
        }

        // 反射部分这一段的雾（打到天空时按无穷远；体积雾散射仅首跳计算）
        if (firstSpecular)
        {
            float segLength = captureCube ? 0.0 : distance(ray.origin, hitPosition);
            vec3 segDir = captureCube ? ray.direction : (hitPosition - ray.origin) / max(segLength, 1e-6);
            ReflectFogSegment(ray.origin, segDir, segLength, captureCube, pathLength, depth == 0u, 0.5, fogT[hitCount], fogS[hitCount]);
            pathLength += segLength;
        }
        else
        {
            fogT[hitCount] = vec3(1.0);
            fogS[hitCount] = vec3(0.0);
        }

        if (depth == 0u && !captureCube)
            firstHitT = distance(hitPosition, ray.origin);

        if (!captureCube)
        {
	        getPBRProperties(uv, prop);

            float dist = distance(ray.origin, hitPosition);
            float attenuation = 1.0 / (1.0 + dist * DistanceFactor);

            colors[hitCount] = texture(colorMap, uv).rgb * attenuation;

            viewPos = ray.origin;
            fragPos = hitPosition;
            fragNormal = hitNormal;
        }
        else 
        {
         vec3 indirectColor = texture(cubeMap, ray.direction).rgb;
            colors[hitCount] = indirectColor;
        }

        contributeFacts[hitCount] = contributeFacts[hitCount] / throughput;
        hitCount++;

        if (captureCube || (pcg_float(seed * 72789645u + 29157653u) >= RussianRouletteFactor))
            break;
        throughput *= RussianRouletteFactor;
    }

    if (hitCount > 0)
    {
        vec3 result = vec3(0.f);
        for (int i = hitCount - 1; i >= 0; i--)
        {
            result = ((result + colors[i]) * fogT[i] + fogS[i]) * contributeFacts[i];
        }
        return result;
    }

    return vec3(0.f);
}

void tracePath(
    vec3 viewPos,
    vec3 fragPos, vec3 fragNormal, 
    PBRProperties prop,
    uint maxBounce,
    uint sampleCount,
    out vec3 diffuseOut,
    out vec3 specularOut,
    out float specularHitDistance
) 
{
    // 按第一次反弹选的波瓣拆成漫反射 / 镜面两路（各自降噪，镜面那一路做虚像重投影），与 RTGI 相同。
    // 第一次反弹的波瓣分层选：每个像素一个随机偏移，样本 i 用 fract(偏移 + i / N)
    uint pixelSeed = uint(gl_GlobalInvocationID.x) * 197u + uint(gl_GlobalInvocationID.y) * 927u + uint(frameIndex) * 777u;
    float lobeOffset = pcg_float(pixelSeed * 5871943u + 1442695u);

    vec3 diffuseSum = vec3(0.0);
    vec3 specularSum = vec3(0.0);
    float hitSum = 0.0;
    float hitSamples = 0.0;
    float specularSamples = 0.0;

    for (uint i = 0; i < sampleCount; i++)
    {
        float lobeRandom = fract(lobeOffset + float(i) / float(max(sampleCount, 1u)));
        bool isSpecular = false;
        float firstHitT = tMax;
        vec3 c = traceRay(viewPos, fragPos, fragNormal, prop, maxBounce, i, lobeRandom, isSpecular, firstHitT);
        if (isSpecular)
        {
            specularSum += c;
            specularSamples += 1.0;
            if (firstHitT < tMax)
            {
                hitSum += firstHitT;
                hitSamples += 1.0;
            }
        }
        else
            diffuseSum += c;
    }

    float invCount = sampleCount > 0u ? 1.0 / float(sampleCount) : 0.0;
    diffuseOut = diffuseSum * invCount;
    specularOut = specularSum * invCount;
    // 镜面命中距离：打中的镜面样本取平均；有镜面样本但都没打中时为 tMax；这一帧没有镜面样本为 0（时域累积取邻域）
    specularHitDistance = hitSamples > 0.0 ? hitSum / hitSamples : (specularSamples > 0.0 ? max(tMax, 1e-3) : 0.0);
}

vec3 fresnelSchlickRoughness(float cosTheta, vec3 F0, float roughness)
{
    return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}   

void main()
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outputImage);

    if (pixelCoord.x >= imageSize.x || pixelCoord.y >= imageSize.y)
        return;

    vec2 pixelCenter = pixelCoord + 0.5;
    vec2 uv = pixelCenter / imageSize;

    float depth = texture(depthMap, uv).r;
    if(depth >= 0.99994)
        return;

    PBRProperties prop;
    getPBRProperties(uv, prop);

    if (prop.ambientOcclusion < 0.02)
        return;

    vec3 fragPos = texture(gPosition, uv).rgb;
    vec3 fragNormal = normalize(texture(gNormal, uv).rgb);

    vec3 diffuseColor, specularColor;
    float specularHitDistance;
    tracePath(camera.position, fragPos, fragNormal, prop, clamp(maxBounce, uint(1) , uint(Max_Bounce_limit)), max(uint(1), SampleRayCount),
        diffuseColor, specularColor, specularHitDistance);
    float intensity = GIIntensity * mix(1.0, prop.ambientOcclusion, AOIntensity);
    // 去调制：两路分别除以接收面的漫反射率 / 镜面反射率（与 RTGI 一致），降噪后由 IndirectUpsample（mode 3，同分辨率）乘回并相加
    float NdotV = clamp(dot(fragNormal, normalize(camera.position - fragPos)), 0.0, 1.0);
    diffuseColor *= intensity / IndirectDemodulationDiffuse(prop.albedo, prop.metallic);
    specularColor *= intensity / IndirectDemodulationSpecular(prop.albedo, prop.metallic, prop.roughness, NdotV);
    diffuseColor = clamp(diffuseColor, vec3(0.f), vec3(1000.f));
    specularColor = clamp(specularColor, vec3(0.f), vec3(1000.f));
    imageStore(outputImage, pixelCoord, vec4(diffuseColor, 1.0));
    imageStore(outputSpecularImage, pixelCoord, vec4(specularColor, specularHitDistance));
}

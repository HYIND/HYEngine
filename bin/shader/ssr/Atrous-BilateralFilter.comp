#version 450 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in; 

#include "shader/dataDef/camerauboDef.comp"

const float h[5] = float[](
    1.0 / 16.0,
    1.0 / 4.0,
    3.0 / 8.0,
    1.0 / 4.0,
    1.0 / 16.0
);

layout (binding = 0) uniform Params
{
    float normalFactor;
    float depthFactor;
    float luminanceFactor;
};

layout (binding = 1, rgba16f) uniform image2D curPassImage;
layout (binding = 2) uniform sampler2D lastPassImage;
layout (binding = 3) uniform sampler2D gNormal;
layout (binding = 4) uniform sampler2D depthMap;
layout (binding = 5) uniform sampler2D momentTexture;

layout (push_constant) uniform Param{
    int curPassIndex;
};

float DepthBufferConvertToViewDepth(float depth)
{
    return camera.farPlane * camera.nearPlane / (camera.farPlane - depth * (camera.farPlane - camera.nearPlane));
}

void GetDepthNormal(vec2 uv, inout float depth, inout float lineraDepth, inout vec3 normal)
{    
    depth = texture(depthMap, uv).r;
    normal = normalize(texture(gNormal, uv).rgb);
    lineraDepth = DepthBufferConvertToViewDepth(depth);
}

vec2 GetDepthGradient(ivec2 coord)
{
    ivec2 size = textureSize(depthMap, 0);

    ivec2 left  = max(coord + ivec2(-1, 0), ivec2(0));
    ivec2 right = min(coord + ivec2( 1, 0), size - 1);

    ivec2 top    = max(coord + ivec2(0, -1), ivec2(0));
    ivec2 bottom = min(coord + ivec2(0,  1), size - 1);

    float zL = DepthBufferConvertToViewDepth(texelFetch(depthMap, left, 0).r);
    float zR = DepthBufferConvertToViewDepth(texelFetch(depthMap, right, 0).r);

    float zT = DepthBufferConvertToViewDepth(texelFetch(depthMap, top, 0).r);
    float zB = DepthBufferConvertToViewDepth(texelFetch(depthMap, bottom, 0).r);

    float dzdx = (zR - zL) * 0.5;
    float dzdy = (zB - zT) * 0.5;

    vec2 gradZ = vec2(dzdx, dzdy);
    return gradZ;
}

void main() 
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(curPassImage);

    if (coord.x >= imageSize.x || coord.y >= imageSize.y)
        return;

    vec2 uvCenter = (vec2(coord) + vec2(0.5f)) / imageSize;

    vec3 centerNormal;
    float centerDepth, centerLinearDepth;
    GetDepthNormal(uvCenter, centerDepth, centerLinearDepth, centerNormal);
    if (centerDepth >= 0.99994)
        return;
    
    vec4 centerMoments = texture(momentTexture, uvCenter);
    float centerM1 = centerMoments.x;
    float centerM2 = centerMoments.y;
    float centerVariance = centerMoments.z;

    vec2 depthGradient = GetDepthGradient(coord);

    vec4 total = vec4(0.0);
    float totalWeight = 0.0;

    // Atrous 核心
    int curStep = 1 << curPassIndex;

    for (int x = -2; x <= 2; x++) 
    {
        for (int y = -2; y <= 2; y++) 
        {
            ivec2 stepCoord = ivec2(x, y) * curStep;
            ivec2 sampleCoord = coord + stepCoord;
            sampleCoord = clamp(sampleCoord, ivec2(0), imageSize - 1);

            vec2 uv = (vec2(sampleCoord) + vec2(0.5f)) / imageSize;
            
            vec3 sampleNormal;
            float sampleDepth, sampleLinearDepth;
            GetDepthNormal(uv, sampleDepth, sampleLinearDepth, sampleNormal);
            if (sampleDepth >= 0.99994) continue;

            vec4 moments = texture(momentTexture, uv);
            float sampleM1 = moments.x;
            float sampleM2 = moments.y;
            float sampleVariance = moments.z;

            float kernelWeight = h[x + 2] * h[y + 2];

            float normalWeight = pow(max(dot(centerNormal, sampleNormal), 0.0), normalFactor);

            float depthDiff = abs(centerLinearDepth - sampleLinearDepth);
            // float depthWeight = exp(-blurDepthWeight * depthDiff * depthDiff);            
            float depthWeight = exp(-depthDiff / (depthFactor * (abs(dot(depthGradient, vec2(stepCoord))) + 1e-6)));

            float luminanceDiff = abs(centerM1 - sampleM1);
            float sigmaL = max(sqrt(centerVariance), 1e-3);
            float luminanceWeight = exp(-luminanceDiff / (luminanceFactor * sigmaL + 1e-6));

            float weight = normalWeight * depthWeight * luminanceWeight;
            vec4 sampleColor = texture(lastPassImage, uv);

            total += sampleColor * weight;
            totalWeight += weight;
        }
    }

    vec4 result = (totalWeight > 1e-5) ? total / totalWeight : texture(lastPassImage, uvCenter);

    imageStore(curPassImage, coord, result);
}
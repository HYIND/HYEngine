#version 450 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

#ifndef Max_Bounce_limit
#define Max_Bounce_limit 3
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y) in; 

#include "shader/dataDef/camerauboDef.comp"

layout (binding = 0) uniform Params
{
    float tMin;
    float tMax;
    uint maxBounce;
    uint SampleRayCount;
    uint RayMarchingMaxStep;
    float DistanceFactor;
    uint frameIndex;
};

layout (binding = 1) uniform CubeParams
{
    bool CubeEnable;
    bool IBLEnable;
    uint HitDiffuseMode;    // 命中点的漫反射间接光：0 = 场景颜色里已有（LightingPass 补了 IBL 漫反射），1 = IBL，2 = DDGI（没覆盖到的回退 IBL）
};

layout (binding = 2, rgba16f) uniform image2D outputImage;
layout (binding = 3) uniform sampler2D gPosition;
layout (binding = 4) uniform sampler2D gNormal;
layout (binding = 5) uniform sampler2D gAlbedoOpacity;
layout (binding = 6) uniform sampler2D gMetallicRoughness;
layout (binding = 7) uniform sampler2D colorMap;
layout (binding = 8) uniform sampler2D depthMap;
layout (binding = 9) uniform sampler2D SSAOMap;
layout (binding = 10) uniform sampler2D hzbMinDepthMap;
layout (binding = 11) uniform samplerCube cubeMap;
layout (binding = 12) uniform samplerCube IBLDiffuse;
layout (binding = 13) uniform samplerCube IBLPrefilter;
layout (binding = 14) uniform sampler2D IBLBrdfLUT;

#define OnlyIBLHelper
#include "shader/Helper/lightingHelper.comp"
#include "shader/ssr/SSGIGeneral.comp"
#include "shader/Filter/IndirectDemodulation.comp"

// DDGI（与 DDGIApply 同一份图集 / UBO / 体积表），HitDiffuseMode != 2 时不绑定
#define DDGI_UBO_BINDING 15
#define DDGI_VOLUME_BINDING 16
#include "shader/DDGI/DDGICore.comp"
#include "shader/DDGI/DDGIUniforms.comp"
layout (binding = 17) uniform sampler2D ddgiIrradianceTex;
layout (binding = 18) uniform sampler2D ddgiDepthTex;
layout (binding = 19) uniform sampler2D ddgiProbeDataTex;
#include "shader/DDGI/DDGISample.comp"

const float RussianRouletteFactor = 0.8f;

// 反射路径命中点自身的漫反射间接光（与 RTR 相同）：按命中点的世界位置 / 法线直接采样 DDGI 或 IBL，
// 不读屏幕空间的间接光合成结果（那是相机视角下的最终颜色，也不该被前面的 Pass 回读）。
// colorMap 里已经有 LightingPass 补的 IBL 漫反射时（HitDiffuseMode = 0）不再重复加。
vec3 reflectHitDiffuseIndirect(vec3 pos, vec3 normal, vec3 toViewer, PBRProperties prop)
{
    if (HitDiffuseMode == 0u)
        return vec3(0.0);

    vec3 kdAlbedo = prop.albedo * (1.0 - prop.metallic);
    vec3 result = vec3(0.0);
    float remaining = 1.0;
    if (HitDiffuseMode == 2u)
        result = kdAlbedo * ddgiSampleIrradianceEx(pos, normal, toViewer, remaining) * ddgi.shadingParams.z;
    if (IBLEnable && remaining > 1e-3)
        result += remaining * kdAlbedo / PI * textureLod(IBLDiffuse, normal, 0.0).rgb;
    return result * prop.ambientOcclusion;
}

vec3 traceRay(
    vec3 viewPos, 
    vec3 fragPos, vec3 fragNormal,
    PBRProperties prop,
    uint maxBounce, 
    uint sampleId,
    inout float firstHitT       // 第一次反弹的命中距离；没打中几何时不改，调用方给 tMax
)
{
    vec2 imageSize = textureSize(colorMap, 0);

    vec3 colors[Max_Bounce_limit + 1];
    vec3 contributeFacts[Max_Bounce_limit + 1];
    int hitCount = 0;

    float throughput = 1.0f;

    uint seedbase = uint(gl_GlobalInvocationID.x) * 197u 
            + uint(gl_GlobalInvocationID.y) * 927u
            + uint(frameIndex) * 777u;

    for (uint depth = 0; depth < maxBounce; depth++) 
    {
        uint seed = seedbase + uint(sampleId * (maxBounce + 1) + depth) * 269u;
        Ray ray;
        ray.origin = fragPos + fragNormal * 0.002;
        ray.tMin = tMin;
        ray.tMax = tMax;

        vec2 uv;
        vec3 hitPosition, hitNormal;

        bool captureCube = false;

        {
            // GGX重要性采样specular
            vec2 random = getRandom(seed);
            ray.direction = ImportanceSampleGGX(prop.roughness, fragNormal, normalize(ray.origin - viewPos), random);

            if (!traceScene(ray, imageSize, RayMarchingMaxStep, uv))
            {
                if (CubeEnable)
                    captureCube = true;
                else 
                    break;
            }

            if (!captureCube)
            {
                hitPosition = texture(gPosition, uv).rgb;
                hitNormal = normalize(texture(gNormal, uv).rgb);

                float dist = distance(hitPosition, ray.origin);
                if(dist > tMax || dist < tMin)
                    break;
                // 计算该点向前一个点高光传递贡献
                contributeFacts[hitCount] = CalcContribute_GGXSample(fragNormal, normalize(viewPos - ray.origin),  normalize(hitPosition - ray.origin), prop.albedo, prop.metallic, prop.roughness);
            }
            else 
            {
                contributeFacts[hitCount] = CalcContribute_GGXSample(fragNormal, normalize(viewPos - fragPos), ray.direction, prop.albedo, prop.metallic, prop.roughness);
            }
        }

        if (depth == 0u && !captureCube)
            firstHitT = distance(hitPosition, ray.origin);

        if (!captureCube)
        {
	        getPBRProperties(uv, prop);

            float dist = distance(ray.origin, hitPosition);
            float attenuation = 1.0 / (1.0 + dist * DistanceFactor);

            // 命中点出射辐亮度 = 场景颜色（直接光 + 自发光 + LightingPass 补的 IBL）+ 命中点漫反射间接光（DDGI / IBL）
            vec3 hitDiffuse = reflectHitDiffuseIndirect(hitPosition, hitNormal, normalize(ray.origin - hitPosition), prop);
            colors[hitCount] = (texture(colorMap, uv).rgb + hitDiffuse) * attenuation;

            viewPos = ray.origin;
            fragPos = hitPosition;
            fragNormal = hitNormal;

            // 路径在这个命中点停下（材质不再追踪 / 达到最大次数）时，补上命中点自身的 IBL 镜面
            // （开着 SSR 时 LightingPass 不补镜面，场景颜色里没有）；俄罗斯轮盘终止的不补（已由 throughput 补偿）
            if (IBLEnable && (prop.metallic < 0.15 || prop.roughness > 0.8 || depth + 1u >= maxBounce))
            {
                vec3 unusedDiffuse, hitSpecular;
                CalculateIBLLightingSplit(normalize(fragPos - viewPos), fragNormal, prop, IBLDiffuse, IBLPrefilter, IBLBrdfLUT, unusedDiffuse, hitSpecular);
                colors[hitCount] += hitSpecular * attenuation;
            }
        }
        else 
        {
            vec3 indirectColor = texture(cubeMap, ray.direction).rgb;
            colors[hitCount] = indirectColor;
        }

        contributeFacts[hitCount] = contributeFacts[hitCount] / throughput;
        hitCount++;

        if (captureCube || prop.metallic < 0.15 || prop.roughness > 0.8 || (pcg_float(seed * 72789645u + 29157653u) >= RussianRouletteFactor))
            break;
        throughput *= RussianRouletteFactor;
    }

    if (hitCount > 0)
    {
        vec3 result = vec3(0.f);
        for (int i = hitCount - 1; i >= 0; i--)
        {
            result = (result + colors[i]) * contributeFacts[i];
        }
        return result;
    }

    return vec3(0.f);
}

vec3 tracePath(
    vec3 viewPos,
    vec3 fragPos, vec3 fragNormal, 
    PBRProperties prop,
    uint maxBounce,
    uint sampleCount,
    out float hitDistance
) 
{
    vec3 totalIndirect = vec3(0.0);
    float hitSum = 0.0;
    float hitSamples = 0.0;

    for (uint i = 0; i < sampleCount; i++)
    {
        float firstHitT = tMax;
        totalIndirect += traceRay(viewPos, fragPos, fragNormal, prop, maxBounce, i, firstHitT);
        if (firstHitT < tMax)
        {
            hitSum += firstHitT;
            hitSamples += 1.0;
        }
    }

    // 命中距离（时域累积的虚像重投影用）：打中的样本取平均；都没打中时为 tMax（环境 / 屏幕外，按无穷远处理）
    hitDistance = hitSamples > 0.0 ? hitSum / hitSamples : max(tMax, 1e-3);

    return sampleCount > 0 ?  totalIndirect / float(sampleCount) : vec3(0.f);
}

vec3 fresnelSchlickRoughness(float cosTheta, vec3 F0, float roughness)
{
    return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}   

void main()
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outputImage);

    if (pixelCoord.x >= imageSize.x || pixelCoord.y >= imageSize.y)
        return;

    vec2 pixelCenter = pixelCoord + 0.5;
    vec2 uv = pixelCenter / imageSize;

    float depth = texture(depthMap, uv).r;
    if(depth >= 0.99994)
        return;

    PBRProperties prop;
    getPBRProperties(uv, prop);

    vec3 fragPos = texture(gPosition, uv).rgb;
    vec3 fragNormal = normalize(texture(gNormal, uv).rgb);

    if (prop.metallic < 0.15 || prop.roughness > 0.8)
    {
        if (IBLEnable)
        {
            vec3 viewDir = normalize(fragPos - camera.position);
            // 镜面合成只收镜面：不追踪的像素只回退 IBL 镜面，漫反射由漫反射合成 / LightingPass 负责
            vec3 unusedDiffuse, color;
            CalculateIBLLightingSplit(viewDir, fragNormal, prop, IBLDiffuse, IBLPrefilter, IBLBrdfLUT, unusedDiffuse, color);
            // 去调制（与追踪路径同一个除数），降噪后由 IndirectUpsample（mode 2）乘回
            color /= IndirectDemodulationSpecular(prop.albedo, prop.metallic, prop.roughness, clamp(dot(fragNormal, -viewDir), 0.0, 1.0));
            color = clamp(color, vec3(0.f), vec3(1000.f));
            // 只有环境反射：虚像在无穷远（命中距离 = tMax）
            imageStore(outputImage, pixelCoord, vec4(color, max(tMax, 1e-3)));
        }
        return;
    }

    float hitDistance = 0.0;
    vec3 color = tracePath(camera.position, fragPos, fragNormal, prop, clamp(maxBounce, uint(1) , uint(Max_Bounce_limit)), max(uint(1), SampleRayCount), hitDistance);
    // 去调制：除以接收面的镜面反射率（与 RTR 一致），降噪只处理入射光照，时域历史和纹理无关（虚像重投影取到的是镜面上的另一个点）；
    // 降噪后由 IndirectUpsample（mode 2，同分辨率）乘回
    color /= IndirectDemodulationSpecular(prop.albedo, prop.metallic, prop.roughness, clamp(dot(fragNormal, normalize(camera.position - fragPos)), 0.0, 1.0));
    color = clamp(color, vec3(0.f), vec3(1000.f));
    // alpha：第一次反弹的命中距离（TemporalAccumulate 的镜面信号）
    imageStore(outputImage, pixelCoord, vec4(color, hitDistance));
}

#version 460 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

#ifndef MIN_EV
#define MIN_EV -6
#endif

#ifndef MAX_EV
#define MAX_EV 12
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in; 

layout(binding = 0) buffer HistogramBuffer {
    ivec2 screenSize;
    uint bins[256];
};
layout(binding = 1, rgba16f) uniform image2D colorTexture;

const float MIN_EXP_EV = MIN_EV;
const float MAX_EXP_EV = MAX_EV;
const float EV_RANGE = MAX_EXP_EV - MIN_EXP_EV;

const float sigma = 0.25;

float GetWeightNormalized(vec2 pos)
{
    vec2 uv = (pos + vec2(0.5)) / screenSize;
    vec2 center = vec2(0.5, 0.5);
    float dist = length(uv - center);
    float weight = exp(-(dist * dist) / (2.0 * sigma * sigma));

    float weightAtEdge = exp(-(0.5 * 0.5) / (2.0 * sigma * sigma));
    float weightNormalized = weight / weightAtEdge;
    weightNormalized = max(weightNormalized, 1.f);

    return weightNormalized;
}

uint GetBinIndex(vec3 color)
{
    float luminance = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));     // 计算亮度（人眼感知加权）
    luminance = max(luminance, 0.0001);                                 // 防止 log(0) 或负数
    float ev = log2(luminance);                                         // 对数映射到 EV 空间
    float normalized = (ev - MIN_EXP_EV) / EV_RANGE;                    // 映射到 0~1 范围
    normalized = clamp(normalized, 0.0, 1.0);                           // 钳制到 0~1（防止溢出）
    uint binIndex = uint(normalized * 255.0);                           // 计算桶索引（0~255）
    return binIndex;
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    vec2 pixelCenter = vec2(pos) + 0.5;
    if (pos.x >= screenSize.x || pos.y >= screenSize.y)
        return;
    
    float weightNormalized = GetWeightNormalized(pixelCenter); 

    vec3 color = imageLoad(colorTexture, pos).rgb;  
    uint binIndex = GetBinIndex(color);

    uint weightInt = uint(weightNormalized + 0.5f);
    atomicAdd(bins[binIndex], weightInt);
}
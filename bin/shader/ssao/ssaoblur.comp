#version 450 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in;

layout(binding = 0, r32f) uniform image2D outputBlur;

layout(binding = 1) uniform sampler2D ssaoInput;

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outputBlur);
    
    if (coord.x >= imageSize.x || coord.y >= imageSize.y) {
        return;
    }

    vec2 texelSize = 1.0 / vec2(textureSize(ssaoInput, 0));
    vec2 TexCoords = (vec2(coord) + vec2(0.5)) / vec2(imageSize);
    
    float result = 0.0;
    for (int x = -2; x < 2; ++x) 
    {
        for (int y = -2; y < 2; ++y) 
        {
            vec2 offset = vec2(float(x), float(y)) * texelSize;
            result += texture(ssaoInput, TexCoords + offset).r;
        }
    }
    
    float blurValue = result / (4.0 * 4.0);
    imageStore(outputBlur, coord, vec4(blurValue, 0.0, 0.0, 1.0));
}
#ifndef ATMO_MULTI_SCATTERING_COMP
#define ATMO_MULTI_SCATTERING_COMP

layout(binding = 14) uniform sampler2D multiScatteringLut;

// Returns the multiple-scattering source per unit solar illuminance.
// Solar transmittance is already included in the LUT and must not be applied again.
vec3 AtmoMultipleScatteringSource(vec3 p, vec3 toLightDir)
{
    float height = max(length(p) - PlanetRadius, 0.0);
    float cosSunZenith = dot(normalize(p), normalize(toLightDir));
    vec2 uv = vec2(
        0.5 + 0.5 * cosSunZenith,
        clamp(height / max(AtmosphereHeight, 1.0), 0.0, 1.0));

    vec3 betaS = RayleighCoefficient(height) + MieCoefficient(height);
    return betaS * texture(multiScatteringLut, uv).rgb;
}

#endif

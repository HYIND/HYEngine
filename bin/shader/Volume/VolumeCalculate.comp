#version 460 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in; 

#include "shader/dataDef/camerauboDef.comp"
#include "shader/Atmosphere/AtmoPublic.comp"
#include "shader/Helper/lightingHelper.comp"

layout (binding = 2) uniform Params
{
    bool AtmoVolumeEnable;
    bool ExponentialHeightFogEnable;
};

layout (binding = 3, rgba16f) uniform image2D outputImage;
layout (binding = 4) uniform sampler2D colorMap;
layout (binding = 5) uniform sampler2D depthMap;
layout (binding = 6) uniform sampler2D transmittanceLut;
layout (binding = 7) uniform sampler2D skyViewLut;
layout (binding = 8) uniform sampler2D atlasShadowMap;
layout (binding = 9) uniform sampler2D gPosition;

bool InDirShadow(DirLight light, vec3 fragPos)
{
	if (!light.castShadow)
        return false;

    DirLightCascade cascade = GetCascade(camera.view * vec4(fragPos, 1.0f), light.cascadeFirst, light.cascadeCount);
    vec4 fragPosLightSpace = cascade.lightSpaceMatrix * vec4(fragPos, 1.0);
    float shadow = DirLightFastShadowCalculation(fragPosLightSpace, atlasShadowMap, 
                                                vec2(cascade.atlasX, cascade.atlasY),
                                                vec2(cascade.atlasWidth, cascade.atlasHeight));
    shadow = clamp(shadow, 0.f, 1.f);
    return shadow > 0.1;
}

bool InPointShadow(PointLight light, vec3 fragPos)
{
	if (!light.castShadow)
        return false;

	float shadow = PointLightFastShadowCalculation(fragPos, light.position, atlasShadowMap, light.atlasStart, light.atlasSize, light.radius);    
    shadow = clamp(shadow, 0.f, 1.f);
    return shadow > 0.1;
}

bool InSpotShadow(SpotLight light, vec3 fragPos)
{
    if (!light.castShadow)
        return false;

    vec4 fragPosLightSpace = light.lightSpaceMatrix * vec4(fragPos, 1.0);
    float shadow = DirLightFastShadowCalculation(fragPosLightSpace, atlasShadowMap, vec2(light.atlasX, light.atlasY), vec2(light.atlasWidth, light.atlasHeight));   
    shadow = clamp(shadow, 0.f, 1.f);
    return shadow > 0.1;
}

#include "shader/Volume/AtmoVolume.comp"
#include "shader/Volume/FogVolume.comp"

void CalculateAtmoVolume(vec3 startPos, vec3 targetPos, inout vec3 atomTramsmittanceFragToCam, inout vec3 scatterColor)
{
    vec3 startPosInPlanet = startPos + vec3(0, PlanetRadius, 0.f);
    vec3 targetPosInPlanet = targetPos + vec3(0, PlanetRadius, 0.f);

    vec3 T = vec3(1);
    vec3 sc = vec3(0);
    AtmoSingleScatterToFrag(startPosInPlanet, targetPosInPlanet, dirLightMetaData.info[0], T, sc);
    atomTramsmittanceFragToCam *= T;
    scatterColor +=sc;
}

void CalculateLightVolume(vec3 startPos, vec3 targetPos, inout vec3 atomTramsmittanceFragToCam, inout vec3 scatterColor)
{
    vec3 T = vec3(1);
    vec3 sc = vec3(0);
    LightSingleScatterToFrag(startPos, targetPos, T, sc);
    atomTramsmittanceFragToCam *= T;
    scatterColor +=sc;
}

vec3 GetViewDir(vec2 uv, float aspect)
{    
    vec2 ndc = uv * 2.0 - 1.0;
    ndc.x *= aspect;
    ndc.y = -ndc.y;
    float tanHalfFov = tan(radians(camera.fov) * 0.5);
    vec3 localRayDir = normalize(vec3(ndc * tanHalfFov, -1.0));
    vec3 worldRayDir = mat3(camera.invView) * localRayDir;
    return worldRayDir;
}

const float MAX_DISTANCE = 1e5;

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outputImage);

    if (coord.x >= imageSize.x || coord.y >= imageSize.y)
        return;

    if (!AtmoVolumeEnable && !ExponentialHeightFogEnable)
        return;

    vec2 TexCoords = (vec2(coord) + vec2(0.5)) / vec2(imageSize);

    float samplerDepth = texture(depthMap, TexCoords).r;

    vec3 result = vec3(0.f);

    if (samplerDepth < 0.99994)
    {
        vec3 fragColor = texture(colorMap, TexCoords).rgb;
        vec3 worldPos = texture(gPosition, TexCoords).xyz;
        vec3 scatterColor = vec3(0.f);
        vec3 tramsmittance = vec3(1.f);
        
        if (AtmoVolumeEnable)
            CalculateAtmoVolume(camera.position, worldPos, tramsmittance, scatterColor);
        if (ExponentialHeightFogEnable && VolumeFogEnable)
            CalculateLightVolume(camera.position, worldPos, tramsmittance, scatterColor);

        result = scatterColor + tramsmittance * fragColor;
        if (ExponentialHeightFogEnable && !VolumeFogEnable)
        {
            float fogFactor = 1.0 - exp(-GetFogExtinction(camera.position, worldPos));
            fogFactor = clamp(fogFactor, 0.0, FogMaxOpacity);
            result = mix(result, fogAlbedo, fogFactor);
        }
    }
    else 
    {
        vec3 scatterColor = vec3(0.f);
        vec3 tramsmittance = vec3(1.f);

        vec3 fragColor = texture(colorMap, TexCoords).rgb;
        if (AtmoVolumeEnable && normalize(DirLightDir).y < 0.2)
        {
            vec3 skyViewColor = texture(skyViewLut, TexCoords).rgb;
            fragColor = skyViewColor;
        }

        if (ExponentialHeightFogEnable)
        {              
            vec3 vireDir = GetViewDir(TexCoords, float(imageSize.x) / float(imageSize.y));
            vec3 farPos = camera.position + vireDir * camera.farPlane;

            float T_Total = 1.0;

            float T_far = clamp(exp(-GetFogExtinction(farPos, farPos + vireDir * MAX_DISTANCE)), 0.0, 1.0);
            T_Total *= T_far;
            
            if (VolumeFogEnable)
            {
                CalculateLightVolume(camera.position, farPos, tramsmittance, scatterColor);
            }
            else
            {

                float T_view = clamp(exp(-GetFogExtinction(camera.position, farPos)), 0.0, 1.0);
                T_Total *= T_view;
                T_Total = max(T_Total, 1.0 - FogMaxOpacity);
            }

            float fogFactor = 1.0 - T_Total;
            fragColor = mix(fragColor, fogAlbedo, fogFactor);
        }

        result = scatterColor + tramsmittance * fragColor;
    }

    imageStore(outputImage, coord, vec4(result, 1.0));
}

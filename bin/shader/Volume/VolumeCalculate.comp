#version 460 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in; 

layout (binding = 0) uniform AtmoParams
{
    vec3 DirLightColor;
    vec3 DirLightDir;
    vec3 CubeCapturePosition;
    float PlanetRadius;
    float AtmosphereHeight;
    float RayleighScatteringScalarHeight;
    float MieScatteringScalarHeight;
    float MieAnisotropy;
    float OzoneLevelCenterHeight;
    float OzoneLevelWidth;

    uint ScatterPathSampleCount;
    uint TransmittanceSampleCount;
};

layout (binding = 1) uniform FogParams
{
    vec3 fogAlbedo;
    float globalDensity;        // 全局雾浓度
    float fogStartHeight;       // 雾起始高度
    float fogStartDistance;     // 雾起始距离
    float fogHeightFalloff;     // 高度衰减系数
    bool VolumeFogEnable;
    float FogMaxOpacity;
};

layout (binding = 2) uniform Params
{
    bool AtmoVolumeEnable;
    bool ExponentialHeightFogEnable;
};

layout (binding = 3, rgba16f) uniform image2D outputImage;
layout (binding = 4) uniform sampler2D colorMap;
layout (binding = 5) uniform sampler2D depthMap;
layout (binding = 6) uniform sampler2D skyViewLut;
layout (binding = 7) uniform sampler2D scatterLut;
layout (binding = 8) uniform sampler2D tramsmittanceLut;

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outputImage);

    if (coord.x >= imageSize.x || coord.y >= imageSize.y)
        return;

    if (!AtmoVolumeEnable && !ExponentialHeightFogEnable)
        return;

    vec2 TexCoords = (vec2(coord) + vec2(0.5)) / vec2(imageSize);

    float samplerDepth = texture(depthMap, TexCoords).r;

    vec3 result = vec3(0.f);
    vec3 scatterColor = texture(scatterLut, TexCoords).rgb; 
    vec4 tramsmittanceAndFactor = texture(tramsmittanceLut, TexCoords).rgba;

    if (samplerDepth < 0.99994)
    {
        vec3 fragColor = texture(colorMap, TexCoords).rgb;

        result = scatterColor + tramsmittanceAndFactor.rgb * fragColor;
        
        if (ExponentialHeightFogEnable && !VolumeFogEnable)
            result = mix(result, fogAlbedo, tramsmittanceAndFactor.a);
    }
    else 
    {
        vec3 fragColor = texture(colorMap, TexCoords).rgb;
        if (AtmoVolumeEnable && normalize(DirLightDir).y < 0.2)
        {
            vec3 skyViewColor = texture(skyViewLut, TexCoords).rgb;
            fragColor = skyViewColor;
        }

        if (ExponentialHeightFogEnable)          
            fragColor = mix(fragColor, fogAlbedo, tramsmittanceAndFactor.a);

        result = scatterColor + tramsmittanceAndFactor.rgb * fragColor;
    }

    imageStore(outputImage, coord, vec4(result, 1.0));
}

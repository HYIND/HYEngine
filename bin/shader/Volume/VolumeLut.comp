#version 460 core

#ifndef work_size_x
#define work_size_x 16
#endif
#ifndef work_size_y
#define work_size_y 16
#endif

layout(local_size_x = work_size_x, local_size_y = work_size_y, local_size_z = 1) in; 

#include "shader/dataDef/camerauboDef.comp"
#include "shader/Atmosphere/AtmoPublic.comp"
#include "shader/Helper/lightingHelper.comp"

layout (binding = 2) uniform Params
{
    bool AtmoVolumeEnable;
    bool ExponentialHeightFogEnable;
    bool JitterEnable;
    uint JitterSeed;
    bool CloudEnable;
};

layout (binding = 3, rgba16f) uniform image2D outputScatterColor;
layout (binding = 4, rgba16f) uniform image2D outputTramsmittance;
layout (binding = 5) uniform sampler2D depthMap;
layout (binding = 6) uniform sampler2D transmittanceLut;
layout (binding = 7) uniform sampler2D atlasShadowMap;
layout (binding = 8) uniform sampler2D gPosition;

// 体积云参数。用命名实例，避免 coverage / density / powder 这类名字污染全局
layout (binding = 9) uniform CloudParams
{
    vec3 cloudAlbedo;
    float cloudBottomHeight;
    vec3 cloudAmbientColor;
    float cloudTopHeight;
    float coverage;
    float density;
    float shapeScale;
    float detailScale;
    float detailStrength;
    float phaseG;
    float phaseBlend;
    float powder;
    float maxTraceDistance;
    float erosionDepth;
    uint viewStepCount;
    uint lightStepCount;
} cloudParams;

layout (binding = 10) uniform sampler3D cloudShapeNoise; 
layout (binding = 11) uniform sampler2D blueNoise;       

bool InDirShadow(DirLight light, vec3 fragPos)
{
	if (!light.castShadow)
        return false;

    DirLightCascade cascade = GetCascade(camera.view * vec4(fragPos, 1.0f), light.cascadeFirst, light.cascadeCount);
    vec4 fragPosLightSpace = cascade.lightSpaceMatrix * vec4(fragPos, 1.0);
    float shadow = DirLightFastShadowCalculation(fragPosLightSpace, atlasShadowMap, 
                                                vec2(cascade.atlasX, cascade.atlasY),
                                                vec2(cascade.atlasWidth, cascade.atlasHeight));
    shadow = clamp(shadow, 0.f, 1.f);
    return shadow > 0.1;
}

bool InPointShadow(PointLight light, vec3 fragPos)
{
	if (!light.castShadow)
        return false;

	float shadow = PointLightFastShadowCalculation(fragPos, light.position, atlasShadowMap, light.atlasStart, light.atlasSize, light.radius);    
    shadow = clamp(shadow, 0.f, 1.f);
    return shadow > 0.1;
}

bool InSpotShadow(SpotLight light, vec3 fragPos)
{
    if (!light.castShadow)
        return false;

    vec4 fragPosLightSpace = light.lightSpaceMatrix * vec4(fragPos, 1.0);
    float shadow = DirLightFastShadowCalculation(fragPosLightSpace, atlasShadowMap, vec2(light.atlasX, light.atlasY), vec2(light.atlasWidth, light.atlasHeight));   
    shadow = clamp(shadow, 0.f, 1.f);
    return shadow > 0.1;
}

#include "shader/Volume/AtmoVolume.comp"
#include "shader/Volume/FogVolume.comp"
#include "shader/Volume/CloudVolume.comp"

uint GetJetterValue(uint sampleIndex)
{
    uint seed = uint(gl_GlobalInvocationID.x) * 197u 
        + uint(gl_GlobalInvocationID.y) * 927u 
        + uint(sampleIndex) * 2697u 
        + uint(JitterSeed) * 777u;
    return seed;
}

void CalculateAtmoVolume(vec3 startPos, vec3 targetPos, inout vec3 atomTramsmittanceFragToCam, inout vec3 scatterColor)
{
    vec3 startPosInPlanet = startPos + vec3(0, PlanetRadius, 0.f);
    vec3 targetPosInPlanet = targetPos + vec3(0, PlanetRadius, 0.f);

    vec3 T = vec3(1);
    vec3 sc = vec3(0);
    AtmoSingleScatterToFrag(startPosInPlanet, targetPosInPlanet, dirLightMetaData.info[0], T, sc, JitterEnable, JitterEnable ? GetJetterValue(0) : 0);
    atomTramsmittanceFragToCam *= T;
    scatterColor +=sc;
}

void CalculateLightVolume(vec3 startPos, vec3 targetPos, inout vec3 atomTramsmittanceFragToCam, inout vec3 scatterColor)
{
    vec3 T = vec3(1);
    vec3 sc = vec3(0);
    LightSingleScatterToFrag(startPos, targetPos, T, sc, JitterEnable, JitterEnable ? GetJetterValue(1) : 0);
    atomTramsmittanceFragToCam *= T;
    scatterColor +=sc;
}

void CalculateCloudVolume(vec3 startPos, vec3 targetPos, inout vec3 atomTramsmittanceFragToCam, inout vec3 scatterColor)
{
    vec3 T = vec3(1);
    vec3 sc = vec3(0);
    CloudSingleScatterToFrag(startPos, targetPos, T, sc, JitterEnable, JitterEnable ? GetJetterValue(2) : 0);
    atomTramsmittanceFragToCam *= T;
    scatterColor += sc;
}

vec3 GetViewDir(vec2 uv)
{    
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 clipPos = vec4(ndc, 1.0, 1.0);
    vec4 viewPos = camera.invProjection * clipPos;
    viewPos /= viewPos.w;
    return normalize((camera.invView * vec4(viewPos.xyz, 0.0)).xyz);
}

const float MAX_DISTANCE = 1e5;

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imageSize = imageSize(outputScatterColor);

    if (coord.x >= imageSize.x || coord.y >= imageSize.y)
        return;

    if (!AtmoVolumeEnable && !ExponentialHeightFogEnable && !CloudEnable)
        return;

    vec2 TexCoords = (vec2(coord) + vec2(0.5)) / vec2(imageSize);

    float samplerDepth = texture(depthMap, TexCoords).r;

    vec3 scatterColor = vec3(0.0);
    vec3 tramsmittance = vec3(1.0);
    float fogFactor = 0.0;
    
    if (samplerDepth < 0.99994)
    {
        vec3 worldPos = texture(gPosition, TexCoords).xyz;
        
        if (AtmoVolumeEnable)
            CalculateAtmoVolume(camera.position, worldPos, tramsmittance, scatterColor);
        if (ExponentialHeightFogEnable && VolumeFogEnable)
            CalculateLightVolume(camera.position, worldPos, tramsmittance, scatterColor);
        if (ExponentialHeightFogEnable && !VolumeFogEnable)
            fogFactor = 1.0 - exp(-GetFogExtinction(camera.position, worldPos));
        if (CloudEnable)
            CalculateCloudVolume(camera.position, worldPos, tramsmittance, scatterColor);
    }
    else 
    {
        vec3 vireDir = GetViewDir(TexCoords);

        // 天空分支的 farPos 是 camera.farPlane，比云还近的话云会被整层切掉，
        // 所以云单独用一个至少能覆盖最大追踪距离的远点
        if (CloudEnable)
        {
            vec3 cloudFarPos = camera.position + vireDir * max(camera.farPlane, cloudParams.maxTraceDistance);
            CalculateCloudVolume(camera.position, cloudFarPos, tramsmittance, scatterColor);
        }

        if (ExponentialHeightFogEnable)
        {              
            vec3 farPos = camera.position + vireDir * camera.farPlane;

            float T_Total = 1.0;
            
            float T_far = clamp(exp(-GetFogExtinction(farPos, farPos + vireDir * MAX_DISTANCE)), 0.0, 1.0);
            T_Total *= T_far;
            
            if (VolumeFogEnable)
            {
                CalculateLightVolume(camera.position, farPos, tramsmittance, scatterColor);
            }
            else
            {

                float T_view = clamp(exp(-GetFogExtinction(camera.position, farPos)), 0.0, 1.0);
                T_Total *= T_view;
                T_Total = max(T_Total, 1.0 - FogMaxOpacity);
            }

            fogFactor = 1.0 - T_Total;
        }
    }

    imageStore(outputScatterColor, coord, vec4(scatterColor, 1.0));
    imageStore(outputTramsmittance, coord, vec4(tramsmittance, fogFactor));
}

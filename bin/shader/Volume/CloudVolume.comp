// 体积云：作为第三个体积介质，接口形状和 AtmoVolume / FogVolume 完全一致
//
// 依赖 VolumeLut.comp 中已经声明的：
//   binding 2  Params        -> AtmoVolumeEnable / JitterEnable
//   binding 9  CloudParams   -> 云参数
//   binding 10 sampler3D     -> 128^3 FBM 形状噪声（三轴平铺，Linear）
//   binding 11 sampler2D     -> 64x64 蓝噪声（Nearest + Repeat，用于抖动）

#ifndef CLOUD_VOLUME_COMP
#define CLOUD_VOLUME_COMP

// 云层当作一块水平板求交：球形曲率在 20km 尺度上可以忽略，比两球求交便宜且不会出错
bool GetCloudRaySegment(vec3 startPos, vec3 viewDir, out float tNear, out float tFar)
{
    float dirY = viewDir.y;

    // 视线完全水平：只要起点在云层内，整条光线都在云里
    if (abs(dirY) < 1e-6)
    {
        if (startPos.y < cloudParams.cloudBottomHeight || startPos.y > cloudParams.cloudTopHeight)
            return false;

        tNear = 0.0;
        tFar = 1e9;
        return true;
    }

    float tBottom = (cloudParams.cloudBottomHeight - startPos.y) / dirY;
    float tTop = (cloudParams.cloudTopHeight - startPos.y) / dirY;

    tNear = max(min(tBottom, tTop), 0.0);
    tFar = max(tBottom, tTop);

    return tFar > tNear;
}

float GetCloudHeightGradient(float height)
{
    float bottom = cloudParams.cloudBottomHeight;
    float top = cloudParams.cloudTopHeight;
    if (height <= bottom || height >= top)
        return 0.0;

    float erosion = max(cloudParams.erosionDepth, 1.0);
    float bottomFade = smoothstep(bottom, min(bottom + erosion, top), height);
    float topFade = 1.0 - smoothstep(max(top - erosion, bottom), top, height);
    return bottomFade * topFade;
}

// 返回归一化密度 [0,1]，乘上 cloudParams.density 才是消光系数（1/米）
float SampleCloudDensity(vec3 p)
{
    float heightGradient = GetCloudHeightGradient(p.y);
    if (heightGradient <= 0.0)
        return 0.0;

    float shape = texture(cloudShapeNoise, p * cloudParams.shapeScale).r;

    // 软阈值：coverage 越大阈值越低，冒出来的云越多
    float threshold = 1.0 - cloudParams.coverage;
    float density = clamp((shape - threshold) / max(1.0 - threshold, 1e-4), 0.0, 1.0);
    density *= heightGradient;

    // 高频细节侵蚀：同样的噪声用更大尺度再采一次，把边缘啃出丝状
    if (density > 0.0 && cloudParams.detailStrength > 0.0)
    {
        float detail = texture(cloudShapeNoise, p * cloudParams.detailScale).r;
        float erosion = (1.0 - detail) * cloudParams.detailStrength;
        density = clamp(density * (1.0 - erosion), 0.0, 1.0);
    }

    return density;
}

// 从采样点朝太阳累积光学厚度。上限取太阳光线离开云层的边界距离，避免在云外继续采样。
float GetCloudSunOpticalDepth(vec3 p, vec3 toLight)
{
    uint steps = max(cloudParams.lightStepCount, 1u);

    float distToCloudBoundary;
    if (toLight.y > 1e-4)
        distToCloudBoundary = (cloudParams.cloudTopHeight - p.y) / toLight.y;
    else if (toLight.y < -1e-4)
        distToCloudBoundary = (cloudParams.cloudBottomHeight - p.y) / toLight.y;
    else
        distToCloudBoundary = 8000.0;

    distToCloudBoundary = clamp(distToCloudBoundary, 50.0, 8000.0);

    float stepLength = distToCloudBoundary / float(steps);
    float opticalDepth = 0.0;

    for (uint i = 0; i < steps; ++i)
    {
        vec3 q = p + toLight * ((float(i) + 0.5) * stepLength);
        opticalDepth += SampleCloudDensity(q) * stepLength;
    }

    return opticalDepth * cloudParams.density;
}

// 太阳中心是否被行星遮挡。地平线随云的高度下降，因此高云可在地面日落后继续短暂受光。
// 太阳角半径用于对地平线处的遮挡做平滑近似（约 0.266 度）。
float GetCloudSunVisibility(vec3 p, vec3 toLight)
{
    vec3 planetSpacePosition = p + vec3(0.0, PlanetRadius, 0.0);
    float radialDistance = length(planetSpacePosition);
    vec3 localUp = planetSpacePosition / max(radialDistance, 1.0);
    float horizonElevation = -acos(clamp(PlanetRadius / max(radialDistance, PlanetRadius), 0.0, 1.0));
    float sunElevation = asin(clamp(dot(localUp, toLight), -1.0, 1.0));

    float tNear, tFar;
    bool intersectsPlanet = RaySphereIntersection(
        vec3(0.0), PlanetRadius, planetSpacePosition, toLight, tNear, tFar);
    bool planetBlocksSunCenter = intersectsPlanet && tFar > 0.0;
    const float sunAngularRadius = 0.00465;

    if (!planetBlocksSunCenter && sunElevation >= horizonElevation + sunAngularRadius)
        return 1.0;

    return smoothstep(
        horizonElevation - sunAngularRadius,
        horizonElevation + sunAngularRadius,
        sunElevation);
}

// 天空补光：天空辐照度 E 除 π 后乘云反照率；去饱和避免蓝天把白云染蓝，
// 高度遮蔽近似云底受到上方云体遮挡。此项只会在基础散射阶累计一次。
vec3 GetCloudAmbient(vec3 p)
{
    float heightFraction = clamp(
        (p.y - cloudParams.cloudBottomHeight) / max(cloudParams.cloudTopHeight - cloudParams.cloudBottomHeight, 1.0),
        0.0, 1.0);
    vec3 skyIrradiance = textureLod(skyIrradianceCube, vec3(0.0, 1.0, 0.0), 0.0).rgb;
    // Environment cube can be invalid during resource changes; do not let one bad sample
    // poison the cloud cube and then the final sky/IBL composite.
    if (any(isnan(skyIrradiance)) || any(isinf(skyIrradiance)))
        return vec3(0.0);
    skyIrradiance = clamp(skyIrradiance, vec3(0.0), vec3(65504.0));
    vec3 skyRadiance = skyIrradiance * (1.0 / PI);
    float luminance = dot(skyRadiance, vec3(0.2126, 0.7152, 0.0722));
    skyRadiance = mix(skyRadiance, vec3(luminance), clamp(cloudParams.skyFillDesaturation, 0.0, 1.0));
    float verticalOcclusion = mix(
        clamp(cloudParams.skyFillBottomOcclusion, 0.0, 1.0),
        1.0,
        smoothstep(0.0, 1.0, heightFraction));
    return skyRadiance * cloudParams.cloudAlbedo
         * max(cloudParams.skyFillStrength, 0.0) * verticalOcclusion;
}

vec3 CloudLighting(vec3 p, float density, vec3 viewDir, float sunOpticalDepth,
                   float sunVisibility,
                   float scatterScale, float extinctionScale,
                   float phaseScale, bool primaryScatter)
{
    // 场景没有方向光时不能读取 info[0]；天空补光在外层独立累计。
    if (dirLightMetaData.dirLightCount == 0u)
        return vec3(0.0);

    DirLight light = dirLightMetaData.info[0];
    vec3 toLight = -normalize(light.direction);
    if (sunVisibility <= 0.0)
        return vec3(0.0);

    // 随散射阶数增加，HG 相函数变宽，模拟光线经多次碰撞后方向性逐渐减弱。
    float cosTheta = dot(viewDir, toLight);
    float g = clamp(cloudParams.phaseG * phaseScale, -0.95, 0.95);
    float phase = HenyeyGreenstein(cosTheta, g);
    float lightTransmittance = exp(-sunOpticalDepth * extinctionScale);

    // Powder 是单次散射的局部边缘增强；不施加到高阶项，避免再次压暗云体内部。
    float powder = 1.0;
    if (primaryScatter)
    {
        powder = mix(1.0, 1.0 - exp(-density * 8.0), cloudParams.powder);
    }

    // 太阳光穿过大气剩下的那部分，和雾共用同一张 transmittance LUT
    vec3 sunAtmoTransmittance = vec3(1.0);
    if (AtmoVolumeEnable)
    {
        sunAtmoTransmittance = AtmoTransmittance(
            p + vec3(0.0, PlanetRadius, 0.0),
            p + toLight * 1e4 + vec3(0.0, PlanetRadius, 0.0));
    }

    vec3 sunColor = light.color * light.luxIntensity * light.volumetricScatteringIntensity;

    return sunVisibility * sunAtmoTransmittance * lightTransmittance * phase * powder * sunColor
         * cloudParams.cloudAlbedo * (scatterScale / extinctionScale);
}

void CloudScatterToFrag(vec3 startPos, vec3 targetPos,
                              inout vec3 tramsmittance, inout vec3 scatterColor,
                              bool JitterEnable, uint JitterSeed)
{
    vec3 delta = targetPos - startPos;
    float maxDistance = length(delta);
    if (maxDistance <= 0.0)
        return;

    vec3 viewDir = delta / maxDistance;

    float tNear, tFar;
    if (!GetCloudRaySegment(startPos, viewDir, tNear, tFar))
        return;

    // 被场景挡住的部分不算：云在山后面就该被山挡住
    tFar = min(tFar, maxDistance);
    tFar = min(tFar, cloudParams.maxTraceDistance);
    if (tFar <= tNear)
        return;

    uint steps = max(cloudParams.viewStepCount, 1u);
    float stepLength = (tFar - tNear) / float(steps);

    // 整条光线只抖一次：每步各抖一次会把噪声平均掉，只剩噪点没有抖动
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy) + ivec2(uint(JitterSeed) * 37u, uint(JitterSeed) * 17u);
    float jitter = JitterEnable ? texelFetch(blueNoise, pixel & 63, 0).r : 0.5;

    // 每阶有独立的视线透射率。阶数 n 的 σs'=σs*a^n，σt'=σt*b^n；
    // 令 a<=b 可避免高阶散射凭空增加介质能量。基础阶仍决定云的 alpha。
    float viewTransmittance[4];
    float octaveScatterScale[4];
    float octaveExtinctionScale[4];
    float octavePhaseScale[4];
    uint octaveCount = clamp(cloudParams.multiScatterOctaves, 1u, 4u);
    float a = clamp(cloudParams.multiScatterContribution, 0.0, 1.0);
    float b = max(clamp(cloudParams.multiScatterOcclusion, 0.01, 1.0), a);
    float c = clamp(cloudParams.multiScatterEccentricity, 0.0, 1.0);
    float scatterScale = 1.0;
    float extinctionScale = 1.0;
    float phaseScale = 1.0;
    for (uint octave = 0u; octave < octaveCount; ++octave)
    {
        viewTransmittance[octave] = 1.0;
        octaveScatterScale[octave] = scatterScale;
        octaveExtinctionScale[octave] = extinctionScale;
        octavePhaseScale[octave] = phaseScale;
        scatterScale *= a;
        extinctionScale *= b;
        phaseScale *= c;
    }
    float baseTransmittance = 1.0;
    vec3 scatter = vec3(0.0);

    for (uint i = 0; i < steps; ++i)
    {
        float t = tNear + (float(i) + jitter) * stepLength;
        vec3 p = startPos + viewDir * t;

        float density = SampleCloudDensity(p);
        if (density <= 0.0)
            continue;

        float sigmaT = density * cloudParams.density;
        float sunOpticalDepth = 0.0;
        float sunVisibility = 0.0;
        if (dirLightMetaData.dirLightCount > 0u)
        {
            vec3 toSun = -normalize(dirLightMetaData.info[0].direction);
            sunVisibility = GetCloudSunVisibility(p, toSun);
            if (sunVisibility > 0.0)
                sunOpticalDepth = GetCloudSunOpticalDepth(p, toSun);
        }
        for (uint octave = 0u; octave < octaveCount; ++octave)
        {
            float stepT = exp(-sigmaT * octaveExtinctionScale[octave] * stepLength);
            vec3 inScatter = CloudLighting(p, density, viewDir, sunOpticalDepth, sunVisibility,
                octaveScatterScale[octave], octaveExtinctionScale[octave],
                octavePhaseScale[octave], octave == 0u);
            if (octave == 0u)
                inScatter += GetCloudAmbient(p);
            scatter += viewTransmittance[octave] * inScatter * (1.0 - stepT);
            viewTransmittance[octave] *= stepT;
        }

        baseTransmittance *= exp(-sigmaT * stepLength);

        // 停止条件检查最高阶透射率；高阶消光较弱，基础阶变暗后仍可继续填充云内散射。
        float maxRemainingTransmittance = 0.0;
        for (uint octave = 0u; octave < octaveCount; ++octave)
            maxRemainingTransmittance = max(maxRemainingTransmittance, viewTransmittance[octave]);
        if (maxRemainingTransmittance < 0.003)
            break;
    }

    tramsmittance *= vec3(baseTransmittance);
    scatterColor += scatter;
}

#endif


vec4 AtmoTransmittanceSample(float height, float cos_theta)
{
    height = max(0.0, height);

    float uv_x = height / AtmosphereHeight;
    // float uv_x = sqrt(height / AtmosphereHeight);

    // float x = sign(cos_theta) * cos_theta * cos_theta;
    // float uv_y = x * 0.5 + 0.5;

    float theta = acos(clamp(cos_theta, -1.0, 1.0));
    float uv_y = theta / PI;

    // float uv_y = cos_theta * 0.5 + 0.5;

    uv_x = clamp(uv_x, 0, 1);
    uv_y = clamp(uv_y, 0, 1);

    vec2 uv = vec2(uv_x, uv_y);
    vec4 T = texture(transmittanceLut, uv).rgba;

    return T;
}

// 计算两点之间的透射率
vec3 AtmoTransmittanceWithLut(vec3 p1, vec3 p2)
{
    vec3 dir = normalize(p2 - p1);

    float h1 = length(p1) - PlanetRadius;
    float h2 = length(p2) - PlanetRadius;

    h1 = max(0.0, h1);
    h2 = max(0.0, h2);

    vec3 up1 = normalize(p1);
    vec3 up2 = normalize(p2);
    float cos_theta1 = dot(dir, up1);
    float cos_theta2 = dot(dir, up2);

    // vec3 up = vec3(0,1,0);
    // float cos_theta1 = dot(dir, up);
    // float cos_theta2 = dot(dir, up);

    vec4 T1 = AtmoTransmittanceSample(h1, cos_theta1);
    vec4 T2 = AtmoTransmittanceSample(h2, cos_theta2);

    if (sign(T1.a) == sign(T2.a))
    {
        const vec3 EPS = vec3(1e-6);
        return min(max(T1.rgb, EPS) / max(T2.rgb, EPS), vec3(1.0));
    }
    else 
    {
        return vec3(0.f);
    }
}

const float AtmoTransmittanceMinHeightSize = 40.0;

vec3 AtmoTransmittance(vec3 p1, vec3 p2)
{
    vec3 dir = normalize(p2 - p1);
    if (dir.y > 0)
        return AtmoTransmittanceWithLut(p1, p2);

    // 透射率变化与高度相关，以高度作为分辨率动态调整sample次数
    float heightDelta = abs((length(p1) - PlanetRadius) - (length(p2) - PlanetRadius));
    uint sampleCount = max(
        1u,
        min(
            uint(ceil(heightDelta / AtmoTransmittanceMinHeightSize)),
            AtmoTransmittanceSampleCount
        )
    );

    float dist = distance(p2, p1);
    float ds = dist / float(sampleCount);
    vec3 sum = vec3(0.0);
    vec3 p = p1 + dir * ds * 0.5;

    for(uint i = 0; i < sampleCount; i++)
    {
        float h = length(p) - PlanetRadius;
        h = max(0.5, h);

        vec3 scattering = RayleighCoefficient(h) + MieCoefficient(h);
        vec3 absorption = OzoneAbsorption(h) + MieAbsorption(h);
        vec3 extinction = scattering + absorption;

        sum += extinction * ds;
        p += dir * ds;
    }

    // 计算透光率
    return exp(-sum);
}

vec3 GetAtmoExtinction(vec3 p)
{
    float h = length(p) - PlanetRadius;
    h = max(0.0, h);

    vec3 scattering = RayleighCoefficient(h) + MieCoefficient(h);
    vec3 absorption = OzoneAbsorption(h) + MieAbsorption(h);
    vec3 extinction = scattering + absorption;

    return extinction;
}

#ifndef Halton_Define
#define Halton_Define
// 计算 Halton 序列
float halton(uint index, int base) 
{
    float result = 0.0;
    float f = 1.0;
    uint i = index;
    while (i > 0) 
    {
        f /= float(base);
        result += f * float(i % base);
        i /= base;
    }
    return result;
}
#endif

const float AtmoScatterMinStpeSize = 1.5;
const float AtmosphereSampleStrideMinHeightSize = 120;

void AtmoSingleScatterToFrag(vec3 startPosInPlanet, vec3 targetPosInPlanet, DirLight light,
                            inout vec3 atomTramsmittanceFragToCam, inout vec3 scatterColor,
                            bool JitterEnable, uint JitterSeed)
{
    vec3 lightColor = light.color * light.luxIntensity;

    vec3 viewDir = normalize(targetPosInPlanet - startPosInPlanet);
    vec3 toLightDir = -light.direction;

    float heightDelta = abs((length(startPosInPlanet) - PlanetRadius) - (length(targetPosInPlanet) - PlanetRadius));
    float dstToTarget = distance(startPosInPlanet, targetPosInPlanet);

    uint sampleCount = max(1u, min(uint(ceil(dstToTarget / AtmoScatterMinStpeSize)), AtmoScatterPathSampleCount));

    float stepSize = dstToTarget / float(sampleCount);
    float stepHeightSize = max(heightDelta / float(sampleCount), 1e-2);
    
    // 大气性质变化和高度相关性高，因此对于大气采样的步长的更新，独立于散射颜色累积的计算，只有高度差达到一定程度，才进行更新大气性质
    uint atmosphereSampleStride = max(1u, uint(ceil(AtmosphereSampleStrideMinHeightSize / stepHeightSize)));
    atmosphereSampleStride = min(atmosphereSampleStride, sampleCount);

    // 累积光学厚度
    vec3 camSumExtinction = vec3(0.f);

    uint atmosphereAccumlateStride = 0;
    vec3 tramsmittanceLightToTest = vec3(1.0);  // 太阳到采样点之间的透光率
    vec3 scattering = vec3(1.0);                // 散射光比例

    // 处理首次累积颜色时大气性质未计算的问题
    bool firstSampleAtmo = false;

    for (uint i = 0; i < sampleCount; i++) {

        float mid = JitterEnable ? halton(JitterSeed + i * 456, 2) : 0.5;
        vec3 testPoint = mix(startPosInPlanet, targetPosInPlanet, (float(i) + mid)/float(sampleCount));

        atmosphereAccumlateStride++;
        camSumExtinction += GetAtmoExtinction(testPoint) * stepSize;

        float planetNear, planetFar;
        bool hitPlanet = RaySphereIntersection(
            vec3(0,0,0),
            PlanetRadius,
            testPoint,
            toLightDir,
            planetNear,
            planetFar
        );
        if (hitPlanet)
        {
            // 情况 1：行星在采样点到太阳之间 → 遮挡
            if (hitPlanet && planetNear > 0.0)
            {
                continue;
            }
            // 情况 2：采样点在行星内部 → 无效
            if (hitPlanet && planetNear < 0.0 && planetFar > 0.0)
            {
                continue;
            }
        }

        if (InDirShadow(light, testPoint - vec3(0, PlanetRadius, 0.f)))
            continue;

        float tStart, tEnd;
        bool validSegment = GetAtmosphereRaySegment(
            testPoint,
            toLightDir,
            tStart,
            tEnd
        );
        if (!validSegment)
            continue;

        // 大气散射只每 N 个 sample 算一次
        if (!firstSampleAtmo || atmosphereAccumlateStride >= atmosphereSampleStride)
        {        
            vec3 atmosphereStart = testPoint + toLightDir * tStart;
            vec3 atmosphereEnd = testPoint + toLightDir * tEnd;

            tramsmittanceLightToTest = AtmoTransmittance(atmosphereStart, atmosphereEnd);                       // 太阳到采样点之间的透光率
            scattering = Scattering(testPoint, toLightDir, viewDir);                                        // 散射光比例

            if (!firstSampleAtmo) firstSampleAtmo = true;
            atmosphereAccumlateStride = 0;
        }

        // 已累积的光线厚度转化为当前段的消光率
        vec3 tramsmittanceTestToCam = exp(-camSumExtinction);

        vec3 inScattering = tramsmittanceLightToTest * scattering * tramsmittanceTestToCam * stepSize * lightColor;    // 采样点的光照计算
        scatterColor += inScattering;
    }

    atomTramsmittanceFragToCam = exp(-camSumExtinction);
}
